---
import PageLayout from "@layouts/PageLayout.astro";
import { SITE, SOCIALS } from "@consts";
import {
  getWorkDateRange,
  processWorkEntry,
  processEducationEntry,
} from "@lib/utils";
import { getCollection } from "astro:content";

// Work
const workCollection = (await getCollection("work")).sort((a, b) => {
  const aRange = getWorkDateRange(a.data.roles);
  const bRange = getWorkDateRange(b.data.roles);
  return bRange.startDate.valueOf() - aRange.startDate.valueOf();
});
const processedWork = workCollection.map((item) =>
  processWorkEntry({ ...item, body: item.body }),
);

// Education
const educationCollection = (await getCollection("education")).sort((a, b) => {
  const aEnd = a.data.dateEnd === "Present" ? new Date() : a.data.dateEnd;
  const bEnd = b.data.dateEnd === "Present" ? new Date() : b.data.dateEnd;
  return bEnd.valueOf() - aEnd.valueOf();
});
const processedEducation = educationCollection.map((item) =>
  processEducationEntry({ ...item, body: item.body }),
);

// Projects (hideFromCV opt-out, draft hides everywhere)
const projects = (
  await getCollection(
    "projects",
    ({ data }) => !data.draft && !data.hideFromCV,
  )
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// Helpers
const fmtMonthYear = (d: Date | string) =>
  typeof d === "string"
    ? d
    : d.toLocaleDateString("en-US", { month: "short", year: "numeric" });

const fmtYear = (d: Date | string) =>
  typeof d === "string" ? d : d.getFullYear().toString();

const linkedin = SOCIALS.find((s) => s.NAME === "linkedin")?.HREF;
const github = SOCIALS.find((s) => s.NAME === "github")?.HREF;
const x = SOCIALS.find((s) => s.NAME === "x")?.HREF;
---

<PageLayout
  title="CV"
  description={`${SITE.NAME} — Curriculum Vitae`}
>
  <div
    class="cv-sheet"
    data-drop-project-desc
    data-drop-prev-bios
    data-drop-prev-roles
    data-drop-projects-section
  >
    <div class="cv-header">
      <div class="cv-header-main">
        <h1 class="cv-name">{SITE.NAME}</h1>
        <p class="cv-position">{SITE.POSITION}</p>
      </div>
      <ul class="cv-contact">
        <li>Madrid + Asturias, Spain</li>
        <li>
          <a href="https://jorgeorejas.com">jorgeorejas.com</a>
        </li>
        {
          linkedin && (
            <li>
              <a href={linkedin}>linkedin.com/in/jorgeorejas</a>
            </li>
          )
        }
        {
          github && (
            <li>
              <a href={github}>github.com/jorgeorejas</a>
            </li>
          )
        }
        {
          x && (
            <li>
              <a href={x}>@jorejasrojo</a>
            </li>
          )
        }
      </ul>
    </div>

    <section class="cv-section" data-section="profile">
      <h2 class="cv-section-title">Profile</h2>
      <p class="cv-summary">
        Developer and entrepreneur from Asturias, Spain. I build at the
        intersection of growth, AI and product — shipping data-driven
        experiments, full-stack web features, and tools that turn ideas into
        scalable products.
      </p>
    </section>

    <section class="cv-section" data-section="experience">
      <h2 class="cv-section-title">Experience</h2>
      {
        processedWork.map((work, i) => (
          <div class="cv-entry" data-entry="work" data-index={i}>
            <div class="cv-entry-head">
              <div class="cv-entry-title-group">
                <h3 class="cv-entry-title">{work.name}</h3>
                {work.website && (
                  <a
                    class="cv-entry-website"
                    href={work.website}
                    target="_blank"
                    rel="noopener"
                  >
                    {work.website.replace(/^https?:\/\//, "").replace(/\/$/, "")}
                  </a>
                )}
              </div>
              <span class="cv-entry-date">
                {fmtMonthYear(work.startDate)} — {fmtMonthYear(work.endDate)}
              </span>
            </div>
            {work.description && (
              <p class="cv-entry-context">{work.description}</p>
            )}
            <ul class="cv-roles">
              {work.positions.map((role, ri) => (
                <li class="cv-role" data-role-index={ri}>
                  <div class="cv-role-head">
                    <span class="cv-role-title">{role.title}</span>
                    <span class="cv-role-date">
                      {fmtMonthYear(role.startDate)} —{" "}
                      {fmtMonthYear(role.endDate)}
                    </span>
                  </div>
                  {role.description && (
                    <p class="cv-role-desc">{role.description}</p>
                  )}
                </li>
              ))}
            </ul>
            {work.positions.length > 0 && (
              <p class="cv-roles-compact">
                {work.positions.map((r) => r.title).join(" · ")}
              </p>
            )}
          </div>
        ))
      }
    </section>

    <section class="cv-section" data-section="education">
      <h2 class="cv-section-title">Education</h2>
      {
        processedEducation.map((edu, i) => (
          <div class="cv-entry" data-entry="education" data-index={i}>
            <div class="cv-entry-head">
              <h3 class="cv-entry-title">{edu.institution}</h3>
              <span class="cv-entry-date">
                {fmtYear(edu.startDate)} —{" "}
                {edu.endDate === "Present" && edu.expectedEnd
                  ? `${fmtYear(edu.expectedEnd)} (expected)`
                  : fmtYear(edu.endDate)}
              </span>
            </div>
            <p class="cv-edu-degree">
              {edu.degree}
              {edu.field && <span class="cv-edu-field"> · {edu.field}</span>}
            </p>
          </div>
        ))
      }
    </section>

    <section class="cv-section" data-section="projects">
      <h2 class="cv-section-title">Selected Projects</h2>
      <ul class="cv-projects">
        {
          projects.map((p, i) => (
            <li class="cv-project" data-entry="project" data-index={i}>
              <div class="cv-project-head">
                <div class="cv-project-title-group">
                  <span class="cv-project-title">{p.data.title}</span>
                  {p.data.demoURL && (
                    <a
                      class="cv-project-link"
                      href={p.data.demoURL}
                      target="_blank"
                      rel="noopener"
                    >
                      {p.data.demoURL.replace(/^https?:\/\//, "").replace(/\/$/, "")}
                    </a>
                  )}
                  {p.data.repoURL && (
                    <a
                      class="cv-project-link"
                      href={p.data.repoURL}
                      target="_blank"
                      rel="noopener"
                    >
                      {p.data.repoURL.replace(/^https?:\/\//, "").replace(/\/$/, "")}
                    </a>
                  )}
                </div>
                <span class="cv-project-date">
                  {p.data.date.getFullYear()}
                </span>
              </div>
              <p class="cv-project-desc">{p.data.description}</p>
            </li>
          ))
        }
      </ul>
    </section>

  </div>
</PageLayout>

<style is:global>
  /* @page margin: 0 so Chrome has no space to inject its header/footer
     (the "URL — date — page X/Y" line). The CV's own page margins are
     applied inside .cv-sheet via padding, see the @media print block. */
  @page {
    size: A4;
    margin: 0;
  }

  /* Neutralize the global `main { py-32 }` rule for the CV page */
  body:has(.cv-sheet) main {
    padding-top: 0 !important;
    padding-bottom: 0 !important;
  }

  /* Hide the site Footer (Spotify widget, "Let's Connect", links) on
     /cv — both screen and print. The Footer renders as a plain <div>
     inside <main>, so we target main's children that aren't the sheet. */
  body:has(.cv-sheet) main > *:not(.cv-sheet) {
    display: none !important;
  }

  /* Links inside the CV: match the rest of the site —
     underlined with subtle decoration that darkens on hover. */
  .cv-sheet a {
    color: inherit;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
    text-decoration-color: rgba(0, 0, 0, 0.2);
    transition: text-decoration-color 200ms ease;
  }
  .cv-sheet a:hover {
    text-decoration-color: currentColor;
  }
  :is(.dark) .cv-sheet a {
    text-decoration-color: rgba(255, 255, 255, 0.25);
  }

  /* CSS variables driven by the tuning panel. Everything that contributes
     to vertical rhythm is multiplied by --cv-scale (font sizes) and
     --cv-density (margins/paddings). */
  .cv-sheet {
    --cv-scale: 1;
    --cv-density: 1;

    width: 210mm;
    max-width: 100%;
    margin: 0 auto;
    padding: 0 14mm;
    background: transparent;
    color: inherit;
    font-size: calc(9.5pt * var(--cv-scale));
    line-height: 1.55;
  }

  /* Header */
  .cv-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px;
    padding-top: calc(8px * var(--cv-density));
    padding-bottom: calc(18px * var(--cv-density));
    margin-bottom: calc(22px * var(--cv-density));
    border-bottom: 1px solid;
    border-bottom-color: rgba(0, 0, 0, 0.15);
  }
  :is(.dark) .cv-header {
    border-bottom-color: rgba(255, 255, 255, 0.2);
  }
  .cv-name {
    font-family: "Instrument Serif", ui-serif, Georgia, serif !important;
    font-size: calc(36pt * var(--cv-scale));
    line-height: 1;
    margin: 0;
    font-weight: 400;
    letter-spacing: -0.01em;
  }
  .cv-position {
    margin: calc(8px * var(--cv-density)) 0 0;
    font-size: calc(10pt * var(--cv-scale));
  }
  .cv-contact {
    list-style: none;
    margin: 0;
    padding: calc(28px * var(--cv-density)) 0 0;
    text-align: right;
    font-size: calc(8.5pt * var(--cv-scale));
    line-height: 1.7;
  }
  .cv-contact a {
    color: inherit;
    text-decoration: none;
  }

  /* Sections */
  .cv-section {
    margin-bottom: calc(16px * var(--cv-density));
    page-break-inside: auto;
  }
  .cv-section-title {
    font-family: "Instrument Serif", ui-serif, Georgia, serif !important;
    font-size: calc(14pt * var(--cv-scale));
    font-weight: 600;
    margin: 0 0 calc(8px * var(--cv-density));
    padding-bottom: 3px;
    border-bottom: 1px solid #cecdc3;
    letter-spacing: 0.02em;
    break-after: avoid;
    page-break-after: avoid;
  }
  .cv-summary {
    margin: 0;
  }

  /* Entries */
  .cv-entry {
    margin-bottom: calc(12px * var(--cv-density));
    page-break-inside: avoid;
  }
  .cv-entry:last-child {
    margin-bottom: 0;
  }
  .cv-entry-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
  }
  .cv-entry-title-group {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 10px;
    min-width: 0;
  }
  .cv-entry-title {
    margin: 0;
    font-size: calc(11pt * var(--cv-scale));
    font-weight: 600;
  }
  .cv-entry-date {
    font-family: "Ioskeley Mono", ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace !important;
    font-size: calc(8.5pt * var(--cv-scale));
    color: #575653;
    white-space: nowrap;
  }
  .cv-entry-context {
    margin: 2px 0 calc(6px * var(--cv-density));
    font-size: calc(9.5pt * var(--cv-scale));
    color: #575653;
    font-style: italic;
  }
  .cv-entry-website,
  .cv-project-link {
    font-family: "Ioskeley Mono", ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace !important;
    font-size: calc(8pt * var(--cv-scale));
    color: inherit;
    text-decoration: none !important;
    opacity: 0.55;
    white-space: nowrap;
    transition: opacity 150ms ease;
  }
  .cv-entry-website:hover,
  .cv-project-link:hover {
    opacity: 1;
    text-decoration: underline !important;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
  }

  /* Compact horizontal roles list — shown only in print when drop 3 is
     active for non-latest jobs (replaces the bordered .cv-roles list). */
  .cv-roles-compact {
    display: none;
    margin: 2px 0 0;
    font-size: calc(9.5pt * var(--cv-scale));
    color: #403e3c;
  }

  /* Drop priority rules — print-only. The on-screen /cv view always
     shows the full content. Order: 1) project descriptions,
     2) previous company bios, 3) previous company roles → replaced
     with a horizontal compact list, 4) entire Selected Projects
     section. See the corresponding @media print block below. */

  /* Roles */
  .cv-roles {
    list-style: none;
    margin: 0;
    padding: 0;
    border-left: 1px solid #cecdc3;
  }
  .cv-role {
    padding: calc(4px * var(--cv-density)) 0 calc(4px * var(--cv-density)) 12px;
    page-break-inside: avoid;
  }
  .cv-role:not(:last-child) {
    margin-bottom: calc(4px * var(--cv-density));
  }
  .cv-role-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
  }
  .cv-role-title {
    font-weight: 500;
    font-size: calc(10pt * var(--cv-scale));
  }
  .cv-role-date {
    font-family: "Ioskeley Mono", ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace !important;
    font-size: calc(8pt * var(--cv-scale));
    color: #6f6e69;
    white-space: nowrap;
  }
  .cv-role-desc {
    margin: 2px 0 0;
    font-size: calc(9.5pt * var(--cv-scale));
    color: #282726;
  }

  /* Education */
  .cv-edu-degree {
    margin: 2px 0 0;
    font-size: calc(10pt * var(--cv-scale));
  }
  .cv-edu-field {
    color: #575653;
  }

  /* Projects */
  .cv-projects {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .cv-project {
    margin-bottom: calc(8px * var(--cv-density));
    page-break-inside: avoid;
  }
  .cv-project-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
  }
  .cv-project-title-group {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 10px;
    min-width: 0;
  }
  .cv-project-title {
    font-weight: 600;
    font-size: calc(10.5pt * var(--cv-scale));
  }
  .cv-project-date {
    font-family: "Ioskeley Mono", ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace !important;
    font-size: calc(8.5pt * var(--cv-scale));
    color: #575653;
  }
  .cv-project-desc {
    margin: 1px 0 0;
    font-size: calc(9.5pt * var(--cv-scale));
  }

  /* Print rules */
  @media print {
    :root { color-scheme: light; }
    html, body {
      background: #ffffff !important;
      color: #100f0f !important;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }
    nav,
    .fixed.inset-0.pointer-events-none,
    a[href="#main-content"] {
      display: none !important;
    }
    /* Apply page margins INSIDE the sheet on print (since @page
       margin is 0 to suppress the browser's URL/date header).
       Tighter padding + denser typography below keeps the CV on a
       single A4 page. */
    .cv-sheet {
      width: auto;
      max-width: none;
      margin: 0;
      padding: 10mm 12mm;
      background: #ffffff;
      color: #100f0f;
      font-size: 8.5pt;
      line-height: 1.35;
    }
    /* Links: subtle, no color shift */
    a {
      color: inherit;
      text-decoration: none;
    }

    /* Tightened header for print */
    .cv-header {
      padding-top: 0;
      padding-bottom: 8px;
      margin-bottom: 10px;
    }
    .cv-name {
      font-size: 26pt;
    }
    .cv-position {
      margin-top: 3px;
      font-size: 9pt;
    }
    .cv-contact {
      padding-top: 0;
      font-size: 7.5pt;
      line-height: 1.5;
    }

    /* Tightened sections + entries for print */
    .cv-section {
      margin-bottom: 8px;
      page-break-inside: auto;
    }
    .cv-section-title {
      font-size: 11pt;
      margin-bottom: 4px;
      padding-bottom: 2px;
    }
    .cv-entry {
      margin-bottom: 6px;
      page-break-inside: avoid;
    }
    .cv-entry-title {
      font-size: 10pt;
    }
    .cv-entry-date {
      font-size: 7.5pt;
    }
    .cv-entry-context {
      margin: 1px 0 3px;
      font-size: 8.5pt;
    }

    /* Roles */
    .cv-role {
      padding: 2px 0 2px 10px;
      page-break-inside: avoid;
    }
    .cv-role:not(:last-child) {
      margin-bottom: 2px;
    }
    .cv-role-title {
      font-size: 9pt;
    }
    .cv-role-date {
      font-size: 7.5pt;
    }
    .cv-role-desc {
      margin-top: 1px;
      font-size: 8.5pt;
    }

    /* Education */
    .cv-edu-degree {
      font-size: 9pt;
    }

    /* Projects */
    .cv-project {
      margin-bottom: 4px;
      page-break-inside: avoid;
    }
    .cv-project-title {
      font-size: 9.5pt;
    }
    .cv-project-date {
      font-size: 7.5pt;
    }
    .cv-project-desc {
      font-size: 8.5pt;
    }
    .cv-project-links {
      font-size: 7.5pt;
    }

    /* Drop priority — print-only application. */
    .cv-sheet[data-drop-project-desc] .cv-project-desc { display: none; }
    .cv-sheet[data-drop-prev-bios]
      [data-entry="work"]:not([data-index="0"]) .cv-entry-context { display: none; }
    .cv-sheet[data-drop-prev-roles]
      [data-entry="work"]:not([data-index="0"]) .cv-roles { display: none; }
    .cv-sheet[data-drop-prev-roles]
      [data-entry="work"]:not([data-index="0"]) .cv-roles-compact { display: block; }
    .cv-sheet[data-drop-projects-section] [data-section="projects"] { display: none; }
  }

  /* Opacity-based muted text (adapts to light & dark on screen) */
  .cv-position,
  .cv-contact,
  .cv-entry-context,
  .cv-entry-date,
  .cv-role-date,
  .cv-project-date,
  .cv-edu-field {
    color: inherit;
    opacity: 0.65;
  }
  .cv-header { border-bottom-color: currentColor; }
  .cv-section-title, .cv-roles {
    border-color: currentColor;
    opacity: 1;
  }
  .cv-section-title {
    border-bottom-color: color-mix(in srgb, currentColor 30%, transparent);
  }
  .cv-roles {
    border-left-color: color-mix(in srgb, currentColor 25%, transparent);
  }

  @media print {
    .cv-position,
    .cv-contact,
    .cv-entry-context,
    .cv-entry-date,
    .cv-role-date,
    .cv-project-date,
    .cv-edu-field {
      color: #403e3c;
      opacity: 1;
    }
    .cv-header { border-bottom-color: #100f0f; }
    .cv-section-title { border-bottom-color: #cecdc3; }
    .cv-roles { border-left-color: #cecdc3; }
  }

</style>

