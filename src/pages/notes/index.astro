---
import ArrowCard from "@components/ArrowCard.astro";
import Container from "@components/Container.astro";
import Nav from "@components/Nav.astro";
import PageLayout from "@layouts/PageLayout.astro";
import { getCollection } from "astro:content";

const notes = (await getCollection("notes"))
  .filter((note) => !note.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<PageLayout title="Notes" description="Notes and fragments.">
  <Container>
    <div class="space-y-2">
      <Nav breadCrumbsItems={[{ href: "/notes", label: "Notes" }]} />
    </div>
    <div class="space-y-12 my-12">
      <div class="font-semibold text-black dark:text-white font-serif">Notes / fragments</div>
      {notes.length > 0 ? (
        <ul class="flex flex-col gap-4">
          {notes.map((note) => (
            <li>
              <ArrowCard entry={note} dateFormat="day" />
            </li>
          ))}
        </ul>
      ) : (
        <p class="text-sm text-neutral-600 dark:text-neutral-400">No published notes yet.</p>
      )}
    </div>
  </Container>
</PageLayout>
