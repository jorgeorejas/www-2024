---
import MarginPage from "@components/margin/MarginPage.astro";
import Row from "@components/margin/Row.astro";

// Only allow this page in development mode
if (import.meta.env.PROD) {
  return Astro.redirect("/");
}

type TokenData = { refresh_token?: string } & Record<string, unknown>;

const CLIENT_ID = import.meta.env.SPOTIFY_CLIENT_ID;
const CLIENT_SECRET = import.meta.env.SPOTIFY_CLIENT_SECRET;
// Use custom redirect URL if provided, otherwise use current origin
const REDIRECT_URI = import.meta.env.SPOTIFY_REDIRECT_URI || `${Astro.url.origin}/spotify-auth`;
const SCOPES = "user-read-currently-playing user-read-playback-state user-read-recently-played";

let authorizationUrl = "";
let tokenData: TokenData | null = null;
let error: string | null = null;

// Check if we have a code in the URL (callback from Spotify)
const code = Astro.url.searchParams.get("code");

if (code) {
  // Exchange code for tokens
  try {
    const response = await fetch("https://accounts.spotify.com/api/token", {
      method: "POST",
      headers: {
        "Content-Type": "application/x-www-form-urlencoded",
        "Authorization": "Basic " + btoa(`${CLIENT_ID}:${CLIENT_SECRET}`)
      },
      body: new URLSearchParams({
        grant_type: "authorization_code",
        code: code,
        redirect_uri: REDIRECT_URI
      })
    });

    if (response.ok) {
      tokenData = await response.json();
    } else {
      const errorData = await response.json();
      error = errorData.error_description || "Failed to get tokens";
    }
  } catch (e) {
    error = e instanceof Error ? e.message : "An unknown error occurred";
  }
} else {
  // Generate authorization URL
  authorizationUrl = `https://accounts.spotify.com/authorize?client_id=${CLIENT_ID}&response_type=code&redirect_uri=${encodeURIComponent(REDIRECT_URI)}&scope=${encodeURIComponent(SCOPES)}`;
}

const button =
  "inline-block border border-flexoki-ink bg-flexoki-ink px-3 py-1.5 text-[13px] text-flexoki-paper transition-colors hover:bg-transparent hover:text-flexoki-ink";
const box = "border-l border-rule pl-4 py-1 grid gap-2 text-[13px]";
---

<MarginPage
  title="Spotify authorization"
  description="Development-only page to get a Spotify refresh token for the now playing widget."
  current={null}
  breadcrumbs={[{ href: "/spotify-auth", label: "Spotify authorization" }]}
>
  <Row>
    <div class="grid gap-8">
      <h1 class="m-h1">Spotify authorization</h1>

      {
        !code && !tokenData && (
          <>
            <dl class={box}>
              <div>
                <dt class="text-mute">Client ID</dt>
                <dd class="break-all">{CLIENT_ID}</dd>
              </div>
              <div>
                <dt class="text-mute">Redirect URI</dt>
                <dd class="break-all">{REDIRECT_URI}</dd>
              </div>
              <div>
                <dt class="text-mute">Scopes</dt>
                <dd>user-read-currently-playing, user-read-playback-state, user-read-recently-played</dd>
              </div>
            </dl>

            <p>Click the button below to authorize this application with your Spotify account:</p>

            <p>
              <a href={authorizationUrl} class={button}>
                Login with Spotify
              </a>
            </p>
          </>
        )
      }

      {
        error && (
          <div class="grid gap-4 border-l-2 border-flexoki-red-600 pl-4" role="alert">
            <h2 class="font-serif text-[26px] leading-tight text-flexoki-ink">Error</h2>
            <p class="text-flexoki-red-600">{error}</p>
            <p>
              <a href="/spotify-auth" class={button}>
                Try Again
              </a>
            </p>
          </div>
        )
      }

      {
        tokenData && (
          <>
            <div class="grid gap-2 border-l-2 border-flexoki-green-600 pl-4">
              <h2 class="font-serif text-[26px] leading-tight text-flexoki-ink">Success!</h2>
              <p>You've successfully authorized the application.</p>
            </div>

            <div class="grid gap-3">
              <h3 class="font-serif text-xl text-flexoki-ink">Your Refresh Token:</h3>
              <pre
                id="refresh-token"
                class="overflow-x-auto whitespace-pre-wrap break-all border border-rule bg-flexoki-base-50 p-4 text-xs"
              >{tokenData.refresh_token}</pre>
              <p>
                <button type="button" id="copy-token" class={button}>
                  Copy to Clipboard
                </button>
                <span id="copy-status" class="ml-3 text-[12px] text-mute" role="status" aria-live="polite"></span>
              </p>
            </div>

            <div class="m-prose">
              <h3>Next Steps:</h3>
              <ol>
                <li>Copy the refresh token above</li>
                <li>
                  Open your <code>.env</code> file
                </li>
                <li>
                  Update the line: <code>SPOTIFY_REFRESH_TOKEN=your_token_here</code>
                </li>
                <li>Save the file</li>
                <li>Restart your dev server</li>
              </ol>
            </div>

            <details class="text-[13px]">
              <summary class="cursor-pointer font-semibold text-flexoki-ink">Full Response (for debugging)</summary>
              <pre class="mt-3 overflow-x-auto border border-rule bg-flexoki-base-50 p-4 text-xs">{JSON.stringify(tokenData, null, 2)}</pre>
            </details>
          </>
        )
      }
    </div>
  </Row>
</MarginPage>

<script>
  // A module script: wire the button here instead of an inline onclick
  const button = document.getElementById("copy-token");
  const status = document.getElementById("copy-status");
  button?.addEventListener("click", async () => {
    const token = document.getElementById("refresh-token")?.textContent?.trim();
    const say = (text: string) => {
      if (status) status.textContent = text;
    };
    if (!token) {
      say("Failed to copy. Please select and copy manually.");
      return;
    }
    try {
      await navigator.clipboard.writeText(token);
      say("Token copied to clipboard!");
    } catch {
      say("Failed to copy. Please select and copy manually.");
    }
  });
</script>
