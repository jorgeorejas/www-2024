---
// Only allow this page in development mode
if (import.meta.env.PROD) {
  return Astro.redirect('/');
}

const CLIENT_ID = import.meta.env.SPOTIFY_CLIENT_ID;
const CLIENT_SECRET = import.meta.env.SPOTIFY_CLIENT_SECRET;
// Use custom redirect URL if provided, otherwise use current origin
const REDIRECT_URI = import.meta.env.SPOTIFY_REDIRECT_URI || `${Astro.url.origin}/spotify-auth`;
const SCOPES = 'user-read-currently-playing user-read-playback-state user-read-recently-played';

let authorizationUrl = '';
let tokenData = null;
let error = null;

// Check if we have a code in the URL (callback from Spotify)
const code = Astro.url.searchParams.get('code');

if (code) {
  // Exchange code for tokens
  try {
    const response = await fetch('https://accounts.spotify.com/api/token', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/x-www-form-urlencoded',
        'Authorization': 'Basic ' + btoa(`${CLIENT_ID}:${CLIENT_SECRET}`)
      },
      body: new URLSearchParams({
        grant_type: 'authorization_code',
        code: code,
        redirect_uri: REDIRECT_URI
      })
    });

    if (response.ok) {
      tokenData = await response.json();
    } else {
      const errorData = await response.json();
      error = errorData.error_description || 'Failed to get tokens';
    }
  } catch (e) {
    error = e.message;
  }
} else {
  // Generate authorization URL
  authorizationUrl = `https://accounts.spotify.com/authorize?client_id=${CLIENT_ID}&response_type=code&redirect_uri=${encodeURIComponent(REDIRECT_URI)}&scope=${encodeURIComponent(SCOPES)}`;
}
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Spotify Authorization</title>
  <style>
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      max-width: 800px;
      margin: 50px auto;
      padding: 20px;
      line-height: 1.6;
    }
    .button {
      background: #1DB954;
      color: white;
      border: none;
      padding: 12px 24px;
      font-size: 16px;
      border-radius: 24px;
      cursor: pointer;
      font-weight: bold;
      text-decoration: none;
      display: inline-block;
    }
    .button:hover {
      background: #1ed760;
    }
    pre {
      background: #f4f4f4;
      padding: 15px;
      border-radius: 5px;
      overflow-x: auto;
      font-size: 12px;
    }
    .success {
      background: #d4edda;
      border: 1px solid #c3e6cb;
      color: #155724;
      padding: 15px;
      border-radius: 5px;
      margin: 20px 0;
    }
    .error {
      background: #f8d7da;
      border: 1px solid #f5c6cb;
      color: #721c24;
      padding: 15px;
      border-radius: 5px;
      margin: 20px 0;
    }
    .info {
      background: #d1ecf1;
      border: 1px solid #bee5eb;
      color: #0c5460;
      padding: 15px;
      border-radius: 5px;
      margin: 20px 0;
    }
    .token-box {
      background: #fff3cd;
      border: 2px solid #ffc107;
      padding: 15px;
      border-radius: 5px;
      margin: 20px 0;
    }
    .copy-btn {
      background: #007bff;
      color: white;
      border: none;
      padding: 8px 16px;
      border-radius: 4px;
      cursor: pointer;
      margin-top: 10px;
    }
    .copy-btn:hover {
      background: #0056b3;
    }
  </style>
</head>
<body>
  <h1>🎵 Spotify Authorization</h1>

  {!code && !tokenData && (
    <div>
      <div class="info">
        <p><strong>Client ID:</strong> {CLIENT_ID}</p>
        <p><strong>Redirect URI:</strong> {REDIRECT_URI}</p>
        <p><strong>Scopes:</strong> user-read-currently-playing, user-read-playback-state, user-read-recently-played</p>
      </div>

      <p>Click the button below to authorize this application with your Spotify account:</p>

      <a href={authorizationUrl} class="button">
        🎧 Login with Spotify
      </a>
    </div>
  )}

  {error && (
    <div class="error">
      <h2>❌ Error</h2>
      <p>{error}</p>
      <a href="/spotify-auth" class="button">Try Again</a>
    </div>
  )}

  {tokenData && (
    <div>
      <div class="success">
        <h2>✅ Success!</h2>
        <p>You've successfully authorized the application.</p>
      </div>

      <div class="token-box">
        <h3>📋 Your Refresh Token:</h3>
        <pre id="refresh-token">{tokenData.refresh_token}</pre>
        <button class="copy-btn" onclick="copyToken()">Copy to Clipboard</button>
      </div>

      <div class="info">
        <h3>Next Steps:</h3>
        <ol>
          <li>Copy the refresh token above</li>
          <li>Open your <code>.env</code> file</li>
          <li>Update the line: <code>SPOTIFY_REFRESH_TOKEN=your_token_here</code></li>
          <li>Save the file</li>
          <li>Restart your dev server</li>
        </ol>
      </div>

      <details style="margin-top: 20px;">
        <summary style="cursor: pointer; font-weight: bold;">Full Response (for debugging)</summary>
        <pre>{JSON.stringify(tokenData, null, 2)}</pre>
      </details>
    </div>
  )}

  <script>
    function copyToken() {
      const token = document.getElementById('refresh-token').textContent;
      navigator.clipboard.writeText(token).then(() => {
        alert('✅ Token copied to clipboard!');
      }).catch(() => {
        alert('❌ Failed to copy. Please select and copy manually.');
      });
    }
  </script>
</body>
</html>
