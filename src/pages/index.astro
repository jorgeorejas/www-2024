---
import AnimatedLink from "@components/AnimatedLink.astro";
import ArrowCard from "@components/ArrowCard.astro";
import Container from "@components/Container.astro";
import ContentBlock from "@components/ContentBlock.astro";
import Nav from "@components/Nav.astro";
import RecipeCard from "@components/cocina/RecipeCard.astro";
import WorkTimeline from "@components/WorkTimeline.astro";
import { HOME, SITE } from "@consts";
import PageLayout from "@layouts/PageLayout.astro";
import { cachePage } from "@lib/cache-headers";
import { processWorkEntry } from "@lib/utils";
import { generatePersonSchema } from "@lib/seo-utils";
import { getLiveCollection } from "astro:content";

// Which blocks show on the home page, in which order and with which titles,
// comes from the "Secciones" database in Notion (En inicio, Orden…)
const sections = Astro.locals.sections ?? [];
const home = sections.find((s) => s.path === "/");
const homeSections = sections.filter((s) => s.onHome);

const [blog, projects, work, recipes, blocks] = await Promise.all([
  getLiveCollection("blog"),
  getLiveCollection("projects"),
  getLiveCollection("work"),
  homeSections.some((s) => s.path === "/cocina")
    ? getLiveCollection("recipes")
    : Promise.resolve({ entries: [], error: undefined }),
  getLiveCollection("blocks"),
]);
cachePage(
  Astro.response,
  ["blog", "projects", "work", "recipes"],
  blog.error ?? projects.error ?? work.error ?? recipes.error ?? blocks.error,
);

const games = [
  {
    title: "Klondike Solitaire",
    description:
      "Classic Klondike Solitaire with Easy (1 card) and Hard (3 cards) difficulty modes.",
    href: "/games/solitaire",
  },
  {
    title: "Conway's Game of Life",
    description:
      "A mesmerizing cellular automaton where simple rules create complex, beautiful patterns.",
    href: "/games/game-of-life",
  },
  {
    title: "Minesweeper",
    description:
      "The classic logic puzzle. Reveal every safe square without detonating a mine.",
    href: "/games/minesweeper",
  },
];

const count = (path: string, fallback: number) =>
  sections.find((s) => s.path === path)?.homeCount ?? fallback;

const posts = (blog.entries ?? []).slice(0, count("/blog", SITE.NUM_POSTS_ON_HOMEPAGE));
const recentProjects = (projects.entries ?? []).slice(0, count("/projects", SITE.NUM_PROJECTS_ON_HOMEPAGE));
const processedWork = (work.entries ?? [])
  .slice(0, count("/work", SITE.NUM_WORKS_ON_HOMEPAGE))
  .map((entry) => processWorkEntry({ id: entry.id, data: entry.data, body: entry.data.body }));
const homeGames = games.slice(0, count("/games", SITE.NUM_GAMES_ON_HOMEPAGE));
const homeRecipes = (recipes.entries ?? []).slice(0, count("/cocina", 3));

// Without Notion sections (first run, or Notion down) show the classic layout
const layout = homeSections.length
  ? homeSections
  : [
      { path: "/blog", homeTitle: "Latest posts", homeLink: "See all posts" },
      { path: "/projects", homeTitle: "Recent projects", homeLink: "See all projects" },
      { path: "/work", homeTitle: "Work Experience", homeLink: "See all work" },
    ];

const bioBlocks = home?.blocks.length ? home.blocks : ["bio"];

const personSchema = generatePersonSchema(Astro.site!.toString());
const headingClass = "text-2xl font-semibold text-flexoki-ink dark:text-flexoki-base-50 font-serif";
---

<PageLayout
  title={HOME.TITLE}
  description={HOME.DESCRIPTION}
  type="profile"
  structuredData={personSchema}
>
  <Container>
    <Nav />
    <div class="space-y-20">
      <section class="space-y-4">
        {bioBlocks.map((slug) => <ContentBlock slug={slug} class="space-y-4" />)}
      </section>

      {
        layout.map((section) => (
          <section class="space-y-8">
            <div class="flex flex-wrap gap-y-2 items-center justify-between">
              <h2 class={headingClass}>{section.homeTitle}</h2>
              {section.homeLink && (
                <AnimatedLink href={section.path}>{section.homeLink}</AnimatedLink>
              )}
            </div>

            {section.path === "/blog" && (
              <ul class="flex flex-col gap-4">
                {posts.map((post) => (
                  <li>
                    <ArrowCard entry={post} collection="blog" dateFormat="day" />
                  </li>
                ))}
              </ul>
            )}

            {section.path === "/projects" && (
              <ul class="flex flex-col gap-4">
                {recentProjects.map((project) => (
                  <li>
                    <ArrowCard entry={project} collection="projects" />
                  </li>
                ))}
              </ul>
            )}

            {section.path === "/work" && <WorkTimeline processedWork={processedWork} />}

            {section.path === "/cocina" && (
              <ul class="grid grid-cols-1 sm:grid-cols-3 gap-6">
                {homeRecipes.map((recipe) => (
                  <li>
                    <RecipeCard recipe={recipe} size="small" />
                  </li>
                ))}
              </ul>
            )}

            {section.path === "/games" && (
              <ul class="flex flex-col gap-4">
                {homeGames.map((game) => (
                  <li>
                    <a
                      href={game.href}
                      class="relative group flex flex-nowrap py-3 px-4 pr-10 border-l border-flexoki-base-200 dark:border-flexoki-base-800 hover:bg-flexoki-base-100 dark:hover:bg-flexoki-base-900 hover:text-flexoki-ink dark:hover:text-flexoki-base-50 transition-colors duration-300 ease-in-out"
                    >
                      <div class="flex flex-col gap-1 flex-1">
                        <div class="font-semibold font-serif">{game.title}</div>
                        <div class="text-sm">{game.description}</div>
                      </div>
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </section>
        ))
      }
    </div>
  </Container>
</PageLayout>
