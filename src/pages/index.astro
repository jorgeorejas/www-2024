---
import AppellationBand from "@components/AppellationBand.astro";
import ArrowCard from "@components/ArrowCard.astro";
import Container from "@components/Container.astro";
import ContentBlock from "@components/ContentBlock.astro";
import Monogram from "@components/Monogram.astro";
import Nav from "@components/Nav.astro";
import WorkTimeline from "@components/WorkTimeline.astro";
import { AnimatedSignature } from "@components/AnimatedSignature";
import { HOME, SITE } from "@consts";
import PageLayout from "@layouts/PageLayout.astro";
import { getWorkDateRange, processWorkEntry } from "@lib/utils";
import { generatePersonSchema } from "@lib/seo-utils";
import { getCollection } from "astro:content";

const today = new Date();
today.setHours(0, 0, 0, 0);

const isDev = import.meta.env.DEV;

const blog = (await getCollection("blog"))
  .filter((post) => !post.data.draft && (isDev || post.data.date <= today))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, SITE.NUM_POSTS_ON_HOMEPAGE);

const projects = (await getCollection("projects"))
  .filter((project) => !project.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, SITE.NUM_PROJECTS_ON_HOMEPAGE);

const allwork = (await getCollection("work"))
  .sort((a, b) => {
    const aDateRange = getWorkDateRange(a.data.roles);
    const bDateRange = getWorkDateRange(b.data.roles);
    return bDateRange.startDate.valueOf() - aDateRange.startDate.valueOf();
  })
  .slice(0, SITE.NUM_WORKS_ON_HOMEPAGE);

const processedWork = allwork.map((item) => processWorkEntry(item));

const personSchema = generatePersonSchema(Astro.site!.toString());
---

<PageLayout
  title={HOME.TITLE}
  description={HOME.DESCRIPTION}
  type="profile"
  structuredData={personSchema}
>
  <Container>
    <Nav />

    {/* Hero — wine-label wordmark + animated signature flourish */}
    <section class="pt-20 md:pt-28 pb-12 relative" aria-label="Introduction">
      <div class="flex flex-col gap-8">
        <div class="flex items-start justify-between gap-6">
          <p class="eyebrow">Madrid · Asturias · Vintage MMXXVI</p>
          <div class="hidden sm:block opacity-70">
            <Monogram
              size={56}
              class="text-[var(--color-bodega-gold)] dark:text-[var(--color-bodega-gold-dark)]"
            />
          </div>
        </div>

        <h1 class="wordmark break-words">{SITE.NAME}</h1>

        <div class="flex flex-col gap-6">
          <p class="vintage">{SITE.POSITION}</p>
          <div
            class="max-w-md text-[var(--color-bodega-bordeaux)] dark:text-[var(--color-bodega-bordeaux-dark)]"
            aria-label="Animated signature"
          >
            <AnimatedSignature client:visible className="h-12 md:h-16 w-auto" />
          </div>
        </div>
      </div>
      <div class="rule-hairline h-0 mt-10"></div>
    </section>

    <div class="space-y-20 pb-16">
      {/* Bio — back-label treatment */}
      <section
        class="grid gap-6 md:grid-cols-[160px_1fr]"
        aria-label="About"
      >
        <p class="eyebrow md:pt-1">Tasting Notes</p>
        <div class="bio-prose space-y-4">
          <ContentBlock slug="bio" class="space-y-4" />
        </div>
      </section>

      {/* Writing — sienna */}
      <section class="space-y-6" aria-label="Latest writing">
        <AppellationBand
          variant="sienna"
          eyebrow="Writing"
          subtitle="Notes, essays, fragments."
          href="/blog"
          hrefLabel="All posts"
        />
        <ul class="flex flex-col gap-1">
          {
            blog.map((post) => (
              <li>
                <ArrowCard entry={post} dateFormat="day" variant="sienna" />
              </li>
            ))
          }
        </ul>
      </section>

      {/* Projects — sage */}
      <section class="space-y-6" aria-label="Recent projects">
        <AppellationBand
          variant="sage"
          eyebrow="Projects"
          subtitle="Selected work I've shipped."
          href="/projects"
          hrefLabel="All projects"
        />
        <ul class="flex flex-col gap-1">
          {
            projects.map((project) => (
              <li>
                <ArrowCard entry={project} variant="sage" />
              </li>
            ))
          }
        </ul>
      </section>

      {/* Work — bordeaux */}
      <section class="space-y-6" aria-label="Work experience">
        <AppellationBand
          variant="bordeaux"
          eyebrow="Experience"
          subtitle="Where I've worked."
          href="/work"
          hrefLabel="Full history"
        />
        <WorkTimeline processedWork={processedWork} />
      </section>
    </div>
  </Container>
</PageLayout>

<style>
  /* Subtle Pomal-style warmth on the bio's opening line:
     the first line of the first paragraph picks up the serif. */
  .bio-prose :global(article > p:first-child::first-line) {
    font-family: "Instrument Serif", ui-serif, Georgia, serif;
    font-size: 1.35rem;
    line-height: 1.1;
  }
</style>
