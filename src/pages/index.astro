---
import { AnimatedSignature } from "@components/AnimatedSignature";
import ContentBlock from "@components/ContentBlock.astro";
import Legend from "@components/margin/Legend.astro";
import ListRow from "@components/margin/ListRow.astro";
import MarginPage from "@components/margin/MarginPage.astro";
import NowNote from "@components/margin/NowNote.astro";
import NowPlayingMini from "@components/margin/NowPlayingMini.astro";
import Row from "@components/margin/Row.astro";
import SectionHead from "@components/margin/SectionHead.astro";
import { HOME, SITE } from "@consts";
import { cachePage } from "@lib/cache-headers";
import { formatMinutes, totalMinutes } from "@lib/cocina";
import { generatePersonSchema } from "@lib/seo-utils";
import { formatYear, isNew, processWorkEntry } from "@lib/utils";
import { getLiveCollection } from "astro:content";

// Which blocks show on the home page, in which order and with which titles,
// comes from the "Secciones" database in Notion (En inicio, Orden…)
const sections = Astro.locals.sections ?? [];
const home = sections.find((s) => s.path === "/");
const homeSections = sections.filter((s) => s.onHome);

const [blog, projects, work, recipes, blocks] = await Promise.all([
  getLiveCollection("blog"),
  getLiveCollection("projects"),
  getLiveCollection("work"),
  homeSections.some((s) => s.path === "/cocina")
    ? getLiveCollection("recipes")
    : Promise.resolve({ entries: [], error: undefined }),
  getLiveCollection("blocks"),
]);
cachePage(
  Astro.response,
  ["blog", "projects", "work", "recipes"],
  blog.error ?? projects.error ?? work.error ?? recipes.error ?? blocks.error,
);

const games = [
  {
    title: "Klondike Solitaire",
    description:
      "Classic Klondike Solitaire with Easy (1 card) and Hard (3 cards) difficulty modes.",
    href: "/games/solitaire",
  },
  {
    title: "Conway's Game of Life",
    description:
      "A mesmerizing cellular automaton where simple rules create complex, beautiful patterns.",
    href: "/games/game-of-life",
  },
  {
    title: "Minesweeper",
    description:
      "The classic logic puzzle. Reveal every safe square without detonating a mine.",
    href: "/games/minesweeper",
  },
];

const count = (path: string, fallback: number) =>
  sections.find((s) => s.path === path)?.homeCount ?? fallback;

const posts = (blog.entries ?? []).slice(0, count("/blog", SITE.NUM_POSTS_ON_HOMEPAGE));
const recentProjects = (projects.entries ?? []).slice(0, count("/projects", SITE.NUM_PROJECTS_ON_HOMEPAGE));
const processedWork = (work.entries ?? [])
  .slice(0, count("/work", SITE.NUM_WORKS_ON_HOMEPAGE))
  .map((entry) => processWorkEntry({ id: entry.id, data: entry.data, body: entry.data.body }));
const homeGames = games.slice(0, count("/games", SITE.NUM_GAMES_ON_HOMEPAGE));
const homeRecipes = (recipes.entries ?? []).slice(0, count("/cocina", 3));

type HomeSection = { path: string; title: string; link?: string };

// Without Notion sections (first run, or Notion down) show the classic layout
const layout: HomeSection[] = homeSections.length
  ? homeSections.map((s) => ({ path: s.path, title: s.homeTitle ?? s.title ?? s.name, link: s.homeLink }))
  : [
      { path: "/blog", title: "Latest posts", link: "See all posts" },
      { path: "/projects", title: "Recent projects", link: "See all projects" },
      { path: "/work", title: "Work Experience", link: "See all work" },
    ];

// Vertical label in the margin of each section
const LABELS: Record<string, string> = {
  "/blog": "writing",
  "/projects": "projects",
  "/work": "work",
  "/cocina": "kitchen",
  "/games": "games",
};
const headingId = (path: string) => `home-${path.replace(/[^a-z0-9]+/gi, "") || "section"}`;

// The "now" text block (Bloques, slug "now") is a hand note in the margin of
// the work section, or of the first section when work isn't on the home page
const hasNow = (blocks.entries ?? []).some((b) => b.id === "now");
const nowPath = layout.some((s) => s.path === "/work") ? "/work" : layout[0]?.path;

const bioBlocks = (home?.blocks.length ? home.blocks : ["bio"]).filter((slug) => slug !== "now");

const postsHaveMarkers = posts.some((p) => p.data.pick || isNew(p.data.date));
const projectsHaveMarkers = recentProjects.some((p) => p.data.pick || isNew(p.data.date));
const recipesHavePick = homeRecipes.some((r) => r.data.pick);

/** "2024 – now", "2022 – 2024", or one year when it started and ended the same year */
const years = (start: Date, end: Date | string) => {
  const from = formatYear(start);
  const to = end instanceof Date ? formatYear(end) : "now";
  return from === to ? from : `${from} – ${to}`;
};

const personSchema = generatePersonSchema(Astro.site!.toString());
---

<MarginPage
  title={HOME.TITLE}
  description={HOME.DESCRIPTION}
  type="profile"
  structuredData={personSchema}
  footerNowPlaying={false}
  nameAsHeading
>
  <div slot="intro" class="mt-11">
    <div class="m-prose">
      {bioBlocks.map((slug) => <ContentBlock slug={slug} as="none" />)}
    </div>
    <NowPlayingMini class="mt-4.5" />
    <AnimatedSignature client:visible tone="pen" className="w-33 mt-5.5" aria-hidden="true" />
  </div>

  {
    layout.map((section) => (
      <Row label={LABELS[section.path]} as="section" aria-labelledby={headingId(section.path)}>
        {hasNow && section.path === nowPath && <NowNote slot="margin" />}
        <SectionHead
          id={headingId(section.path)}
          title={section.title}
          href={section.path}
          linkLabel={section.link}
        />

        {section.path === "/blog" && (
          <>
            <ul class="m-list">
              {posts.map((post) => (
                <ListRow
                  href={`/blog/${post.id}`}
                  title={post.data.title}
                  titleCorrection={post.data.titleCorrection}
                  date={post.data.date}
                  description={post.data.description}
                  pick={post.data.pick}
                  isNew={isNew(post.data.date)}
                  note={post.data.note}
                />
              ))}
            </ul>
            {postsHaveMarkers && <Legend />}
          </>
        )}

        {section.path === "/projects" && (
          <>
            <ul class="m-list">
              {recentProjects.map((project) => (
                <ListRow
                  href={`/projects/${project.id}`}
                  title={project.data.title}
                  titleCorrection={project.data.titleCorrection}
                  value={formatYear(project.data.date)}
                  description={project.data.description}
                  pick={project.data.pick}
                  isNew={isNew(project.data.date)}
                  note={project.data.note}
                />
              ))}
            </ul>
            {projectsHaveMarkers && <Legend />}
          </>
        )}

        {section.path === "/work" && (
          <ul class="m-list">
            {processedWork.map((job) => (
              <ListRow
                href={`/work/${job.slug}`}
                title={job.name}
                value={years(job.startDate, job.endDate)}
                description={job.positions[0]?.title}
              />
            ))}
          </ul>
        )}

        {section.path === "/cocina" && (
          <>
            <ul class="m-list">
              {homeRecipes.map((recipe) => (
                <ListRow
                  href={`/cocina/${recipe.id}`}
                  title={recipe.data.title}
                  value={formatMinutes(totalMinutes(recipe.data))}
                  description={recipe.data.description}
                  pick={recipe.data.pick}
                  pickLabel="the favourite"
                  note={recipe.data.note}
                />
              ))}
            </ul>
            {recipesHavePick && <Legend text="◆ the favourite" />}
          </>
        )}

        {section.path === "/games" && (
          <ul class="m-list">
            {homeGames.map((game) => (
              <ListRow href={game.href} title={game.title} description={game.description} />
            ))}
          </ul>
        )}
      </Row>
    ))
  }
</MarginPage>
