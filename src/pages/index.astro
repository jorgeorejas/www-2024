---
import AnimatedLink from "@components/AnimatedLink.astro";
import ArrowCard from "@components/ArrowCard.astro";
import Container from "@components/Container.astro";
import ContentBlock from "@components/ContentBlock.astro";
import Nav from "@components/Nav.astro";
import { HOME, SITE } from "@consts";
import PageLayout from "@layouts/PageLayout.astro";
import { getCollection } from "astro:content";

const today = new Date();
today.setHours(0, 0, 0, 0);

const isDev = import.meta.env.DEV;

const blog = (await getCollection("blog"))
  .filter((post) => !post.data.draft && (isDev || post.data.date <= today))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, SITE.NUM_POSTS_ON_HOMEPAGE);

const projects = (await getCollection("projects"))
  .filter((project) => !project.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, SITE.NUM_PROJECTS_ON_HOMEPAGE);

const ideas = (await getCollection("ideas"))
  .filter((idea) => !idea.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, SITE.NUM_POSTS_ON_HOMEPAGE);

const notes = (await getCollection("notes"))
  .filter((note) => !note.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, SITE.NUM_POSTS_ON_HOMEPAGE);
---

<PageLayout title={HOME.TITLE} description={HOME.DESCRIPTION}>
  <Container>
    <Nav />
    <div class="space-y-20">
      <section>
        <ContentBlock slug="opening-statement" class="space-y-4" />
      </section>

      <section class="space-y-8">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <h5 class="font-semibold text-black dark:text-white font-serif">Writing</h5>
          <AnimatedLink href="/blog">Blog archive</AnimatedLink>
        </div>
        <ul class="flex flex-col gap-4">
          {
            blog.map((post) => (
              <li>
                <ArrowCard entry={post} dateFormat="day" />
              </li>
            ))
          }
        </ul>
      </section>

      <section class="space-y-8">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <h5 class="font-semibold text-black font-serif dark:text-white">Projects</h5>
          <AnimatedLink href="/projects">Project archive</AnimatedLink>
        </div>
        <ul class="flex flex-col gap-4">
          {
            projects.map((project) => (
              <li>
                <ArrowCard entry={project} />
              </li>
            ))
          }
        </ul>
      </section>

      <section class="space-y-8">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <h5 class="font-semibold text-black font-serif dark:text-white">Ideas in progress</h5>
          <AnimatedLink href="/ideas">Ideas index</AnimatedLink>
        </div>
        {
          ideas.length > 0 ? (
            <ul class="flex flex-col gap-4">
              {ideas.map((idea) => (
                <li>
                  <a href={`/ideas/${idea.slug}`} class="block py-2">
                    <span class="font-semibold font-serif">{idea.data.title}</span>
                    <span class="block text-sm text-neutral-600 dark:text-neutral-400">{idea.data.description}</span>
                  </a>
                </li>
              ))}
            </ul>
          ) : (
            <p class="text-sm text-neutral-600 dark:text-neutral-400">
              Placeholder collection ready for upcoming idea drafts.
            </p>
          )
        }
      </section>

      <section class="space-y-8">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <h5 class="font-semibold text-black font-serif dark:text-white">Notes / fragments</h5>
          <AnimatedLink href="/notes">Notes index</AnimatedLink>
        </div>
        {
          notes.length > 0 ? (
            <ul class="flex flex-col gap-4">
              {notes.map((note) => (
                <li>
                  <a href={`/notes/${note.slug}`} class="block py-2">
                    <span class="font-semibold font-serif">{note.data.title}</span>
                    <span class="block text-sm text-neutral-600 dark:text-neutral-400">{note.data.description}</span>
                  </a>
                </li>
              ))}
            </ul>
          ) : (
            <p class="text-sm text-neutral-600 dark:text-neutral-400">
              Placeholder collection ready for short notes and fragments.
            </p>
          )
        }
      </section>
    </div>
  </Container>
</PageLayout>
