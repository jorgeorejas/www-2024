---
import AnimatedLink from "@components/AnimatedLink.astro";
import ArrowCard from "@components/ArrowCard.astro";
import Container from "@components/Container.astro";
import ContentBlock from "@components/ContentBlock.astro";
import Nav from "@components/Nav.astro";
import WorkTimeline from "@components/WorkTimeline.astro";
import { HOME, SITE } from "@consts";
import PageLayout from "@layouts/PageLayout.astro";
import { getWorkDateRange, processWorkEntry } from "@lib/utils";
import { generatePersonSchema } from "@lib/seo-utils";
import { getCollection } from "astro:content";
const today = new Date();
today.setHours(0, 0, 0, 0);

const isDev = import.meta.env.DEV;

const blog = (await getCollection("blog"))
  .filter((post) => !post.data.draft && (isDev || post.data.date <= today))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, SITE.NUM_POSTS_ON_HOMEPAGE);

const projects = (await getCollection("projects"))
  .filter((project) => !project.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, SITE.NUM_PROJECTS_ON_HOMEPAGE);

const games = [
  {
    title: "Klondike Solitaire",
    description:
      "Classic Klondike Solitaire with Easy (1 card) and Hard (3 cards) difficulty modes.",
    href: "/games/solitaire",
  },
  {
    title: "Conway's Game of Life",
    description:
      "A mesmerizing cellular automaton where simple rules create complex, beautiful patterns.",
    href: "/games/game-of-life",
  },
  {
    title: "Minesweeper",
    description:
      "The classic logic puzzle. Reveal every safe square without detonating a mine.",
    href: "/games/minesweeper",
  },
].slice(0, SITE.NUM_GAMES_ON_HOMEPAGE);

const allwork = (await getCollection("work"))
  .sort((a, b) => {
    const aDateRange = getWorkDateRange(a.data.roles);
    const bDateRange = getWorkDateRange(b.data.roles);
    return bDateRange.startDate.valueOf() - aDateRange.startDate.valueOf();
  })
  .slice(0, SITE.NUM_WORKS_ON_HOMEPAGE);

// Process work entries for timeline
const processedWork = allwork.map((item) => processWorkEntry(item));

// Generate Person schema for SEO
const personSchema = generatePersonSchema(Astro.site!.toString());
---

<PageLayout
  title={HOME.TITLE}
  description={HOME.DESCRIPTION}
  type="profile"
  structuredData={personSchema}
>
  <Container>
    <Nav />
    <div class="space-y-20">
      <section>
        <ContentBlock slug="bio" class="space-y-4" />
      </section>

      <section class="space-y-8">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <h2 class="text-2xl font-semibold text-flexoki-ink dark:text-flexoki-base-50 font-serif">
            Latest posts
          </h2>
          <AnimatedLink href="/blog"> See all posts </AnimatedLink>
        </div>
        <ul class="flex flex-col gap-4">
          {
            blog.map((post) => (
              <li>
                <ArrowCard entry={post} dateFormat="day" />
              </li>
            ))
          }
        </ul>
      </section>

      <section class="space-y-8">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <h2 class="text-2xl font-semibold text-flexoki-ink font-serif dark:text-flexoki-base-50">
            Recent projects
          </h2>
          <AnimatedLink href="/projects"> See all projects </AnimatedLink>
        </div>
        <ul class="flex flex-col gap-4">
          {
            projects.map((project) => (
              <li>
                <ArrowCard entry={project} />
              </li>
            ))
          }
        </ul>
      </section>

      {/* TODO: re-enable Games section on homepage */}
      {false && (
        <section class="space-y-8">
          <div class="flex flex-wrap gap-y-2 items-center justify-between">
            <h2 class="text-2xl font-semibold text-flexoki-ink font-serif dark:text-flexoki-base-50">
              Games
            </h2>
            <AnimatedLink href="/games"> See all games </AnimatedLink>
          </div>
          <ul class="flex flex-col gap-4">
            {games.map((game) => (
              <li>
                <a
                  href={game.href}
                  class="relative group flex flex-nowrap py-3 px-4 pr-10 border-l border-flexoki-base-200 dark:border-flexoki-base-800 hover:bg-flexoki-base-100 dark:hover:bg-flexoki-base-900 hover:text-flexoki-ink dark:hover:text-flexoki-base-50 transition-colors duration-300 ease-in-out"
                >
                  <div class="flex flex-col gap-1 flex-1">
                    <div class="font-semibold font-serif">{game.title}</div>
                    <div class="text-sm">{game.description}</div>
                  </div>
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    class="absolute top-1/2 right-2 -translate-y-1/2 size-5 stroke-2 fill-none stroke-current"
                  >
                    <line
                      x1="5"
                      y1="12"
                      x2="19"
                      y2="12"
                      class="translate-x-3 group-hover:translate-x-0 scale-x-0 group-hover:scale-x-100 transition-transform duration-300 ease-in-out"
                    />
                    <polyline
                      points="12 5 19 12 12 19"
                      class="-translate-x-1 group-hover:translate-x-0 transition-transform duration-300 ease-in-out"
                    />
                  </svg>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}

      <section class="space-y-8">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <h2 class="text-2xl font-semibold text-flexoki-ink font-serif dark:text-flexoki-base-50">
            Work Experience
          </h2>
          <AnimatedLink href="/work"> See all work </AnimatedLink>
        </div>
        <WorkTimeline processedWork={processedWork} />
      </section>
    </div>
  </Container>
</PageLayout>
