---
import GameOfLifeComponent from "@components/games/GameOfLife.tsx";
import MarginPage from "@components/margin/MarginPage.astro";
import Row from "@components/margin/Row.astro";
---

<MarginPage
  title="El juego de la vida de Conway"
  description="Un autómata celular hipnótico: con cuatro reglas muy simples salen patrones complejos y preciosos."
  breadcrumbs={[
    { href: "/games", label: "Juegos" },
    { href: "/games/game-of-life", label: "El juego de la vida" },
  ]}
>
  <Row>
    <h1 class="m-h1 mb-10">El juego de la vida de Conway</h1>
    <div class="gol-shell">
      <GameOfLifeComponent client:only="react" />
    </div>
  </Row>
</MarginPage>

<style>
  /* The 64×64 board is wider than a phone column: scroll the board, not the page */
  .gol-shell :global([data-testid="gol-grid"]) {
    max-width: 100%;
    overflow-x: auto;
  }
</style>
