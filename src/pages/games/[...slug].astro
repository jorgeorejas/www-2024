---
import Container from "@components/Container.astro";
import Correction from "@components/Correction.astro";
import FormattedDate from "@components/FormattedDate.astro";
import Nav from "@components/Nav.astro";
import PageLayout from "@layouts/PageLayout.astro";
import { readingTime } from "@lib/utils";
import { type CollectionEntry, getCollection } from "astro:content";

export async function getStaticPaths() {
  const games = (await getCollection("games"))
    .filter((game) => !game.data.draft)
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  return games.map((game) => ({
    params: { slug: game.slug },
    props: game,
  }));
}
type Props = CollectionEntry<"games">;

const game = Astro.props;
const { Content } = await game.render();
---

<PageLayout title={game.data.title} description={game.data.description}>
  <Container>
    <div class="space-y-2">
      <Nav
        breadCrumbsItems={[
          { href: "/games", label: "Games" },
          { href: `/games/${game.slug}`, label: game.data.title },
        ]}
      />
    </div>
    <div class="space-y-4 my-10">
      <div class="flex items-center gap-1.5">
        <div class="font-base text-sm">
          <FormattedDate date={game.data.date} />
        </div>
        &bull;
        <div class="font-base text-sm">
          {readingTime(game.body)}
        </div>
        {game.data.difficulty && (
          <>
            &bull;
            <div class="font-base text-sm">
              {game.data.difficulty}
            </div>
          </>
        )}
      </div>
      {
        game.data.titleCorrection ? (
          <Correction
            text={game.data.titleCorrection}
            textClass="text-2xl -top-6"
          >
            <div class="text-2xl font-semibold font-serif text-black dark:text-white">
              {game.data.title}
            </div>
          </Correction>
        ) : (
          <div class="text-2xl font-semibold font-serif text-black dark:text-white">
            {game.data.title}
          </div>
        )
      }
    </div>
    <article>
      <Content />
    </article>
  </Container>
</PageLayout>