---
import AppellationBand from "@components/AppellationBand.astro";
import Container from "@components/Container.astro";
import Nav from "@components/Nav.astro";
import { GAMES } from "@consts";
import PageLayout from "@layouts/PageLayout.astro";

const staticGames = [
  {
    title: "Klondike Solitaire",
    description: "Classic Klondike Solitaire with Easy (1 card) and Hard (3 cards) difficulty modes.",
    href: "/games/solitaire",
    date: new Date("2025-08-13"),
    difficulty: "Easy/Hard",
    category: "Card Game"
  },
  {
    title: "Conway's Game of Life",
    description: "A mesmerizing cellular automaton where simple rules create complex, beautiful patterns.",
    href: "/games/game-of-life",
    date: new Date("2025-08-13"),
    difficulty: "Easy",
    category: "Simulation"
  },
  {
    title: "Minesweeper",
    description: "The classic logic puzzle. Reveal every safe square without detonating a mine.",
    href: "/games/minesweeper",
    date: new Date("2026-04-27"),
    difficulty: "Easy/Hard",
    category: "Logic"
  },
  {
    title: "Queens",
    description: "An infinite, procedurally-generated take on LinkedIn's Queens. Daily puzzle plus unlimited random boards.",
    href: "/games/queens",
    date: new Date("2026-04-28"),
    difficulty: "Easy/Medium/Hard",
    category: "Logic"
  },
  {
    title: "Tango",
    description: "An infinite, procedurally-generated take on LinkedIn's Tango. Balance suns and moons across a 6×6 grid with = and × edge constraints.",
    href: "/games/tango",
    date: new Date("2026-04-28"),
    difficulty: "Easy/Medium/Hard",
    category: "Logic"
  },
  {
    title: "Mini Sudoku",
    description: "A 6×6 Sudoku with 2×3 boxes — every row, column, and box gets the digits 1–6. Daily puzzle plus unlimited random boards.",
    href: "/games/sudoku",
    date: new Date("2026-04-28"),
    difficulty: "Easy/Medium/Hard",
    category: "Logic"
  },
  {
    title: "Zip",
    description: "An infinite, procedurally-generated take on LinkedIn's Zip. Draw one continuous path through every cell, hitting the numbers in order.",
    href: "/games/zip",
    date: new Date("2026-04-28"),
    difficulty: "Easy/Medium/Hard",
    category: "Logic"
  }
];
---

<PageLayout title={GAMES.TITLE} description={GAMES.DESCRIPTION}>
  <Container>
    <Nav breadCrumbsItems={[{ href: "/games", label: "Games" }]} />

    <div
      class="my-12 space-y-10"
      style="--section-accent: var(--accent-gold);"
    >
      <AppellationBand
        variant="gold"
        eyebrow="Games"
        subtitle="Simple, ad-free games made because grandma was tired of all the games having ads."
      />
      <h1 class="wordmark" style="font-size: clamp(3rem, 9vw, 7rem);">
        Games
      </h1>

      <ul class="flex flex-col gap-1">
        {
          staticGames.map((game) => (
            <li>
              <a
                href={game.href}
                data-testid="game-card"
                data-game={game.href.replace("/games/", "")}
                class="relative group block pt-3 pb-4 px-4 pr-12 transition-colors duration-300 ease-in-out hover:bg-[var(--color-bodega-paper-warm)] dark:hover:bg-flexoki-base-900"
              >
                <span
                  class="absolute left-0 top-0 h-[3px] w-full"
                  style="background-color: var(--section-accent);"
                  aria-hidden="true"
                />
                <div class="flex flex-col gap-2">
                  <div class="flex items-baseline justify-between gap-4">
                    <span class="eyebrow" style="color: var(--section-accent);">
                      {game.category}
                    </span>
                    <span class="font-serif italic text-sm text-flexoki-base-600 dark:text-flexoki-base-400">
                      {game.difficulty}
                    </span>
                  </div>
                  <div class="font-semibold font-serif text-lg leading-snug relative inline-block">
                    {game.title}
                    <span
                      class="absolute left-0 -bottom-0.5 w-full h-[1px] scale-x-0 group-hover:scale-x-100 origin-left transition-transform duration-300 ease-in-out"
                      style="background-color: var(--section-accent);"
                    />
                  </div>
                  <p class="text-sm text-flexoki-base-700 dark:text-flexoki-base-300 leading-relaxed">
                    {game.description}
                  </p>
                </div>
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  class="absolute top-1/2 right-3 -translate-y-1/2 size-5 stroke-2 fill-none stroke-current"
                >
                  <line
                    x1="5"
                    y1="12"
                    x2="19"
                    y2="12"
                    class="translate-x-3 group-hover:translate-x-0 scale-x-0 group-hover:scale-x-100 transition-transform duration-300 ease-in-out"
                  />
                  <polyline
                    points="12 5 19 12 12 19"
                    class="-translate-x-1 group-hover:translate-x-0 transition-transform duration-300 ease-in-out"
                  />
                </svg>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </Container>
</PageLayout>
