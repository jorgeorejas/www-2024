---
import Legend from "@components/margin/Legend.astro";
import ListRow from "@components/margin/ListRow.astro";
import MarginPage from "@components/margin/MarginPage.astro";
import Row from "@components/margin/Row.astro";
import { GAMES } from "@consts";
import { GAMES_LIST } from "@lib/games";
import { isNew } from "@lib/utils";

const games = GAMES_LIST.map((game) => ({
  ...game,
  slug: game.href.replace("/games/", ""),
  isNew: isNew(game.date)
}));
const anyNew = games.some((game) => game.isNew);
---

<MarginPage
  title={GAMES.TITLE}
  description={GAMES.DESCRIPTION}
  breadcrumbs={[{ href: "/games", label: GAMES.TITLE }]}
>
  <Row>
    <header class="grid gap-4">
      <h1 class="m-h1">{GAMES.TITLE}</h1>
      <p class="m-lede max-w-[52ch]">
        Juegos sencillos y sin anuncios. Los hice porque mi abuela estaba harta de que todos los juegos le metieran anuncios. Aquí se viene a jugar y punto.
      </p>
    </header>
  </Row>
  <Row label="juegos" as="section" aria-label="Todos los juegos">
    <ul class="m-list">
      {
        games.map((game) => (
          <ListRow
            href={game.href}
            title={game.title}
            value={game.category}
            description={`${game.difficulty} · ${game.description}`}
            isNew={game.isNew}
          >
            {/* Test hooks (tests/e2e/hub.spec.ts) ride on the title, inside the link */}
            <span slot="title" data-testid="game-card" data-game={game.slug}>{game.title}</span>
          </ListRow>
        ))
      }
    </ul>
    {anyNew && <Legend text="NUEVO últimos 60 días" />}
  </Row>
</MarginPage>
