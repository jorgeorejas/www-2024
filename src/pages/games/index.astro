---
import Legend from "@components/margin/Legend.astro";
import ListRow from "@components/margin/ListRow.astro";
import MarginPage from "@components/margin/MarginPage.astro";
import Row from "@components/margin/Row.astro";
import { GAMES } from "@consts";
import { isNew } from "@lib/utils";

const staticGames = [
  {
    title: "Klondike Solitaire",
    description: "Classic Klondike Solitaire with Easy (1 card) and Hard (3 cards) difficulty modes.",
    href: "/games/solitaire",
    date: new Date("2025-08-13"),
    difficulty: "Easy/Hard",
    category: "Card Game"
  },
  {
    title: "Conway's Game of Life",
    description: "A mesmerizing cellular automaton where simple rules create complex, beautiful patterns.",
    href: "/games/game-of-life",
    date: new Date("2025-08-13"),
    difficulty: "Easy",
    category: "Simulation"
  },
  {
    title: "Minesweeper",
    description: "The classic logic puzzle. Reveal every safe square without detonating a mine.",
    href: "/games/minesweeper",
    date: new Date("2026-04-27"),
    difficulty: "Easy/Hard",
    category: "Logic"
  },
  {
    title: "Queens",
    description: "An infinite, procedurally-generated take on LinkedIn's Queens. Daily puzzle plus unlimited random boards.",
    href: "/games/queens",
    date: new Date("2026-04-28"),
    difficulty: "Easy/Medium/Hard",
    category: "Logic"
  },
  {
    title: "Tango",
    description: "An infinite, procedurally-generated take on LinkedIn's Tango. Balance suns and moons across a 6×6 grid with = and × edge constraints.",
    href: "/games/tango",
    date: new Date("2026-04-28"),
    difficulty: "Easy/Medium/Hard",
    category: "Logic"
  },
  {
    title: "Mini Sudoku",
    description: "A 6×6 Sudoku with 2×3 boxes — every row, column, and box gets the digits 1–6. Daily puzzle plus unlimited random boards.",
    href: "/games/sudoku",
    date: new Date("2026-04-28"),
    difficulty: "Easy/Medium/Hard",
    category: "Logic"
  },
  {
    title: "Zip",
    description: "An infinite, procedurally-generated take on LinkedIn's Zip. Draw one continuous path through every cell, hitting the numbers in order.",
    href: "/games/zip",
    date: new Date("2026-04-28"),
    difficulty: "Easy/Medium/Hard",
    category: "Logic"
  }
];

const games = staticGames.map((game) => ({
  ...game,
  slug: game.href.replace("/games/", ""),
  isNew: isNew(game.date)
}));
const anyNew = games.some((game) => game.isNew);
---

<MarginPage
  title={GAMES.TITLE}
  description={GAMES.DESCRIPTION}
  breadcrumbs={[{ href: "/games", label: "Games" }]}
>
  <Row>
    <header class="grid gap-4">
      <h1 class="m-h1">Games</h1>
      <p class="m-lede max-w-[52ch]">
        Simple, ad-free games made because grandma was tired of all the games having ads. Just pure fun, no interruptions.
      </p>
    </header>
  </Row>
  <Row label="games" as="section" aria-label="All games">
    <ul class="m-list">
      {
        games.map((game) => (
          <ListRow
            href={game.href}
            title={game.title}
            value={game.category}
            description={`${game.difficulty} · ${game.description}`}
            isNew={game.isNew}
          >
            {/* Test hooks (tests/e2e/hub.spec.ts) ride on the title, inside the link */}
            <span slot="title" data-testid="game-card" data-game={game.slug}>{game.title}</span>
          </ListRow>
        ))
      }
    </ul>
    {anyNew && <Legend text="NEW last 60 days" />}
  </Row>
</MarginPage>
