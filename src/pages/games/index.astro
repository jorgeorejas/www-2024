---
import Container from "@components/Container.astro";
import Nav from "@components/Nav.astro";
import { GAMES } from "@consts";
import PageLayout from "@layouts/PageLayout.astro";

const staticGames = [
  {
    title: "Klondike Solitaire",
    description: "Classic Klondike Solitaire with Easy (1 card) and Hard (3 cards) difficulty modes.",
    href: "/games/solitaire",
    date: new Date("2025-08-13"),
    difficulty: "Easy/Hard",
    category: "Card Game"
  },
  {
    title: "Conway's Game of Life",
    description: "A mesmerizing cellular automaton where simple rules create complex, beautiful patterns.",
    href: "/games/game-of-life",
    date: new Date("2025-08-13"),
    difficulty: "Easy",
    category: "Simulation"
  },
  {
    title: "Minesweeper",
    description: "The classic logic puzzle. Reveal every safe square without detonating a mine.",
    href: "/games/minesweeper",
    date: new Date("2026-04-27"),
    difficulty: "Easy/Hard",
    category: "Logic"
  },
  {
    title: "Queens",
    description: "An infinite, procedurally-generated take on LinkedIn's Queens. Daily puzzle plus unlimited random boards.",
    href: "/games/queens",
    date: new Date("2026-04-28"),
    difficulty: "Easy/Medium/Hard",
    category: "Logic"
  },
  {
    title: "Tango",
    description: "An infinite, procedurally-generated take on LinkedIn's Tango. Balance suns and moons across a 6×6 grid with = and × edge constraints.",
    href: "/games/tango",
    date: new Date("2026-04-28"),
    difficulty: "Easy/Medium/Hard",
    category: "Logic"
  }
];
---

<PageLayout title={GAMES.TITLE} description={GAMES.DESCRIPTION}>
  <Container>
    <div class="space-y-2">
      <Nav breadCrumbsItems={[{ href: "/games", label: "Games" }]} />
    </div>
    <div class="space-y-10 my-10">
      <div class="space-y-4">
        <div class="font-semibold text-flexoki-ink dark:text-flexoki-base-50 font-serif">
          Games
        </div>
        <p class="text-sm text-flexoki-base-800 dark:text-flexoki-base-300 max-w-md">
          Simple, ad-free games made because grandma was tired of all the games having ads. Just pure fun, no interruptions.
        </p>
      </div>
      <ul class="flex flex-col gap-4">
        {
          staticGames.map((game) => (
            <li>
              <a
                href={game.href}
                class="relative group flex flex-nowrap py-3 px-4 pr-10 border-l border-flexoki-base-200 dark:border-flexoki-base-800 hover:bg-flexoki-base-100 dark:hover:bg-flexoki-base-900 hover:text-flexoki-ink dark:hover:text-flexoki-base-50 transition-colors duration-300 ease-in-out"
              >
                <div class="flex flex-col gap-2 flex-1">
                  <div class="flex md:gap-2 md:items-center flex-col md:flex-row">
                    <div class="font-semibold font-serif">{game.title}</div>
                    <div class="text-sm text-flexoki-base-500 dark:text-flexoki-base-500">
                      <span class="hidden md:inline"> - </span>
                      {game.difficulty} • {game.category}
                    </div>
                  </div>
                  <div class="text-sm">
                    {game.description}
                  </div>
                </div>
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  class="absolute top-1/2 right-2 -translate-y-1/2 size-5 stroke-2 fill-none stroke-current"
                >
                  <line
                    x1="5"
                    y1="12"
                    x2="19"
                    y2="12"
                    class="translate-x-3 group-hover:translate-x-0 scale-x-0 group-hover:scale-x-100 transition-transform duration-300 ease-in-out"
                  ></line>
                  <polyline
                    points="12 5 19 12 12 19"
                    class="-translate-x-1 group-hover:translate-x-0 transition-transform duration-300 ease-in-out"
                  ></polyline>
                </svg>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </Container>
</PageLayout>