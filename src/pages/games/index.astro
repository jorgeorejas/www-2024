---
import Legend from "@components/margin/Legend.astro";
import ListRow from "@components/margin/ListRow.astro";
import MarginPage from "@components/margin/MarginPage.astro";
import Row from "@components/margin/Row.astro";
import { GAMES } from "@consts";
import { isNew } from "@lib/utils";

const staticGames = [
  {
    title: "Solitario Klondike",
    description: "El solitario de toda la vida, con modo fácil (1 carta) y difícil (3 cartas).",
    href: "/games/solitaire",
    date: new Date("2025-08-13"),
    difficulty: "Fácil/Difícil",
    category: "Cartas"
  },
  {
    title: "El juego de la vida de Conway",
    description: "Un autómata celular hipnótico: con cuatro reglas muy simples salen patrones complejos y preciosos.",
    href: "/games/game-of-life",
    date: new Date("2025-08-13"),
    difficulty: "Fácil",
    category: "Simulación"
  },
  {
    title: "Buscaminas",
    description: "El clásico de lógica. Destapa todas las casillas sin pisar ninguna mina.",
    href: "/games/minesweeper",
    date: new Date("2026-04-27"),
    difficulty: "Fácil/Difícil",
    category: "Lógica"
  },
  {
    title: "Queens",
    description: "Mi versión infinita del Queens de LinkedIn, con tableros que se generan solos. Reto diario y partidas aleatorias sin límite.",
    href: "/games/queens",
    date: new Date("2026-04-28"),
    difficulty: "Fácil/Media/Difícil",
    category: "Lógica"
  },
  {
    title: "Tango",
    description: "Mi versión infinita del Tango de LinkedIn. Reparte soles y lunas en una cuadrícula de 6×6 respetando las marcas = y × entre casillas.",
    href: "/games/tango",
    date: new Date("2026-04-28"),
    difficulty: "Fácil/Media/Difícil",
    category: "Lógica"
  },
  {
    title: "Mini Sudoku",
    description: "Un sudoku de 6×6 con cajas de 2×3: cada fila, columna y caja lleva los números del 1 al 6. Reto diario y partidas aleatorias sin límite.",
    href: "/games/sudoku",
    date: new Date("2026-04-28"),
    difficulty: "Fácil/Media/Difícil",
    category: "Lógica"
  },
  {
    title: "Zip",
    description: "Mi versión infinita del Zip de LinkedIn. Dibuja un solo camino que pase por todas las casillas y por los números en orden.",
    href: "/games/zip",
    date: new Date("2026-04-28"),
    difficulty: "Fácil/Media/Difícil",
    category: "Lógica"
  }
];

const games = staticGames.map((game) => ({
  ...game,
  slug: game.href.replace("/games/", ""),
  isNew: isNew(game.date)
}));
const anyNew = games.some((game) => game.isNew);
---

<MarginPage
  title={GAMES.TITLE}
  description={GAMES.DESCRIPTION}
  breadcrumbs={[{ href: "/games", label: GAMES.TITLE }]}
>
  <Row>
    <header class="grid gap-4">
      <h1 class="m-h1">{GAMES.TITLE}</h1>
      <p class="m-lede max-w-[52ch]">
        Juegos sencillos y sin anuncios. Los hice porque mi abuela estaba harta de que todos los juegos le metieran anuncios. Aquí se viene a jugar y punto.
      </p>
    </header>
  </Row>
  <Row label="juegos" as="section" aria-label="Todos los juegos">
    <ul class="m-list">
      {
        games.map((game) => (
          <ListRow
            href={game.href}
            title={game.title}
            value={game.category}
            description={`${game.difficulty} · ${game.description}`}
            isNew={game.isNew}
          >
            {/* Test hooks (tests/e2e/hub.spec.ts) ride on the title, inside the link */}
            <span slot="title" data-testid="game-card" data-game={game.slug}>{game.title}</span>
          </ListRow>
        ))
      }
    </ul>
    {anyNew && <Legend text="NUEVO últimos 60 días" />}
  </Row>
</MarginPage>
