---
import TangoGame from "@components/games/linkedin/tango";
import MarginPage from "@components/margin/MarginPage.astro";
import Row from "@components/margin/Row.astro";
---

<MarginPage
  title="Tango"
  description="An infinite, procedurally-generated take on LinkedIn's Tango puzzle. Place suns and moons so every row and column has three of each — no triples, and watch the = / × edge constraints."
  breadcrumbs={[
    { href: "/games", label: "Games" },
    { href: "/games/tango", label: "Tango" },
  ]}
>
  <Row>
    <h1 class="m-h1 mb-10">Tango</h1>
    <TangoGame client:only="react" />
  </Row>
</MarginPage>
