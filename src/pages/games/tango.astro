---
import TangoGame from "@components/games/linkedin/tango";
import MarginPage from "@components/margin/MarginPage.astro";
import Row from "@components/margin/Row.astro";
---

<MarginPage
  title="Tango"
  description="Mi versión infinita del Tango de LinkedIn. Coloca soles y lunas para que cada fila y columna tenga tres de cada, sin tres iguales seguidos y respetando las marcas = y ×."
  breadcrumbs={[
    { href: "/games", label: "Juegos" },
    { href: "/games/tango", label: "Tango" },
  ]}
>
  <Row>
    <h1 class="m-h1 mb-10">Tango</h1>
    <TangoGame client:only="react" />
  </Row>
</MarginPage>
