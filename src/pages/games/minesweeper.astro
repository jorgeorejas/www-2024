---
import MinesweeperGame from "@components/games/Minesweeper.tsx";
import MarginPage from "@components/margin/MarginPage.astro";
import Row from "@components/margin/Row.astro";
---

<MarginPage
  title="Minesweeper"
  description="The classic logic puzzle. Beginner, Intermediate, and Expert boards. Right-click to flag."
  breadcrumbs={[
    { href: "/games", label: "Games" },
    { href: "/games/minesweeper", label: "Minesweeper" },
  ]}
>
  <Row>
    <header class="grid gap-4">
      <p class="m-date">Easy → Hard · Logic</p>
      <h1 class="m-h1">Minesweeper</h1>
      <p class="m-lede max-w-[52ch]">
        Reveal every safe cell without detonating a mine. Numbers tell you how
        many mines border that square. The first click is always safe.
      </p>
    </header>
    <section class="py-10">
      <MinesweeperGame client:only="react" />
    </section>
  </Row>
</MarginPage>
