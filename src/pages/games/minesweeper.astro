---
import MinesweeperGame from "@components/games/Minesweeper.tsx";
import MarginPage from "@components/margin/MarginPage.astro";
import Row from "@components/margin/Row.astro";
---

<MarginPage
  title="Buscaminas"
  description="El clásico de lógica, con tableros de principiante, intermedio y experto. Clic derecho para poner una bandera."
  breadcrumbs={[
    { href: "/games", label: "Juegos" },
    { href: "/games/minesweeper", label: "Buscaminas" },
  ]}
>
  <Row>
    <header class="grid gap-4">
      <p class="m-date">Fácil → Difícil · Lógica</p>
      <h1 class="m-h1">Buscaminas</h1>
      <p class="m-lede max-w-[52ch]">
        Destapa todas las casillas sin pisar ninguna mina. Cada número te dice
        cuántas minas tiene alrededor. El primer clic nunca es una mina.
      </p>
    </header>
    <section class="py-10">
      <MinesweeperGame client:only="react" />
    </section>
  </Row>
</MarginPage>
