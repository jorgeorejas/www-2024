---
import ZipGame from "@components/games/linkedin/zip";
import MarginPage from "@components/margin/MarginPage.astro";
import Row from "@components/margin/Row.astro";
---

<MarginPage
  title="Zip"
  description="An infinite, procedurally-generated take on LinkedIn's Zip puzzle. Trace one path through every cell, hitting the numbers in order."
  breadcrumbs={[
    { href: "/games", label: "Games" },
    { href: "/games/zip", label: "Zip" },
  ]}
>
  <Row>
    <h1 class="m-h1 mb-10">Zip</h1>
    <ZipGame client:only="react" />
  </Row>
</MarginPage>
