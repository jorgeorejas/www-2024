---
import SudokuGame from "@components/games/linkedin/sudoku";
import MarginPage from "@components/margin/MarginPage.astro";
import Row from "@components/margin/Row.astro";
---

<MarginPage
  title="Mini Sudoku"
  description="Mi versión infinita del Mini Sudoku de LinkedIn: una cuadrícula de 6×6 con cajas de 2×3. Reto diario y partidas aleatorias sin límite."
  breadcrumbs={[
    { href: "/games", label: "Juegos" },
    { href: "/games/sudoku", label: "Mini Sudoku" },
  ]}
>
  <Row>
    <h1 class="m-h1 mb-10">Mini Sudoku</h1>
    <SudokuGame client:only="react" />
  </Row>
</MarginPage>
