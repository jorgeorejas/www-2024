---
import Container from "@components/Container.astro";
import SolitaireGame from "@components/games/solitaire";
import Nav from "@components/Nav.astro";
import PageLayout from "@layouts/PageLayout.astro";
---

<PageLayout
  title="Klondike Solitaire"
  description="Classic Klondike Solitaire with Easy (1 card) and Hard (3 cards) difficulty modes."
>
  <Container>
    <div class="space-y-2">
      <Nav
        breadCrumbsItems={[
          { href: "/games", label: "Games" },
          { href: "/games/solitaire", label: "Solitaire" },
        ]}
      />
    </div>

    <div class="my-10">
      <div class="relative rounded-lg p-6 shadow-inner bg-[#0f5132] dark:bg-[#0a3a24] border border-[#0a3a24] dark:border-black/40">
        <div class="absolute inset-0 pointer-events-none pattern-grain text-white/10 rounded-lg"></div>
        <div class="relative">
          <SolitaireGame client:load />
        </div>
      </div>
    </div>
  </Container>
</PageLayout>
