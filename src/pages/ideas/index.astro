---
import Container from "@components/Container.astro";
import Nav from "@components/Nav.astro";
import PageLayout from "@layouts/PageLayout.astro";
import { getCollection } from "astro:content";

const ideas = (await getCollection("ideas"))
  .filter((idea) => !idea.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<PageLayout title="Ideas" description="Ideas in progress.">
  <Container>
    <div class="space-y-2">
      <Nav breadCrumbsItems={[{ href: "/ideas", label: "Ideas" }]} />
    </div>
    <div class="space-y-12 my-12">
      <div class="font-semibold text-black dark:text-white font-serif">Ideas in progress</div>
      {
        ideas.length > 0 ? (
          <ul class="flex flex-col gap-4">
            {ideas.map((idea) => (
              <li>
                <a href={`/ideas/${idea.slug}`} class="block py-2">
                  <span class="font-semibold font-serif">{idea.data.title}</span>
                  <span class="block text-sm text-neutral-600 dark:text-neutral-400">{idea.data.description}</span>
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <p class="text-sm text-neutral-600 dark:text-neutral-400">No public ideas yet.</p>
        )
      }
    </div>
  </Container>
</PageLayout>
