---
import { WISHLIST } from "@consts";
import { squareSelector } from "@components/margin/classes";
import { CARD_ARROW_SVG } from "@components/margin/hand-arrow";
import Legend from "@components/margin/Legend.astro";
import MarginPage from "@components/margin/MarginPage.astro";
import Markers from "@components/margin/Markers.astro";
import Row from "@components/margin/Row.astro";
import { cachePage } from "@lib/cache-headers";
import { getLiveCollection } from "astro:content";

// Read live from Notion; the CDN keeps the page and the Notion webhook purges
// it on edits. If Notion is down, the last good copy stays up for a week.
const { entries: liveEntries = [], error } = await getLiveCollection("wishlist");
cachePage(Astro.response, ["wishlist"], error);

const items = liveEntries.sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

// Column names in the Notion database
const CATEGORY = "Categoría";
const STATUS = "Estado";
const OWNED = "Lo tengo";
const PRICE_RANGE = "Rango de Precios";

const categoryOf = (fields: Record<string, string[]>) => fields[CATEGORY]?.[0];
const priceRangeOf = (fields: Record<string, string[]>) =>
  fields[PRICE_RANGE]?.[0];

const distinct = (values: (string | undefined)[]) =>
  [...new Set(values)].filter((v): v is string => !!v);

// "Menos de 20€" → 0, "20–50€" → 20, "+5000€" → 5000, "Sin precio" → last
const rangeFloor = (label: string) =>
  /^menos/i.test(label) ? 0 : Number(label.match(/\d+/)?.[0] ?? Infinity);

const rangeLabel = (range?: string) => range?.replace(/(\d)-(\d)/, "$1–$2");

const categories = distinct(items.map((i) => categoryOf(i.data.fields))).sort(
  (a, b) => a.localeCompare(b, "es"),
);
const priceRanges = distinct(items.map((i) => priceRangeOf(i.data.fields))).sort(
  (a, b) => rangeFloor(a) - rangeFloor(b),
);

// Every filter from production stays: category, price range and owned state.
// `label` only names the group for screen readers.
const filterGroups = [
  {
    name: "category",
    label: CATEGORY,
    options: categories.map((c) => ({ id: c, label: c })),
  },
  {
    name: "price",
    label: "Precio",
    options: priceRanges.map((r) => ({
      id: r,
      label: rangeLabel(r)!,
    })),
  },
  {
    name: "owned",
    label: STATUS,
    options: [
      { id: "no", label: "Lo quiero" },
      { id: "yes", label: "Ya lo tengo" },
    ],
  },
].filter((group) => group.options.length > 0);

// Titles come in as "Brand · Product"; split so the product never gets cut
const entries = items.map(({ id, data }) => {
  const [brand, ...rest] = data.title.split(" · ");
  const range = priceRangeOf(data.fields);
  const category = categoryOf(data.fields);
  return {
    id,
    brand: rest.length ? brand : undefined,
    name: rest.length ? rest.join(" · ") : data.title,
    url: data.url,
    image: data.image,
    range,
    category,
    owned: !!data.fields[STATUS]?.includes(OWNED),
    price: rangeLabel(range),
    meta: [rangeLabel(range), category].filter(Boolean).join(" · "),
  };
});

const hasOwned = entries.some((item) => item.owned);

const countLabel = (n: number) => `${n} ${n === 1 ? "cosa" : "cosas"}`;

const linkProps = (url?: string) =>
  url ? { href: url, target: "_blank", rel: "noopener noreferrer" } : {};

// Read by screen readers in place of the ◆ on owned items
const OWNED_LABEL = "ya lo tengo";
---

<MarginPage
  title={WISHLIST.TITLE}
  description={WISHLIST.DESCRIPTION}
  lang="es"
  breadcrumbs={[{ href: "/wishlist", label: WISHLIST.TITLE }]}
>
  <Row>
    <header class="grid gap-2.5">
      <h1 class="m-h1">{WISHLIST.TITLE}</h1>
      <p class="m-lede">{WISHLIST.DESCRIPTION}</p>
    </header>
  </Row>

  {
    filterGroups.length > 0 && (
      <Row label="filtros" as="section" aria-label="Filtros">
        <div class="text-meta" id="wishlist-filters">
          {filterGroups.map((group) => (
            <div
              class="flex flex-wrap gap-2"
              data-group={group.name}
              role="group"
              aria-label={group.label}
            >
              <button type="button" data-value="" aria-pressed="true" class={squareSelector}>
                Todo
              </button>
              {group.options.map((option) => (
                <button
                  type="button"
                  data-value={option.id}
                  aria-pressed="false"
                  class={squareSelector}
                >
                  {option.label}
                </button>
              ))}
            </div>
          ))}
        </div>
      </Row>
    )
  }

  <Row label="lista" as="section" aria-label={WISHLIST.TITLE}>
    {
      error ? (
        <p class="text-mute">
          Ahora mismo no se puede cargar la lista. Prueba de nuevo en un minuto.
        </p>
      ) : entries.length === 0 ? (
        <p class="text-mute">Todavía no hay nada por aquí.</p>
      ) : (
        <div class="space-y-(--g)">
          <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2 text-meta">
            <span class="text-mute" id="wishlist-count" aria-live="polite">
              {countLabel(entries.length)}
            </span>
            <div class="flex gap-2" id="wishlist-view" role="group" aria-label="Vista">
              <button type="button" data-view="grid" aria-pressed="true" class={squareSelector}>
                Cuadrícula
              </button>
              <button type="button" data-view="list" aria-pressed="false" class={squareSelector}>
                Lista
              </button>
            </div>
          </div>

          <ul
            class="grid grid-cols-2 gap-x-3.5 gap-y-(--g) mg:grid-cols-3 mg:gap-x-5"
            data-list="grid"
          >
            {entries.map((item) => {
              const Tag = item.url ? "a" : "div";
              return (
                <li
                  data-category={item.category ?? ""}
                  data-price={item.range ?? ""}
                  data-owned={item.owned ? "yes" : "no"}
                >
                  <Tag {...linkProps(item.url)} class="group @container grid content-start">
                    <span class="m-tile-img block aspect-square overflow-hidden bg-flexoki-base-50">
                      {item.image && (
                        <img
                          src={item.image}
                          alt=""
                          loading="lazy"
                          decoding="async"
                          class="size-full object-contain p-[12%] mix-blend-multiply transition-transform duration-500 ease-out group-hover:scale-105"
                        />
                      )}
                    </span>
                    <span class="grid min-w-0">
                      {item.brand && (
                        <span class="truncate text-mark uppercase tracking-[0.08em] text-mute">
                          {item.brand}
                        </span>
                      )}
                      <span class="line-clamp-2 font-serif text-title-4 leading-[1.15] text-flexoki-ink">
                        <Markers pick={item.owned} pickLabel={OWNED_LABEL} />
                        <span
                          class:list={[
                            "box-decoration-clone bg-size-[100%_6px] bg-bottom-left bg-no-repeat",
                            item.url &&
                              "group-hover:bg-(image:--m-pen-underline) group-focus-visible:bg-(image:--m-pen-underline)",
                          ]}
                        >
                          {item.name}
                        </span>
                      </span>
                      {item.meta && <span class="text-meta text-mute">{item.meta}</span>}
                    </span>
                  </Tag>
                </li>
              );
            })}
          </ul>

          <ul class="m-list grid-cols-1" data-list="list" hidden>
            {entries.map((item) => {
              const Tag = item.url ? "a" : "div";
              const sub = [item.brand, item.category].filter(Boolean).join(" · ");
              return (
                <li
                  data-category={item.category ?? ""}
                  data-price={item.range ?? ""}
                  data-owned={item.owned ? "yes" : "no"}
                >
                  <Tag
                    {...linkProps(item.url)}
                    data-sketch="left"
                    class:list={[
                      "m-card flex-row items-start gap-x-3 mg:gap-x-3.5",
                      !item.url && "hover:bg-transparent pr-4",
                    ]}
                  >
                    <span class="size-[54px] shrink-0 bg-flexoki-base-50">
                      {item.image && (
                        <img
                          src={item.image}
                          alt=""
                          width="54"
                          height="54"
                          loading="lazy"
                          decoding="async"
                          class="size-full object-contain p-1.5 mix-blend-multiply"
                        />
                      )}
                    </span>
                    <span class="flex min-w-0 flex-1 flex-col">
                      <span class="m-card-t">
                        <span class="m-card-title wrap-anywhere">
                          <Markers pick={item.owned} pickLabel={OWNED_LABEL} />
                          <span class="m-card-text">{item.name}</span>
                        </span>
                        {item.price && (
                          <>
                            <span class="m-lead" data-sketch="under" aria-hidden="true" />
                            <span class="m-val">{item.price}</span>
                          </>
                        )}
                      </span>
                      {sub && <span class="m-card-d text-mute">{sub}</span>}
                    </span>
                    {item.url && (
                      <span class="m-arrow" aria-hidden="true" set:html={CARD_ARROW_SVG} />
                    )}
                  </Tag>
                </li>
              );
            })}
          </ul>

          {hasOwned && <Legend text={`◆ ${OWNED_LABEL}`} />}
        </div>
      )
    }
  </Row>
</MarginPage>

<script>
  const groups = [...document.querySelectorAll("#wishlist-filters [data-group]")]
    .filter((el) => el instanceof HTMLElement);
  const cards = [...document.querySelectorAll("[data-list] > li")].filter(
    (el) => el instanceof HTMLElement,
  );
  const count = document.getElementById("wishlist-count");
  const active = new Map(groups.map((g) => [g.dataset.group ?? "", ""]));

  const matches = (card: HTMLElement, skip?: string) =>
    [...active].every(
      ([name, value]) => name === skip || !value || card.dataset[name] === value,
    );

  // Faceted filters: each option only shows if picking it would leave results
  // given what's selected in the other groups
  const update = () => {
    cards.forEach((card) => (card.hidden = !matches(card)));
    if (count) {
      const shown = document.querySelectorAll("[data-list=grid] > li:not([hidden])");
      count.textContent = `${shown.length} ${shown.length === 1 ? "cosa" : "cosas"}`;
    }
    groups.forEach((group) => {
      const name = group.dataset.group ?? "";
      const pool = cards.filter((card) => matches(card, name));
      group.querySelectorAll("button").forEach((button) => {
        const value = button.dataset.value;
        button.hidden =
          !!value &&
          active.get(name) !== value &&
          !pool.some((card) => card.dataset[name] === value);
      });
    });
  };

  groups.forEach((group) => {
    const buttons = [...group.querySelectorAll("button")];
    buttons.forEach((button) => {
      button.addEventListener("click", () => {
        active.set(group.dataset.group ?? "", button.dataset.value ?? "");
        buttons.forEach((b) =>
          b.setAttribute("aria-pressed", String(b === button)),
        );
        update();
      });
    });
  });

  // Grid / list switch, remembered per browser
  const VIEW_KEY = "wishlist-view";
  const viewButtons = [...document.querySelectorAll("#wishlist-view [data-view]")]
    .filter((el) => el instanceof HTMLElement);
  const lists = [...document.querySelectorAll("[data-list]")]
    .filter((el) => el instanceof HTMLElement);

  const setView = (view: string) => {
    lists.forEach((list) => (list.hidden = list.dataset.list !== view));
    viewButtons.forEach((b) =>
      b.setAttribute("aria-pressed", String(b.dataset.view === view)),
    );
    try {
      localStorage.setItem(VIEW_KEY, view);
    } catch {
      // storage blocked: the switch still works for this visit
    }
  };

  viewButtons.forEach((button) =>
    button.addEventListener("click", () => setView(button.dataset.view ?? "grid")),
  );
  try {
    const saved = localStorage.getItem(VIEW_KEY);
    if (saved === "list") setView(saved);
  } catch {
    // ignore
  }
</script>
