---
import RecipeCard from "@components/cocina/RecipeCard.astro";
import Legend from "@components/margin/Legend.astro";
import MarginPage from "@components/margin/MarginPage.astro";
import Row from "@components/margin/Row.astro";
import { cachePage, isNotFound, notionUnavailable } from "@lib/cache-headers";
import { isNew } from "@lib/utils";
import { getLiveCollection, getLiveEntry } from "astro:content";

const slug = Astro.params.slug ?? "";
const [{ entry: tag, error }, { entries: recipes = [], error: recipesError }] = await Promise.all([
  getLiveEntry("recipeTags", { id: slug }),
  getLiveCollection("recipes"),
]);
if (recipesError) return notionUnavailable(recipesError);
if (error && !isNotFound(error)) return notionUnavailable(error);
if (!tag) return Astro.rewrite("/404");
cachePage(Astro.response, ["recipes"]);

const tagged = recipes.filter((r) => r.data.tags.some((t) => t.slug === slug));
const title = `Recetas: ${tag.data.name}`;
const legend = [
  tagged.some((r) => r.data.pick) && "◆ la favorita",
  tagged.some((r) => isNew(r.data.date)) && "NUEVA últimos 60 días",
]
  .filter(Boolean)
  .join(" · ");
---

<MarginPage
  title={title}
  description={tag.data.description ?? title}
  lang="es"
  breadcrumbs={[
    { href: "/cocina", label: "Cocina" },
    { href: `/cocina/etiqueta/${slug}`, label: tag.data.name },
  ]}
>
  <Row>
    <header class="grid gap-2.5">
      {tag.data.emoji && <p class="m-0 text-[40px] leading-none" aria-hidden="true">{tag.data.emoji}</p>}
      <h1 class="m-h1">{tag.data.name}</h1>
      {tag.data.description && <p class="m-lede">{tag.data.description}</p>}
      <p class="m-date">
        {tagged.length}
        {tagged.length === 1 ? "receta" : "recetas"} ·
        <a class="m-all" href="/cocina">ver todas</a>
      </p>
    </header>
  </Row>

  <Row label="recetas">
    {
      tagged.length ? (
        <ul class="m-0 grid list-none grid-cols-2 gap-x-3.5 gap-y-6 p-0 lg:grid-cols-3 lg:gap-x-[22px] lg:gap-y-8">
          {tagged.map((recipe) => (
            <li>
              <RecipeCard recipe={recipe} headingLevel="h2" />
            </li>
          ))}
        </ul>
      ) : (
        <p class="font-mono text-xs text-mute">Todavía no hay recetas con esta etiqueta.</p>
      )
    }
    {legend && <Legend text={legend} class="mt-8" />}
  </Row>
</MarginPage>
