---
import { AnimatedSignature } from "@components/AnimatedSignature";
import Legend from "@components/margin/Legend.astro";
import ListRow from "@components/margin/ListRow.astro";
import MarginNote from "@components/margin/MarginNote.astro";
import MarginPage from "@components/margin/MarginPage.astro";
import Row from "@components/margin/Row.astro";
import SectionHead from "@components/margin/SectionHead.astro";
import { SITE } from "@consts";
import { cachePage, isNotFound, notionUnavailable } from "@lib/cache-headers";
import { formatMinutes, imageSrcset, isoDuration, servingsLabel, totalMinutes } from "@lib/cocina";
import { generateBreadcrumbSchema } from "@lib/seo-utils";
import { isNew } from "@lib/utils";
import { getLiveCollection, getLiveEntry } from "astro:content";

const slug = Astro.params.slug ?? "";
const { entry: recipe, error } = await getLiveEntry("recipes", { id: slug });
if (error && !isNotFound(error)) return notionUnavailable(error);
if (!recipe?.data.body) return Astro.rewrite("/404");

const { data } = recipe;
const body = data.body!;
const servings = data.servings ?? body.servingsHint;
const image = data.image;
const hasIngredients = body.ingredients.trim().length > 0;
const hasSteps = body.steps.trim().length > 0;

// Two more recipes that share a tag, for the end of the page
const { entries: all = [], error: listError } = await getLiveCollection("recipes");
cachePage(Astro.response, ["recipes", `recipes:${recipe.id}`], listError);
const tagSlugs = new Set(data.tags.map((t) => t.slug));
const related = all
  .filter((r) => r.id !== recipe.id && !r.data.draft)
  .sort(
    (a, b) =>
      b.data.tags.filter((t) => tagSlugs.has(t.slug)).length -
      a.data.tags.filter((t) => tagSlugs.has(t.slug)).length,
  )
  .slice(0, 2);
const relatedLegend = [
  related.some((r) => r.data.pick) && "◆ la favorita",
  related.some((r) => isNew(r.data.date)) && "NUEVA últimos 60 días",
]
  .filter(Boolean)
  .join(" · ");

const facts = [
  { label: "Preparación", value: formatMinutes(data.prepMinutes) },
  { label: "Cocción", value: formatMinutes(data.cookMinutes) },
  { label: "Total", value: data.prepMinutes && data.cookMinutes ? formatMinutes(totalMinutes(data)) : undefined },
  { label: "Dificultad", value: data.difficulty },
].filter((f) => f.value);

const site = Astro.site!.toString();
const recipeSchema = {
  "@context": "https://schema.org",
  "@type": "Recipe",
  name: data.title,
  description: data.description,
  image: image ? new URL(image, site).href : undefined,
  author: { "@type": "Person", name: SITE.AUTHOR_NAME, url: site },
  datePublished: data.date.toISOString(),
  recipeYield: servings ? servingsLabel(servings) : undefined,
  prepTime: isoDuration(data.prepMinutes),
  cookTime: isoDuration(data.cookMinutes),
  totalTime: isoDuration(totalMinutes(data)),
  keywords: data.tags.map((t) => t.name).join(", ") || undefined,
  recipeIngredient: body.ingredientLines,
  recipeInstructions: body.stepLines.map((text) => ({ "@type": "HowToStep", text })),
  inLanguage: "es",
};
const breadcrumbSchema = generateBreadcrumbSchema(
  [
    { href: "/", label: "Inicio" },
    { href: "/cocina", label: "Cocina" },
    { href: `/cocina/${recipe.id}`, label: data.title },
  ],
  site,
);

// Square tool buttons, like the selectors elsewhere on the site
const button =
  "inline-flex items-center justify-center gap-1.5 min-w-[30px] px-2.5 py-1 border border-flexoki-base-300 font-mono text-[12.5px] text-flexoki-ink hover:border-flexoki-ink transition-colors aria-pressed:bg-flexoki-ink aria-pressed:text-flexoki-paper aria-pressed:border-flexoki-ink";
---

<MarginPage
  title={data.title}
  description={data.description ?? `Receta de ${data.title}`}
  ogImage={image}
  type="article"
  publishedTime={data.date}
  structuredData={[recipeSchema, breadcrumbSchema]}
  lang="es"
  breadcrumbs={[
    { href: "/cocina", label: "Cocina" },
    { href: `/cocina/${recipe.id}`, label: data.title },
  ]}
>
  <Row>
    <MarginNote slot="margin" text={data.note} />

    <div id="recipe" class="m-article" data-slug={recipe.id} data-servings={servings ?? ""}>
      <h1 class="m-h1">{data.title}</h1>
      {data.description && <p class="m-lede">{data.description}</p>}

      {
        image && (
          <figure class="@container m-0 overflow-hidden rounded-[2px] bg-flexoki-base-50">
            <img
              src={image}
              srcset={imageSrcset(image)}
              sizes="(min-width: 1024px) 728px, 100vw"
              alt={data.title}
              class="m-photo block aspect-[16/10] w-full object-cover [--ratio:16/10]"
              fetchpriority="high"
            />
          </figure>
        )
      }

      {
        (facts.length > 0 || data.tags.length > 0) && (
          // Each cell is two rows (label, value). The rules are 1px shadows
          // around the cells, not borders, so they take no room and sit on
          // the rows of dots.
          <dl class="m-0 mx-px flex flex-wrap">
            {facts.map((fact) => (
              <div class="min-w-0 flex-[1_1_140px] bg-flexoki-paper px-[11px] py-0 shadow-[0_0_0_1px_var(--color-rule)]">
                <dt class="font-mono text-[10.5px] tracking-[0.07em] text-mute uppercase">{fact.label}</dt>
                <dd class="m-0 text-[14px] text-flexoki-ink">{fact.value}</dd>
              </div>
            ))}
            {data.tags.length > 0 && (
              <div class="min-w-0 flex-[2_1_200px] bg-flexoki-paper px-[11px] py-0 shadow-[0_0_0_1px_var(--color-rule)]">
                <dt class="font-mono text-[10.5px] tracking-[0.07em] text-mute uppercase">Etiquetas</dt>
                <dd class="m-0 text-[14px]">
                  <ul class="m-0 flex list-none flex-wrap gap-x-3 gap-y-0 p-0">
                    {data.tags.map((tag) => (
                      <li>
                        <a href={`/cocina/etiqueta/${tag.slug}`} class="text-flexoki-ink hover:pen-underline">
                          {tag.emoji && <span aria-hidden="true">{tag.emoji} </span>}
                          {tag.name}
                        </a>
                      </li>
                    ))}
                  </ul>
                </dd>
              </div>
            )}
          </dl>
        )
      }

      {body.intro && <div class="recipe-intro m-prose" set:html={body.intro} />}

      {/* 1px border + 12.5px padding = half a row around the buttons, and half
          a row of margin outside, so the buttons sit on a row of dots */}
      <div
        id="recipe-tools"
        class="sticky top-0 z-10 my-(--g-half) flex flex-wrap items-center gap-2 border-y border-rule bg-flexoki-paper/90 py-[12.5px] backdrop-blur-xs"
      >
        {
          hasIngredients && (
            <div class="flex items-center gap-1" role="group" aria-label="Raciones">
              <button type="button" class={button} data-scale="-1" aria-label="Menos raciones">
                −
              </button>
              <output id="servings-label" class="min-w-24 text-center text-[13px] text-flexoki-ink tabular-nums" aria-live="polite">
                {servings ? servingsLabel(servings) : "×1"}
              </output>
              <button type="button" class={button} data-scale="1" aria-label="Más raciones">
                +
              </button>
            </div>
          )
        }
        <button type="button" class={button} id="cook-mode" aria-pressed="false">
          <svg viewBox="0 0 24 24" class="size-3.5 fill-none stroke-current stroke-2" aria-hidden="true"
            ><path d="M12 3v2M12 19v2M4.2 4.2l1.4 1.4M18.4 18.4l1.4 1.4M3 12h2M19 12h2M4.2 19.8l1.4-1.4M18.4 5.6l1.4-1.4"
            ></path><circle cx="12" cy="12" r="4"></circle></svg
          >
          Modo cocina
        </button>
        {
          hasIngredients && (
            <button type="button" class={button} id="copy-list">
              Copiar ingredientes
            </button>
          )
        }
        <span id="tools-status" class="w-full font-mono text-[11px] text-mute sm:w-auto" aria-live="polite"></span>
      </div>

      {
        (hasIngredients || hasSteps) && (
          <div
            class:list={[
              "grid gap-x-10 gap-y-[54px]",
              hasIngredients && hasSteps && "lg:grid-cols-[minmax(0,2fr)_minmax(0,3fr)]",
            ]}
          >
            {hasIngredients && (
              <section aria-labelledby="ingredientes">
                <div class="m-sec-h">
                  <h2 id="ingredientes">Ingredientes</h2>
                  <button
                    type="button"
                    id="reset-ingredients"
                    class="font-mono text-[11px] text-mute hover:text-flexoki-ink hover:pen-underline"
                    hidden
                  >
                    Desmarcar
                  </button>
                </div>
                <div class="recipe-ingredients" set:html={body.ingredients} />
              </section>
            )}

            {hasSteps && (
              <section aria-labelledby="preparacion">
                <div class="m-sec-h">
                  <h2 id="preparacion">Preparación</h2>
                </div>
                <p class="m-0 font-mono text-[11px] text-mute">Toca un paso para tacharlo.</p>
                <div class="recipe-steps m-prose" set:html={body.steps} />
              </section>
            )}
          </div>
        )
      }

      {body.extra && <div class="recipe-extra m-prose mt-(--g)" set:html={body.extra} />}

      {
        body.gallery && (
          <section class="mt-(--g)" aria-labelledby="fotos">
            <div class="m-sec-h">
              <h2 id="fotos">Fotos</h2>
            </div>
            <div class="recipe-gallery" set:html={body.gallery} />
          </section>
        )
      }

      <div class="mt-(--g) flex flex-col items-start">
        <p class="hn m-0 h-(--g) -rotate-2 text-2xl">¡Que aproveche!</p>
        <AnimatedSignature client:visible tone="pen" className="h-[54px] w-33" aria-hidden="true" />
      </div>
    </div>
  </Row>

  {
    related.length > 0 && (
      <Row label="más" as="aside" aria-labelledby="mas-recetas">
        <SectionHead id="mas-recetas" title="Si te gustó, prueba estas" href="/cocina" linkLabel="Ver todas las recetas" />
        <ul class="m-list">
          {related.map((r) => (
            <ListRow
              href={`/cocina/${r.id}`}
              title={r.data.title}
              value={formatMinutes(totalMinutes(r.data))}
              description={r.data.description}
              pick={r.data.pick}
              pickLabel="la favorita"
              isNew={isNew(r.data.date)}
            />
          ))}
        </ul>
        {relatedLegend && <Legend text={relatedLegend} />}
      </Row>
    )
  }
</MarginPage>

<style is:global>
  /* ---------- ingredients: dashed rows, mono quantities, pen ticks ----------
     One row of the dot grid per line; the dashed rule is a background on the
     row's bottom edge, so it takes no room. */
  .recipe-ingredients ul.ingredients {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .recipe-ingredients h3.ingredient-group {
    margin: var(--g) 0 0;
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: 19px;
    line-height: var(--g);
    color: var(--color-flexoki-ink);
  }
  .recipe-ingredients h3.ingredient-group:first-child {
    margin-top: 0;
  }
  .recipe-ingredients li.ingredient {
    padding: 0;
    background: linear-gradient(to right, var(--color-rule) 50%, transparent 0) left bottom / 6px 1px repeat-x;
    font-size: 14px;
  }
  .recipe-ingredients li.ingredient label {
    display: flex;
    gap: 0.7rem;
    align-items: flex-start;
    cursor: pointer;
    line-height: var(--g);
  }
  .recipe-ingredients li.ingredient input {
    appearance: none;
    flex: none;
    width: 0.95rem;
    height: 0.95rem;
    margin: calc((var(--g) - 0.95rem) / 2) 0 0;
    border: 1px solid var(--color-flexoki-base-400);
    display: grid;
    place-content: center;
    cursor: pointer;
  }
  .recipe-ingredients li.ingredient input::before {
    content: "✓";
    font-family: var(--font-handwritten);
    font-size: 1.35rem;
    line-height: 1;
    color: var(--color-pen);
    transform: translate(1px, -3px) rotate(-8deg) scale(0);
    transition: transform 150ms ease-out;
  }
  .recipe-ingredients li.ingredient input:checked::before {
    transform: translate(1px, -3px) rotate(-8deg) scale(1);
  }
  .recipe-ingredients li.ingredient input:checked + span {
    color: var(--color-flexoki-base-400);
    text-decoration: line-through;
    text-decoration-color: var(--color-pen);
  }
  .recipe-ingredients .qty {
    font-family: var(--font-mono);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--color-flexoki-ink);
  }
  .recipe-ingredients .qty.is-scaled {
    color: var(--color-pen);
  }
  .recipe-ingredients li.ingredient input:checked + span .qty {
    color: inherit;
  }

  /* ---------- numbered lists: orange 01, 02… (steps, and any list in the body) ---------- */
  #recipe .m-prose ol {
    padding-left: 2.6em;
    list-style: decimal-leading-zero;
  }
  #recipe .m-prose ol > li::marker {
    content: counter(list-item, decimal-leading-zero) "\00a0\00a0";
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-signal-ink);
  }
  /* one empty row between steps */
  #recipe .m-prose ol > li + li {
    margin-top: var(--g);
  }
  .recipe-steps ol > li {
    cursor: pointer;
    transition: color 150ms ease;
  }
  .recipe-steps ol > li.done {
    color: var(--color-flexoki-base-400);
  }
  #recipe .recipe-steps ol > li.done::marker {
    content: "✓\00a0\00a0";
    font-family: var(--font-handwritten);
    font-size: 1.25em;
    color: var(--color-pen);
  }
  .recipe-steps ol > li.done :where(strong, b, p, a) {
    color: inherit;
  }

  /* ---------- tips and other lists after the recipe: – markers ---------- */
  #recipe :is(.recipe-intro, .recipe-extra) ul:not(.contains-task-list) {
    padding-left: 1.5em;
  }
  #recipe :is(.recipe-intro, .recipe-extra) ul:not(.contains-task-list) > li::marker {
    content: "–\00a0";
    color: var(--color-mute);
  }
  #recipe .m-prose .contains-task-list {
    padding-left: 0;
    list-style: none;
  }
  #recipe .m-prose .task-list-item::marker {
    content: none;
  }
  /* section titles inside the Notion body read like the recipe's own sections */
  #recipe :is(.recipe-intro, .recipe-extra) :where(h1, h2) {
    font-size: 26px;
  }
  #recipe :is(.recipe-intro, .recipe-extra) h3 {
    font-size: 21px;
  }

  /* ---------- gallery ----------
     Half-row gaps, and photos (nearly square) that end half a row short of a
     row of dots, so every photo starts on a row; the half row of padding at
     the end puts what follows back on the grid. */
  .recipe-gallery,
  .recipe-gallery .notion-columns {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--g-half);
  }
  .recipe-gallery {
    container-type: inline-size;
    padding-bottom: var(--g-half);
  }
  .recipe-gallery img {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    margin: 0;
    border-radius: 2px;
    background: var(--color-flexoki-base-50);
  }
  @supports (height: round(nearest, 1px, 1px)) {
    /* a column is (100cqi - gap) / 2 wide; round (that + half a row) to rows */
    .recipe-gallery img {
      aspect-ratio: auto;
      height: calc(round(nearest, calc((100cqi + var(--g-half)) / 2), var(--g)) - var(--g-half));
    }
  }
  .recipe-gallery figure {
    margin: 0;
  }
  .recipe-gallery .notion-columns {
    grid-column: 1 / -1;
  }

  /* ---------- cook mode: bigger steps, the next one stands out ---------- */
  [data-cooking] .recipe-steps {
    font-size: 1.15rem;
  }
  [data-cooking] .recipe-steps ol > li.current {
    background: var(--color-flexoki-base-50);
    outline: 1px solid var(--color-rule);
    outline-offset: 0.5rem;
  }
  @media (prefers-reduced-motion: reduce) {
    .recipe-ingredients li.ingredient input::before,
    .recipe-steps ol > li {
      transition: none;
    }
  }
</style>

<script>
  const root = document.getElementById("recipe");
  if (root) {
    const slug = root.dataset.slug ?? "";
    const base = Number(root.dataset.servings) || 0;
    const store = (key: string) => `cocina:${slug}:${key}`;
    const read = <T,>(key: string, fallback: T): T => {
      try {
        const raw = localStorage.getItem(store(key));
        return raw ? (JSON.parse(raw) as T) : fallback;
      } catch {
        return fallback;
      }
    };
    const write = (key: string, value: unknown) => {
      try {
        localStorage.setItem(store(key), JSON.stringify(value));
      } catch {
        // Storage blocked: everything still works for this visit
      }
    };
    const status = document.getElementById("tools-status");
    const say = (text: string) => {
      if (status) status.textContent = text;
    };

    // --- Servings scaler -------------------------------------------------
    const quantities = [...root.querySelectorAll<HTMLElement>(".qty")];
    const label = document.getElementById("servings-label");
    let servings = base;
    let factor = 1;

    const FRACTIONS: [number, string][] = [
      [0.125, "⅛"], [0.25, "¼"], [1 / 3, "⅓"], [0.5, "½"], [2 / 3, "⅔"], [0.75, "¾"],
    ];
    const format = (value: number) => {
      const whole = Math.floor(value + 1e-6);
      const rest = value - whole;
      if (rest < 0.04) return String(whole);
      const fraction = FRACTIONS.find(([f]) => Math.abs(f - rest) < 0.04);
      if (fraction && value < 10) return `${whole || ""}${fraction[1]}`;
      return value.toLocaleString("es-ES", { maximumFractionDigits: value < 10 ? 1 : 0 });
    };

    const applyScale = () => {
      factor = base ? servings / base : factor;
      for (const qty of quantities) {
        const value = Number(qty.dataset.qty) * factor;
        qty.textContent = format(value);
        qty.classList.toggle("is-scaled", factor !== 1);
      }
      if (label) {
        label.textContent = base
          ? `${servings} ${servings === 1 ? "ración" : "raciones"}`
          : `×${factor.toLocaleString("es-ES")}`;
      }
    };

    root.querySelectorAll<HTMLButtonElement>("[data-scale]").forEach((button) =>
      button.addEventListener("click", () => {
        const step = Number(button.dataset.scale);
        if (base) servings = Math.max(1, servings + step);
        else factor = Math.max(0.5, factor + step * 0.5);
        applyScale();
      }),
    );

    // --- Ingredient checklist, remembered per recipe --------------------
    const boxes = [...root.querySelectorAll<HTMLInputElement>(".ingredient input")];
    const reset = document.getElementById("reset-ingredients");
    const checked = new Set(read("checked", [] as number[]));
    const syncReset = () => {
      if (reset) reset.hidden = !boxes.some((b) => b.checked);
    };
    boxes.forEach((box, i) => {
      box.checked = checked.has(i);
      box.addEventListener("change", () => {
        if (box.checked) checked.add(i);
        else checked.delete(i);
        write("checked", [...checked]);
        syncReset();
      });
    });
    reset?.addEventListener("click", () => {
      boxes.forEach((b) => (b.checked = false));
      checked.clear();
      write("checked", []);
      syncReset();
    });
    syncReset();

    // --- Steps: tap to cross off; in cook mode the next one stands out ---
    const steps = [...root.querySelectorAll<HTMLLIElement>(".recipe-steps ol > li")];
    const done = new Set(read("done", [] as number[]));
    const markCurrent = () => {
      const next = steps.findIndex((s) => !s.classList.contains("done"));
      steps.forEach((s, i) => s.classList.toggle("current", i === next));
    };
    steps.forEach((step, i) => {
      step.classList.toggle("done", done.has(i));
      step.addEventListener("click", (event) => {
        if ((event.target as HTMLElement).closest("a")) return;
        step.classList.toggle("done");
        if (step.classList.contains("done")) done.add(i);
        else done.delete(i);
        write("done", [...done]);
        markCurrent();
      });
    });
    markCurrent();

    // --- Cook mode: keep the screen on ------------------------------------
    const cookButton = document.getElementById("cook-mode");
    let lock: { release: () => Promise<void> } | null = null;
    const requestLock = async () => {
      try {
        const wakeLock = (navigator as Navigator & { wakeLock?: { request: (t: "screen") => Promise<{ release: () => Promise<void> }> } }).wakeLock;
        lock = (await wakeLock?.request("screen")) ?? null;
        say(lock ? "La pantalla no se apagará mientras cocinas." : "Tu navegador no deja mantener la pantalla encendida.");
      } catch {
        say("Tu navegador no deja mantener la pantalla encendida.");
      }
    };
    cookButton?.addEventListener("click", async () => {
      const on = cookButton.getAttribute("aria-pressed") !== "true";
      cookButton.setAttribute("aria-pressed", String(on));
      root.toggleAttribute("data-cooking", on);
      if (on) await requestLock();
      else {
        await lock?.release().catch(() => {});
        lock = null;
        say("");
      }
    });
    // The lock drops when the tab is hidden; take it again on return
    document.addEventListener("visibilitychange", () => {
      if (document.visibilityState === "visible" && root.hasAttribute("data-cooking")) requestLock();
    });

    // --- Copy the shopping list, with the current quantities -------------
    document.getElementById("copy-list")?.addEventListener("click", async () => {
      const title = document.querySelector("h1")?.textContent?.trim() ?? "";
      const lines = [...root.querySelectorAll<HTMLElement>(".recipe-ingredients h3, .recipe-ingredients li")].map(
        (el) => (el.tagName === "H3" ? `\n${el.textContent?.trim()}` : `- ${el.textContent?.trim()}`),
      );
      const text = `${title}${label ? ` (${label.textContent})` : ""}\n${lines.join("\n")}`.trim();
      try {
        await navigator.clipboard.writeText(text);
        say("Lista copiada. Pégala donde quieras.");
      } catch {
        say("No pude copiar la lista.");
      }
    });
  }
</script>
