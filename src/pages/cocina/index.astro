---
import Container from "@components/Container.astro";
import Nav from "@components/Nav.astro";
import RecipeCard from "@components/cocina/RecipeCard.astro";
import { COCINA } from "@consts";
import PageLayout from "@layouts/PageLayout.astro";
import { cachePage } from "@lib/cache-headers";
import { formatMinutes, imageSrcset, servingsLabel, totalMinutes } from "@lib/cocina";
import { getLiveCollection } from "astro:content";

// Recipes and their tags, live from the Notion "Recetas" and "Etiquetas" databases
const [{ entries: recipes = [], error }, { entries: tags = [] }] = await Promise.all([
  getLiveCollection("recipes"),
  getLiveCollection("recipeTags"),
]);
cachePage(Astro.response, ["recipes"], error);

// "Destacada" in Notion picks the hero; the grid below still lists every recipe
const featured = recipes.find((r) => r.data.featured && !r.data.draft) ?? recipes[0];

// Only tags that have at least one recipe here
const used = new Set(recipes.flatMap((r) => r.data.tags.map((t) => t.slug)));
const tagOptions = tags.filter((t) => used.has(t.id));

const chip =
  "px-2 py-0.5 border border-flexoki-base-200 text-sm aria-pressed:bg-flexoki-ink aria-pressed:text-flexoki-paper aria-pressed:border-flexoki-ink hover:border-flexoki-base-500 transition-colors";
---

<PageLayout title={COCINA.TITLE} description={COCINA.DESCRIPTION} lang="es">
  <Container>
    <Nav lang="es" breadCrumbsItems={[{ href: "/cocina", label: "Cocina" }]} />

    <div class="relative my-12 space-y-3">
      <span class="absolute -top-7 left-40 sm:left-64 font-handwritten text-2xl text-blue-800 -rotate-6 whitespace-nowrap">
        recetas de casa
      </span>
      <h1 class="font-serif text-4xl sm:text-5xl text-flexoki-ink">{COCINA.TITLE}</h1>
      <p class="max-w-prose">{COCINA.DESCRIPTION}</p>
    </div>

    {
      featured && (
        <a href={`/cocina/${featured.id}`} class="group grid sm:grid-cols-5 gap-5 items-center mb-16">
          <div class="sm:col-span-3 aspect-[4/3] overflow-hidden bg-flexoki-base-100">
            {featured.data.image && (
              <img
                src={featured.data.image}
                srcset={imageSrcset(featured.data.image)}
                sizes="(min-width: 640px) 460px, 100vw"
                alt=""
                class="size-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.03]"
              />
            )}
          </div>
          <div class="sm:col-span-2 space-y-2">
            <span class="font-handwritten text-xl text-blue-800 inline-block -rotate-3">la favorita</span>
            <h2 class="font-serif text-3xl leading-tight text-flexoki-ink group-hover:underline decoration-1 underline-offset-4">
              {featured.data.title}
            </h2>
            {featured.data.description && <p>{featured.data.description}</p>}
            <p class="text-xs text-flexoki-base-500">
              {[
                formatMinutes(totalMinutes(featured.data)),
                featured.data.servings && servingsLabel(featured.data.servings),
                featured.data.difficulty?.toLowerCase(),
              ]
                .filter(Boolean)
                .join(" · ")}
            </p>
          </div>
        </a>
      )
    }

    <section class="space-y-6" aria-labelledby="todas">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <h2 id="todas" class="font-serif text-2xl text-flexoki-ink">
          Todas las recetas <span id="recipe-count" class="text-base text-flexoki-base-500">({recipes.length})</span>
        </h2>
        <label class="flex items-center gap-2 text-sm border-b border-flexoki-base-300 focus-within:border-flexoki-ink">
          <span class="sr-only">Buscar receta</span>
          <svg viewBox="0 0 24 24" class="size-4 fill-none stroke-current stroke-2" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
          <input id="recipe-search" type="search" placeholder="Buscar…" class="bg-transparent py-1 outline-none w-40" />
        </label>
      </div>

      {
        tagOptions.length > 0 && (
          <div id="recipe-tags" class="flex flex-wrap gap-2" role="group" aria-label="Filtrar por etiqueta">
            <button type="button" class={chip} data-tag="" aria-pressed="true">Todas</button>
            {tagOptions.map((tag) => (
              <button type="button" class={chip} data-tag={tag.id} aria-pressed="false">
                {tag.data.emoji && <span aria-hidden="true">{tag.data.emoji} </span>}
                {tag.data.name}
              </button>
            ))}
          </div>
        )
      }

      <ul id="recipe-grid" class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-10">
        {
          recipes.map((recipe) => (
            <li>
              <RecipeCard recipe={recipe} />
            </li>
          ))
        }
      </ul>
      <p id="recipe-empty" class="text-flexoki-base-500" hidden>Ninguna receta coincide. Prueba con otra palabra.</p>
    </section>
  </Container>
</PageLayout>

<script>
  // Search box + tag chips, both client-side over the cards already on the page
  const search = document.getElementById("recipe-search") as HTMLInputElement | null;
  const chips = [...document.querySelectorAll<HTMLButtonElement>("#recipe-tags [data-tag]")];
  const items = [...document.querySelectorAll<HTMLLIElement>("#recipe-grid > li")];
  const count = document.getElementById("recipe-count");
  const empty = document.getElementById("recipe-empty");
  let tag = "";

  const normalize = (value: string) =>
    value.normalize("NFD").replace(/[̀-ͯ]/g, "").toLowerCase();

  const update = () => {
    const query = normalize(search?.value ?? "");
    let shown = 0;
    for (const item of items) {
      const card = item.querySelector<HTMLElement>("[data-recipe]");
      const matchesTag = !tag || (card?.dataset.tags ?? "").split(" ").includes(tag);
      const matchesText = !query || normalize(card?.textContent ?? "").includes(query);
      item.hidden = !(matchesTag && matchesText);
      if (!item.hidden) shown++;
    }
    if (count) count.textContent = `(${shown})`;
    if (empty) empty.hidden = shown > 0 || items.length === 0;
  };

  search?.addEventListener("input", update);
  chips.forEach((chip) =>
    chip.addEventListener("click", () => {
      tag = chip.dataset.tag ?? "";
      chips.forEach((c) => c.setAttribute("aria-pressed", String(c === chip)));
      update();
    }),
  );
</script>
