---
import RecipeCard from "@components/cocina/RecipeCard.astro";
import Legend from "@components/margin/Legend.astro";
import MarginNote from "@components/margin/MarginNote.astro";
import MarginPage from "@components/margin/MarginPage.astro";
import Row from "@components/margin/Row.astro";
import { squareSelector } from "@components/margin/classes";
import { COCINA } from "@consts";
import { cachePage } from "@lib/cache-headers";
import { formatMinutes, imageSrcset, servingsLabel, totalMinutes } from "@lib/cocina";
import { isNew } from "@lib/utils";
import { getLiveCollection } from "astro:content";

// Recipes and their tags, live from the Notion "Recetas" and "Etiquetas" databases
const [{ entries: recipes = [], error }, { entries: tags = [] }] = await Promise.all([
  getLiveCollection("recipes"),
  getLiveCollection("recipeTags"),
]);
cachePage(Astro.response, ["recipes"], error);

// "Destacada" in Notion picks the hero; the grid below still lists every recipe
const featured = recipes.find((r) => r.data.featured && !r.data.draft) ?? recipes[0];

// Only tags that have at least one recipe here
const used = new Set(recipes.flatMap((r) => r.data.tags.map((t) => t.slug)));
const tagOptions = tags.filter((t) => used.has(t.id));

// Key for the markers, only for the ones that actually appear in the grid
const legend = [
  recipes.some((r) => r.data.pick) && "◆ la favorita",
  recipes.some((r) => isNew(r.data.date)) && "NUEVA últimos 60 días",
]
  .filter(Boolean)
  .join(" · ");
---

<MarginPage
  title={COCINA.TITLE}
  description={COCINA.DESCRIPTION}
  lang="es"
  breadcrumbs={[{ href: "/cocina", label: "Cocina" }]}
>
  <Row>
    <header class="mb-[30px] grid gap-2.5">
      <p class="m-eyebrow">recetas de casa</p>
      <h1 class="m-h1">{COCINA.TITLE}</h1>
      <p class="m-lede">{COCINA.DESCRIPTION}</p>
    </header>

    {
      featured && (
        <div class="m-anchor">
          <MarginNote placement="item" text={featured.data.note} />
          {/* The left rule and the hover wash are drawn half a row above and
              below the card without taking room, so the photo and the text
              start on a row of dots. The photo takes whole rows (.m-photo);
              on phones it ends half a row short, for the half-row gap, and
              the note above gets a row to itself. */}
          <a
            href={`/cocina/${featured.id}`}
            class:list={[
              "group relative grid items-start gap-x-[22px] gap-y-(--g-half) py-0 pr-3.5 pl-[15px] before:absolute before:inset-x-0 before:-inset-y-(--g-half) before:-z-1 before:border-l before:border-rule before:transition-colors before:duration-300 hover:before:bg-flexoki-base-100 mg:grid-cols-[minmax(0,1fr)_minmax(0,1.1fr)]",
              featured.data.note?.trim() && "max-mg:mt-(--g)",
            ]}
          >
            <span class="@container block overflow-hidden bg-flexoki-base-50">
              {featured.data.image ? (
                <img
                  src={featured.data.image}
                  srcset={imageSrcset(featured.data.image)}
                  sizes="(min-width: 761px) 330px, 100vw"
                  alt=""
                  fetchpriority="high"
                  class="m-photo block aspect-square w-full object-cover max-mg:[--trim:var(--g-half)] motion-safe:transition-transform motion-safe:duration-500 motion-safe:ease-out motion-safe:group-hover:scale-[1.03]"
                />
              ) : (
                <span class="m-photo block aspect-square max-mg:[--trim:var(--g-half)]" />
              )}
            </span>
            <span class="grid gap-0">
              <span class="font-handwritten text-[22px] leading-none font-bold text-signal-ink">la favorita</span>
              <h2 class="m-0 font-serif text-[clamp(26px,4vw,36px)] leading-[1.04] font-normal text-flexoki-ink text-balance">
                <span class="group-hover:pen-underline group-focus-visible:pen-underline">{featured.data.title}</span>
              </h2>
              {featured.data.description && (
                <span class="text-[14px] leading-[1.7] text-ink-soft">{featured.data.description}</span>
              )}
              <span class="font-mono text-[11.5px] text-mute">
                {[
                  formatMinutes(totalMinutes(featured.data)),
                  featured.data.servings && servingsLabel(featured.data.servings),
                  featured.data.difficulty?.toLowerCase(),
                ]
                  .filter(Boolean)
                  .join(" · ")}
              </span>
            </span>
          </a>
        </div>
      )
    }
  </Row>

  <Row label="recetas" as="section" aria-labelledby="todas">
    <div class="m-sec-h">
      <h2 id="todas">
        Todas las recetas <span id="recipe-count" class="font-mono text-[12.5px] text-mute">({recipes.length})</span>
      </h2>
      <label
        class="flex items-center gap-2 border-b border-flexoki-base-300 text-[12.5px] text-ink-soft transition-colors focus-within:border-flexoki-ink"
      >
        <span class="sr-only">Buscar receta</span>
        <svg viewBox="0 0 24 24" class="size-3.5 fill-none stroke-current stroke-2" aria-hidden="true"
          ><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg
        >
        <input
          id="recipe-search"
          type="search"
          placeholder="Buscar…"
          class="h-[26px] w-40 bg-transparent py-0 font-mono outline-none placeholder:text-mute"
        />
      </label>
    </div>

    {
      tagOptions.length > 0 && (
        <div id="recipe-tags" class="mb-(--g) flex flex-wrap gap-2" role="group" aria-label="Filtrar por etiqueta">
          <button type="button" class:list={[squareSelector, "text-sm"]} data-tag="" aria-pressed="true">
            Todas
          </button>
          {tagOptions.map((tag) => (
            <button type="button" class:list={[squareSelector, "text-sm"]} data-tag={tag.id} aria-pressed="false">
              {tag.data.emoji && <span aria-hidden="true">{tag.data.emoji} </span>}
              {tag.data.name}
            </button>
          ))}
        </div>
      )
    }

    <ul id="recipe-grid" class="m-0 grid list-none grid-cols-2 gap-x-3.5 gap-y-(--g) p-0 lg:grid-cols-3 lg:gap-x-[22px]">
      {
        recipes.map((recipe) => (
          <li>
            <RecipeCard recipe={recipe} />
          </li>
        ))
      }
    </ul>
    <p id="recipe-empty" class="m-0 font-mono text-xs text-mute" hidden>
      Ninguna receta coincide. Prueba con otra palabra.
    </p>
    {legend && <Legend text={legend} />}
  </Row>
</MarginPage>

<script>
  // Search box + tag selectors, both client-side over the cards already on the page
  const search = document.getElementById("recipe-search") as HTMLInputElement | null;
  const chips = [...document.querySelectorAll<HTMLButtonElement>("#recipe-tags [data-tag]")];
  const items = [...document.querySelectorAll<HTMLLIElement>("#recipe-grid > li")];
  const count = document.getElementById("recipe-count");
  const empty = document.getElementById("recipe-empty");
  let tag = "";

  const normalize = (value: string) => value.normalize("NFD").replace(/[̀-ͯ]/g, "").toLowerCase();

  const update = () => {
    const query = normalize(search?.value ?? "");
    let shown = 0;
    for (const item of items) {
      const card = item.querySelector<HTMLElement>("[data-recipe]");
      const matchesTag = !tag || (card?.dataset.tags ?? "").split(" ").includes(tag);
      const matchesText = !query || normalize(card?.textContent ?? "").includes(query);
      item.hidden = !(matchesTag && matchesText);
      if (!item.hidden) shown++;
    }
    if (count) count.textContent = `(${shown})`;
    if (empty) empty.hidden = shown > 0 || items.length === 0;
  };

  search?.addEventListener("input", update);
  chips.forEach((chip) =>
    chip.addEventListener("click", () => {
      tag = chip.dataset.tag ?? "";
      chips.forEach((c) => c.setAttribute("aria-pressed", String(c === chip)));
      update();
    }),
  );
</script>
