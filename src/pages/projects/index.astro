---
import ArrowCard from "@components/ArrowCard.astro";
import Container from "@components/Container.astro";
import Nav from "@components/Nav.astro";
import { PROJECTS } from "@consts";
import PageLayout from "@layouts/PageLayout.astro";
import { cachePage } from "@lib/cache-headers";
import { getLiveCollection } from "astro:content";

const { entries: projects = [], error } = await getLiveCollection("projects");
cachePage(Astro.response, ["projects"], error);
---

<PageLayout title={PROJECTS.TITLE} description={PROJECTS.DESCRIPTION}>
  <Container>
    <div class="space-y-2">
      <Nav breadCrumbsItems={[{ href: "/projects", label: "Projects" }]} />
    </div>
    <div class="space-y-12 my-12">
      <h1 class="text-3xl font-semibold text-flexoki-ink dark:text-flexoki-base-50 font-serif">
        Projects
      </h1>
      <ul class="flex flex-col gap-4">
        {
          projects.map((project) => (
            <li>
              <ArrowCard entry={project} collection="projects" />
            </li>
          ))
        }
      </ul>
    </div>
  </Container>
</PageLayout>
