---
import AppellationBand from "@components/AppellationBand.astro";
import ArrowCard from "@components/ArrowCard.astro";
import Container from "@components/Container.astro";
import Nav from "@components/Nav.astro";
import { PROJECTS } from "@consts";
import PageLayout from "@layouts/PageLayout.astro";
import { getCollection } from "astro:content";

const projects = (await getCollection("projects"))
  .filter((project) => !project.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<PageLayout title={PROJECTS.TITLE} description={PROJECTS.DESCRIPTION}>
  <Container>
    <Nav breadCrumbsItems={[{ href: "/projects", label: "Projects" }]} />

    <div
      class="my-12 space-y-12"
      style="--section-accent: var(--accent-sage);"
    >
      <AppellationBand
        variant="sage"
        eyebrow="Projects"
        subtitle="Selected work, side experiments, things I've shipped."
      />
      <h1 class="wordmark" style="font-size: clamp(3rem, 9vw, 7rem);">
        Projects
      </h1>

      <ul class="flex flex-col gap-1">
        {
          projects.map((project) => (
            <li>
              <ArrowCard entry={project} variant="sage" />
            </li>
          ))
        }
      </ul>
    </div>
  </Container>
</PageLayout>
