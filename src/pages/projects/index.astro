---
import Legend from "@components/margin/Legend.astro";
import ListRow from "@components/margin/ListRow.astro";
import MarginPage from "@components/margin/MarginPage.astro";
import Row from "@components/margin/Row.astro";
import { PROJECTS } from "@consts";
import { cachePage } from "@lib/cache-headers";
import { formatYear, isNew } from "@lib/utils";
import { getLiveCollection } from "astro:content";

// Projects from Notion, newest first (drafts only show locally)
const { entries: projects = [], error } = await getLiveCollection("projects");
cachePage(Astro.response, ["projects"], error);

// The key under the list only names the markers it actually shows
const hasPick = projects.some((p) => p.data.pick);
const hasNew = projects.some((p) => isNew(p.data.date));
const legend =
  hasPick && hasNew
    ? "◆ mi favorito · NUEVO últimos 60 días"
    : hasPick
      ? "◆ mi favorito"
      : hasNew
        ? "NUEVO últimos 60 días"
        : undefined;
---

<MarginPage
  title={PROJECTS.TITLE}
  description={PROJECTS.DESCRIPTION}
  breadcrumbs={[{ href: "/projects", label: PROJECTS.TITLE }]}
>
  <Row label="proyectos">
    <header class="grid gap-3">
      <h1 class="m-h1">{PROJECTS.TITLE}</h1>
      <p class="m-lede">{PROJECTS.DESCRIPTION}</p>
    </header>
    <ul class="m-list mt-[54px]">
      {
        projects.map((project) => (
          <ListRow
            href={`/projects/${project.id}`}
            title={project.data.title}
            titleCorrection={project.data.titleCorrection}
            value={formatYear(project.data.date)}
            description={project.data.description}
            pick={project.data.pick}
            isNew={isNew(project.data.date)}
            note={project.data.note}
          />
        ))
      }
    </ul>
    {legend && <Legend text={legend} />}
  </Row>
</MarginPage>
