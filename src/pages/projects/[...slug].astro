---
import FormattedDate from "@components/FormattedDate.astro";
import { AnimatedSignature } from "@components/AnimatedSignature";
import ListRow from "@components/margin/ListRow.astro";
import MarginNote from "@components/margin/MarginNote.astro";
import MarginPage from "@components/margin/MarginPage.astro";
import Row from "@components/margin/Row.astro";
import SectionHead from "@components/margin/SectionHead.astro";
import { cachePage, isNotFound, notionUnavailable } from "@lib/cache-headers";
import { imageSrcset } from "@lib/notion/images";
import { generateProjectSchema, generateBreadcrumbSchema } from "@lib/seo-utils";
import { formatYear, isNew } from "@lib/utils";
import { getLiveCollection, getLiveEntry } from "astro:content";

const slug = Astro.params.slug ?? "";
const { entry: project, error } = await getLiveEntry("projects", { id: slug });
if (error && !isNotFound(error)) return notionUnavailable(error);
if (!project) return Astro.rewrite("/404");

// Notion relations: earlier/later versions and posts about the project
const [{ entries: allProjects = [], error: projectsError }, { entries: posts = [], error: blogError }] =
  await Promise.all([
    getLiveCollection("projects"),
    project.data.articles.length
      ? getLiveCollection("blog")
      : Promise.resolve({ entries: [], error: undefined }),
  ]);
cachePage(Astro.response, ["projects", `projects:${project.id}`, "blog"], projectsError ?? blogError);
const previous = allProjects.find((p) => p.id === project.data.previous);
const next = allProjects.find((p) => p.id === project.data.next);
const articles = posts.filter((p) => project.data.articles.includes(p.id));
const others = allProjects.filter((p) => p.id !== project.id).slice(0, 3);

const { demoURL, repoURL, image } = project.data;

/** "example.com/path" for a link, without protocol, www or trailing slash */
function shortUrl(url: string, withPath = true): string {
  try {
    const u = new URL(url);
    const host = u.host.replace(/^www\./, "");
    return withPath ? `${host}${u.pathname}`.replace(/\/$/, "") : host;
  } catch {
    return url;
  }
}

const crumbs = [
  { href: "/projects", label: "Projects" },
  { href: `/projects/${project.id}`, label: project.data.title },
];

// Generate structured data for SEO
const projectSchema = generateProjectSchema(project, Astro.site!.toString());
const breadcrumbSchema = generateBreadcrumbSchema(
  [{ href: "/", label: "Home" }, ...crumbs],
  Astro.site!.toString(),
);
---

<MarginPage
  title={project.data.title}
  description={project.data.description}
  structuredData={[projectSchema, breadcrumbSchema]}
  breadcrumbs={crumbs}
>
  <Row>
    <MarginNote slot="margin" text={project.data.note} />
    <article class="m-article">
      <header class="grid gap-3">
        <h1 class="m-h1">
          {
            project.data.titleCorrection ? (
              <span class="m-corr">
                <s>{project.data.title}</s>
                <span class="m-corr-new">{project.data.titleCorrection}</span>
              </span>
            ) : (
              project.data.title
            )
          }
        </h1>
        {project.data.description && <p class="m-lede">{project.data.description}</p>}
      </header>

      {
        image && (
          <figure class="m-0">
            <img
              class="block w-full h-auto rounded-[2px]"
              src={image}
              srcset={imageSrcset(image)}
              sizes="(max-width: 760px) 100vw, 728px"
              alt={project.data.title}
              loading="eager"
              decoding="async"
            />
          </figure>
        )
      }

      <dl class="m-meta" data-sketch>
        <div>
          <dt>Date</dt>
          <dd><FormattedDate date={project.data.date} /></dd>
        </div>
        {
          project.data.readingTime && (
            <div>
              <dt>Reading time</dt>
              <dd>{project.data.readingTime}</dd>
            </div>
          )
        }
        {
          demoURL && (
            <div>
              <dt>Demo</dt>
              <dd>
                <a href={demoURL} target="_blank" rel="noopener noreferrer">
                  {shortUrl(demoURL, false)}
                  <span class="m-meta-x" aria-hidden="true">↗</span>
                </a>
              </dd>
            </div>
          )
        }
        {
          repoURL && (
            <div>
              <dt>Repo</dt>
              <dd>
                <a href={repoURL} target="_blank" rel="noopener noreferrer">
                  {shortUrl(repoURL)}
                  <span class="m-meta-x" aria-hidden="true">↗</span>
                </a>
              </dd>
            </div>
          )
        }
        {
          previous && (
            <div>
              <dt>Previous version</dt>
              <dd>
                <a href={`/projects/${previous.id}`}>← {previous.data.titleCorrection ?? previous.data.title}</a>
              </dd>
            </div>
          )
        }
        {
          next && (
            <div>
              <dt>Next version</dt>
              <dd>
                <a href={`/projects/${next.id}`}>{next.data.titleCorrection ?? next.data.title} →</a>
              </dd>
            </div>
          )
        }
      </dl>

      <div class="m-prose">
        <Fragment set:html={project.rendered?.html} />
      </div>

      {
        demoURL && (
          <p class="m-0">
            <a class="m-all" href={demoURL} target="_blank" rel="noopener noreferrer">
              Visit {shortUrl(demoURL, false)} ↗
            </a>
          </p>
        )
      }

      <AnimatedSignature client:visible tone="pen" className="w-33 mt-6" />
    </article>
  </Row>

  {
    articles.length > 0 && (
      <Row as="aside" label="writing" aria-labelledby="written-about-it">
        <SectionHead id="written-about-it" title="Written about it" />
        <ul class="m-list">
          {articles.map((post) => (
            <ListRow
              href={`/blog/${post.id}`}
              title={post.data.title}
              titleCorrection={post.data.titleCorrection}
              date={post.data.date}
              description={post.data.description}
              pick={post.data.pick}
              isNew={isNew(post.data.date)}
            />
          ))}
        </ul>
      </Row>
    )
  }

  {
    others.length > 0 && (
      <Row as="aside" label="more" aria-labelledby="other-projects">
        <SectionHead id="other-projects" title="Other projects" href="/projects" linkLabel="See all projects" />
        <ul class="m-more-list">
          {others.map((p) => (
            <li>
              <a class="m-more-i" href={`/projects/${p.id}`}>
                <span class="m-more-t">
                  {p.data.titleCorrection ? (
                    <span class="m-corr">
                      <s>{p.data.title}</s>
                      <span class="m-corr-new">{p.data.titleCorrection}</span>
                    </span>
                  ) : (
                    p.data.title
                  )}
                </span>
                <span class="m-more-s">{formatYear(p.data.date)}</span>
              </a>
            </li>
          ))}
        </ul>
      </Row>
    )
  }
</MarginPage>

<script>
  import { sketchRules } from "@lib/sketch-rules";
  document.addEventListener("astro:page-load", sketchRules);
</script>
