---
import Container from "@components/Container.astro";
import Correction from "@components/Correction.astro";
import FormattedDate from "@components/FormattedDate.astro";
import Link from "@components/Link.astro";
import Nav from "@components/Nav.astro";
import PageLayout from "@layouts/PageLayout.astro";
import { cachePage, isNotFound, notionUnavailable } from "@lib/cache-headers";
import { generateProjectSchema, generateBreadcrumbSchema } from "@lib/seo-utils";
import { getLiveCollection, getLiveEntry } from "astro:content";

const slug = Astro.params.slug ?? "";
const { entry: project, error } = await getLiveEntry("projects", { id: slug });
if (error && !isNotFound(error)) return notionUnavailable(error);
if (!project) return Astro.rewrite("/404");

// Notion relations: earlier/later versions and posts about the project
const [{ entries: allProjects = [], error: projectsError }, { entries: posts = [], error: blogError }] =
  await Promise.all([
    getLiveCollection("projects"),
    project.data.articles.length
      ? getLiveCollection("blog")
      : Promise.resolve({ entries: [], error: undefined }),
  ]);
cachePage(Astro.response, ["projects", `projects:${project.id}`, "blog"], projectsError ?? blogError);
const previous = allProjects.find((p) => p.id === project.data.previous);
const next = allProjects.find((p) => p.id === project.data.next);
const articles = posts.filter((p) => project.data.articles.includes(p.id));

// Generate structured data for SEO
const projectSchema = generateProjectSchema(project, Astro.site!.toString());
const breadcrumbSchema = generateBreadcrumbSchema(
  [
    { href: "/", label: "Home" },
    { href: "/projects", label: "Projects" },
    { href: `/projects/${project.id}`, label: project.data.title },
  ],
  Astro.site!.toString()
);
---

<PageLayout
  title={project.data.title}
  description={project.data.description}
  structuredData={[projectSchema, breadcrumbSchema]}
>
  <Container>
    <div class="space-y-2">
      <Nav
        breadCrumbsItems={[
          { href: "/projects", label: "Projects" },
          { href: `/projects/${project.id}`, label: project.data.title },
        ]}
      />
    </div>
    <div class="space-y-4 my-10">
      <div class="flex items-center gap-1.5">
        <div class="font-base text-sm">
          <FormattedDate date={project.data.date} />
        </div>
        &bull;
        <div class="font-base text-sm">
          {project.data.readingTime}
        </div>
      </div>
      {
        project.data.titleCorrection ? (
          <Correction
            text={project.data.titleCorrection}
            textClass="text-2xl -top-6"
          >
            <div class="text-2xl font-semibold font-serif text-flexoki-ink dark:text-flexoki-base-50">
              {project.data.title}
            </div>
          </Correction>
        ) : (
          <div class="text-2xl font-semibold font-serif text-flexoki-ink dark:text-flexoki-base-50">
            {project.data.title}
          </div>
        )
      }
      {
        (project.data.demoURL || project.data.repoURL) && (
          <nav class=" flex gap-1">
            {project.data.demoURL && (
              <Link href={project.data.demoURL} external>
                visit
              </Link>
            )}
            {project.data.demoURL && project.data.repoURL && <span>/</span>}
            {project.data.repoURL && (
              <Link href={project.data.repoURL} external>
                repo
              </Link>
            )}
          </nav>
        )
      }
    </div>
    <article>
      <Fragment set:html={project.rendered?.html} />
    </article>

    {
      (previous || next || articles.length > 0) && (
        <aside class="mt-12 space-y-6 border-t border-flexoki-base-200 pt-6">
          {articles.length > 0 && (
            <div class="space-y-2">
              <h2 class="text-lg font-semibold font-serif">Written about it</h2>
              <ul class="flex flex-col gap-1">
                {articles.map((post) => (
                  <li>
                    <a class="underline decoration-flexoki-base-300 underline-offset-4 hover:decoration-current" href={`/blog/${post.id}`}>
                      {post.data.title}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}
          {(previous || next) && (
            <nav class="flex flex-wrap justify-between gap-4 text-sm">
              {previous && (
                <a class="group" href={`/projects/${previous.id}`}>
                  <span class="block text-flexoki-base-500">Previous version</span>
                  <span class="font-serif text-base group-hover:underline">← {previous.data.titleCorrection ?? previous.data.title}</span>
                </a>
              )}
              {next && (
                <a class="group text-right ml-auto" href={`/projects/${next.id}`}>
                  <span class="block text-flexoki-base-500">Next version</span>
                  <span class="font-serif text-base group-hover:underline">{next.data.titleCorrection ?? next.data.title} →</span>
                </a>
              )}
            </nav>
          )}
        </aside>
      )
    }
  </Container>
</PageLayout>
