---
import Container from "@components/Container.astro";
import Correction from "@components/Correction.astro";
import FormattedDate from "@components/FormattedDate.astro";
import Link from "@components/Link.astro";
import Nav from "@components/Nav.astro";
import PageLayout from "@layouts/PageLayout.astro";
import { readingTime } from "@lib/utils";
import { generateProjectSchema, generateBreadcrumbSchema } from "@lib/seo-utils";
import { type CollectionEntry, getCollection } from "astro:content";

export const prerender = true;

export async function getStaticPaths() {
  const projects = (await getCollection("projects"))
    .filter((project: CollectionEntry<"projects">) => !project.data.draft)
    .sort(
      (a: CollectionEntry<"projects">, b: CollectionEntry<"projects">) =>
        b.data.date.valueOf() - a.data.date.valueOf(),
    );
  return projects.map((project: CollectionEntry<"projects">) => ({
    params: { slug: project.slug },
    props: project,
  }));
}
type Props = CollectionEntry<"projects">;

const project = Astro.props;
const { Content } = await project.render();

// Generate structured data for SEO
const projectSchema = generateProjectSchema(project, Astro.site!.toString());
const breadcrumbSchema = generateBreadcrumbSchema(
  [
    { href: "/", label: "Home" },
    { href: "/projects", label: "Projects" },
    { href: `/projects/${project.slug}`, label: project.data.title },
  ],
  Astro.site!.toString()
);
---

<PageLayout
  title={project.data.title}
  description={project.data.description}
  structuredData={[projectSchema, breadcrumbSchema]}
>
  <Container>
    <div class="space-y-2">
      <Nav
        breadCrumbsItems={[
          { href: "/projects", label: "Projects" },
          { href: `/projects/${project.slug}`, label: project.data.title },
        ]}
      />
    </div>
    <div class="space-y-4 my-10">
      <div class="flex items-center gap-1.5">
        <div class="font-base text-sm">
          <FormattedDate date={project.data.date} />
        </div>
        &bull;
        <div class="font-base text-sm">
          {readingTime(project.body)}
        </div>
      </div>
      {
        project.data.titleCorrection ? (
          <Correction
            text={project.data.titleCorrection}
            textClass="text-2xl -top-6"
          >
            <div class="text-2xl font-semibold font-serif text-black dark:text-white">
              {project.data.title}
            </div>
          </Correction>
        ) : (
          <div class="text-2xl font-semibold font-serif text-black dark:text-white">
            {project.data.title}
          </div>
        )
      }
      {
        (project.data.demoURL || project.data.repoURL) && (
          <nav class=" flex gap-1">
            {project.data.demoURL && (
              <Link href={project.data.demoURL} external>
                visit
              </Link>
            )}
            {project.data.demoURL && project.data.repoURL && <span>/</span>}
            {project.data.repoURL && (
              <Link href={project.data.repoURL} external>
                repo
              </Link>
            )}
          </nav>
        )
      }
    </div>
    <article>
      <Content />
    </article>
  </Container>
</PageLayout>
