---
import Container from "@components/Container.astro";
import Correction from "@components/Correction.astro";
import FormattedDate from "@components/FormattedDate.astro";
import Link from "@components/Link.astro";
import Nav from "@components/Nav.astro";
import PageLayout from "@layouts/PageLayout.astro";
import { readingTime } from "@lib/utils";
import { generateProjectSchema, generateBreadcrumbSchema } from "@lib/seo-utils";
import { type CollectionEntry, getCollection } from "astro:content";

export const prerender = true;

export async function getStaticPaths() {
  const projects = (await getCollection("projects"))
    .filter((project: CollectionEntry<"projects">) => !project.data.draft)
    .sort(
      (a: CollectionEntry<"projects">, b: CollectionEntry<"projects">) =>
        b.data.date.valueOf() - a.data.date.valueOf(),
    );
  return projects.map((project: CollectionEntry<"projects">) => ({
    params: { slug: project.slug },
    props: project,
  }));
}
type Props = CollectionEntry<"projects">;

const project = Astro.props;
const { Content } = await project.render();

// Generate structured data for SEO
const projectSchema = generateProjectSchema(project, Astro.site!.toString());
const breadcrumbSchema = generateBreadcrumbSchema(
  [
    { href: "/", label: "Home" },
    { href: "/projects", label: "Projects" },
    { href: `/projects/${project.slug}`, label: project.data.title },
  ],
  Astro.site!.toString()
);
---

<PageLayout
  title={project.data.title}
  description={project.data.description}
  structuredData={[projectSchema, breadcrumbSchema]}
>
  <Container>
    <Nav
      breadCrumbsItems={[
        { href: "/projects", label: "Projects" },
        { href: `/projects/${project.slug}`, label: project.data.title },
      ]}
    />

    <div
      class="space-y-6 my-12"
      style="--section-accent: var(--accent-sage);"
    >
      <div class="section-stripe"></div>
      <div class="flex flex-wrap items-baseline justify-between gap-3">
        <span class="eyebrow" style="color: var(--section-accent);">
          Project
        </span>
        <div class="flex items-baseline gap-2 font-serif italic text-sm text-flexoki-base-600 dark:text-flexoki-base-400">
          <FormattedDate date={project.data.date} />
          <span aria-hidden="true" class="opacity-50">·</span>
          <span>{readingTime(project.body)}</span>
        </div>
      </div>
      {
        project.data.titleCorrection ? (
          <Correction
            text={project.data.titleCorrection}
            color="sage"
            textClass="text-3xl md:text-4xl -top-7"
          >
            <h1 class="text-3xl md:text-4xl font-semibold font-serif leading-tight text-flexoki-ink dark:text-flexoki-base-50">
              {project.data.title}
            </h1>
          </Correction>
        ) : (
          <h1 class="text-3xl md:text-4xl font-semibold font-serif leading-tight text-flexoki-ink dark:text-flexoki-base-50">
            {project.data.title}
          </h1>
        )
      }
      {
        (project.data.demoURL || project.data.repoURL) && (
          <nav class="flex gap-2 text-sm">
            {project.data.demoURL && (
              <Link href={project.data.demoURL} external>
                Visit
              </Link>
            )}
            {project.data.demoURL && project.data.repoURL && (
              <span aria-hidden="true" class="opacity-50">·</span>
            )}
            {project.data.repoURL && (
              <Link href={project.data.repoURL} external>
                Source
              </Link>
            )}
          </nav>
        )
      }
    </div>
    <article>
      <Content />
    </article>
  </Container>
</PageLayout>
