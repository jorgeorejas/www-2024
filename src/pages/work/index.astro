---
import AppellationBand from "@components/AppellationBand.astro";
import Container from "@components/Container.astro";
import Nav from "@components/Nav.astro";
import WorkTimeline from "@components/WorkTimeline.astro";
import { WORK } from "@consts";
import PageLayout from "@layouts/PageLayout.astro";
import { getWorkDateRange, processWorkEntry } from "@lib/utils";
import { getCollection } from "astro:content";

const collection = (await getCollection("work")).sort((a, b) => {
  const aDateRange = getWorkDateRange(a.data.roles);
  const bDateRange = getWorkDateRange(b.data.roles);
  return bDateRange.startDate.valueOf() - aDateRange.startDate.valueOf();
});

const work = await Promise.all(
  collection.map(async (item) => {
    const { Content } = await item.render();
    return { ...item, Content };
  }),
);

const processedWork = work.map((item) => processWorkEntry(item));
---

<PageLayout title={WORK.TITLE} description={WORK.DESCRIPTION}>
  <Container>
    <Nav breadCrumbsItems={[{ href: "/work", label: "Work" }]} />

    <div
      class="my-12 space-y-12"
      style="--section-accent: var(--accent-bordeaux);"
    >
      <AppellationBand
        variant="bordeaux"
        eyebrow="Experience"
        subtitle="A vintage list of where I've worked."
      />
      <h1 class="wordmark" style="font-size: clamp(3rem, 9vw, 7rem);">
        Work
      </h1>

      <WorkTimeline processedWork={processedWork} />
    </div>
  </Container>
</PageLayout>
