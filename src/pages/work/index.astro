---
import Container from "@components/Container.astro";
import Nav from "@components/Nav.astro";
import WorkTimeline from "@components/WorkTimeline.astro";
import { WORK } from "@consts";
import PageLayout from "@layouts/PageLayout.astro";
import { cachePage } from "@lib/cache-headers";
import { processWorkEntry } from "@lib/utils";
import { getLiveCollection } from "astro:content";

// Companies from Notion with their roles, newest first
const { entries: work = [], error } = await getLiveCollection("work");
cachePage(Astro.response, ["work"], error);

const processedWork = work.map((item) =>
  processWorkEntry({ id: item.id, data: item.data, body: item.data.body }),
);
---

<PageLayout title={WORK.TITLE} description={WORK.DESCRIPTION}>
  <Container>
    <div class="space-y-2">
      <Nav breadCrumbsItems={[{ href: "/work", label: "Work" }]} />
    </div>
    <div class="my-12 space-y-12">
      <h1 class="text-3xl font-semibold font-serif text-flexoki-ink dark:text-flexoki-base-50 hover:opacity-70 transition-opacity">
        Work
      </h1>
      <WorkTimeline processedWork={processedWork} />
    </div>
  </Container>
</PageLayout>
