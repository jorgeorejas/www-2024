---
import ListRow from "@components/margin/ListRow.astro";
import MarginPage from "@components/margin/MarginPage.astro";
import Row from "@components/margin/Row.astro";
import SectionHead from "@components/margin/SectionHead.astro";
import WorkTimeline from "@components/WorkTimeline.astro";
import { PROJECTS, WORK } from "@consts";
import { cachePage } from "@lib/cache-headers";
import { processWorkEntry } from "@lib/utils";
import { getLiveCollection } from "astro:content";

// Companies from Notion with their roles, newest first
const [work, projects] = await Promise.all([
  getLiveCollection("work"),
  getLiveCollection("projects"),
]);
cachePage(Astro.response, ["work", "projects"], work.error ?? projects.error);

const processedWork = (work.entries ?? []).map((item) =>
  processWorkEntry({ id: item.id, data: item.data, body: item.data.body }),
);
const projectCount = (projects.entries ?? []).length;
---

<MarginPage
  title={WORK.TITLE}
  description={WORK.DESCRIPTION}
  breadcrumbs={[{ href: "/work", label: "Work" }]}
>
  <Row>
    <div class="m-article">
      <h1 class="m-h1">{WORK.TITLE}</h1>
      <p class="m-lede">{WORK.DESCRIPTION}</p>
      <WorkTimeline processedWork={processedWork} class="mt-4" />
    </div>
  </Row>

  <Row label="more" as="section" aria-labelledby="work-more">
    <SectionHead id="work-more" title="Also" />
    <ul class="m-list">
      <ListRow href="/cv" title="Curriculum vitae" value="/cv" />
      <ListRow
        href="/projects"
        title={PROJECTS.TITLE}
        value={projectCount ? String(projectCount) : undefined}
      />
    </ul>
  </Row>
</MarginPage>
