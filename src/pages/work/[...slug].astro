---
import PenArrow from "@components/margin/PenArrow.astro";
import ListRow from "@components/margin/ListRow.astro";
import MarginPage from "@components/margin/MarginPage.astro";
import Row from "@components/margin/Row.astro";
import SectionHead from "@components/margin/SectionHead.astro";
import WorkTimeline from "@components/WorkTimeline.astro";
import { cachePage, isNotFound, notionUnavailable } from "@lib/cache-headers";
import { WORK } from "@consts";
import { PRESENT_LABEL, formatDuration, formatMonthYear, formatYear, processWorkEntry } from "@lib/utils";
import { getLiveCollection, getLiveEntry } from "astro:content";

const slug = Astro.params.slug ?? "";
// The other companies (for "More work") load alongside the entry; live
// collections report failures in `error` instead of rejecting
const allWork = getLiveCollection("work");
const { entry: work, error } = await getLiveEntry("work", { id: slug });
if (error && !isNotFound(error)) return notionUnavailable(error);
if (!work) return Astro.rewrite("/404");
const all = await allWork;
cachePage(Astro.response, ["work", `work:${work.id}`], all.error);

const company = processWorkEntry({ id: work.id, data: work.data, body: work.data.body });
const others = (all.entries ?? [])
  .filter((entry) => entry.id !== work.id)
  .map((entry) => processWorkEntry({ id: entry.id, data: entry.data, body: entry.data.body }));

// Overall period across the company's roles, e.g. "ene 2025 – actualidad · 1 año y 10 meses"
const { startDate, endDate } = company;
const start = startDate instanceof Date ? startDate : undefined;
const period = start
  ? [
      `${formatMonthYear(start)} – ${endDate instanceof Date ? formatMonthYear(endDate) : PRESENT_LABEL}`,
      formatDuration(start, endDate),
    ].join(" · ")
  : undefined;

/** "2022 – 2024" or "2025 – hoy" for the list of other companies */
function years(job: (typeof others)[number]) {
  if (!(job.startDate instanceof Date)) return undefined;
  const from = formatYear(job.startDate);
  if (!(job.endDate instanceof Date)) return `${from} – hoy`;
  const to = formatYear(job.endDate);
  return from === to ? from : `${from} – ${to}`;
}

// Company website, shown as its bare host name
let site: { href: string; host: string } | undefined;
if (company.website) {
  try {
    site = { href: company.website, host: new URL(company.website).hostname.replace(/^www\./, "") };
  } catch {
    site = undefined;
  }
}
---

<MarginPage
  title={`Mi etapa en ${company.name}`}
  description={`Los puestos que tuve en ${company.name} y lo que hice en cada uno.`}
  breadcrumbs={[
    { href: "/work", label: WORK.TITLE },
    { href: `/work/${work.id}`, label: company.name },
  ]}
>
  <Row>
    <article class="m-article">
      <h1 class="m-h1">{company.name}</h1>
      {period && <p class="m-date">{period}</p>}
      {
        work.rendered?.html && (
          <div class="m-prose">
            <Fragment set:html={work.rendered.html} />
          </div>
        )
      }
      <section class="mt-(--g)" aria-labelledby="positions">
        <SectionHead id="positions" title="Puestos" />
        <WorkTimeline processedWork={[company]} showCompany={false} headingLevel={3} />
      </section>
      {
        site && (
          <p class="m-0 h-(--g)">
            <a class="m-all" href={site.href} target="_blank" rel="noopener noreferrer">
              Visitar {site.host} <PenArrow dir="out" />
            </a>
          </p>
        )
      }
    </article>
  </Row>

  {
    others.length > 0 && (
      <Row label="más" as="section" aria-labelledby="work-more">
        <SectionHead id="work-more" title="Otros sitios donde trabajé" href="/work" linkLabel="Ver toda la trayectoria" />
        <ul class="m-list">
          {others.map((job) => (
            <ListRow
              href={`/work/${job.slug}`}
              title={job.name}
              value={years(job)}
              description={job.positions.map((position) => position.title).join(" · ")}
            />
          ))}
        </ul>
      </Row>
    )
  }
</MarginPage>
