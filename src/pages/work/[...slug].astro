---
import Container from "@components/Container.astro";
import Nav from "@components/Nav.astro";
import PageLayout from "@layouts/PageLayout.astro";
import { dateRange, getWorkDateRange } from "@lib/utils";
import { type CollectionEntry, getCollection } from "astro:content";

export const prerender = true;

export async function getStaticPaths() {
  const workEntries = (await getCollection("work")).sort(
    (a: CollectionEntry<"work">, b: CollectionEntry<"work">) => {
      const aDateRange = getWorkDateRange(a.data.roles);
      const bDateRange = getWorkDateRange(b.data.roles);
      return bDateRange.startDate.valueOf() - aDateRange.startDate.valueOf();
    },
  );
  return workEntries.map((work: CollectionEntry<"work">) => ({
    params: { slug: work.slug },
    props: work,
  }));
}
type Props = CollectionEntry<"work">;

const work = Astro.props;
const { Content } = await work.render();

// Derive the overall date range from roles
const { startDate, endDate } = getWorkDateRange(work.data.roles);
---

<PageLayout
  title={`${work.data.company} - Work Experience`}
  description={`Work experience at ${work.data.company}`}
>
  <Container>
    <Nav
      breadCrumbsItems={[
        { href: "/work", label: "Work" },
        { href: `/work/${work.slug}`, label: work.data.company },
      ]}
    />

    <div
      class="space-y-6 my-12"
      style="--section-accent: var(--accent-bordeaux);"
    >
      <div class="section-stripe"></div>
      <div class="flex flex-wrap items-baseline justify-between gap-3">
        <span class="eyebrow" style="color: var(--section-accent);">
          Experience
        </span>
        <div class="font-serif italic text-sm text-flexoki-base-600 dark:text-flexoki-base-400">
          {dateRange(startDate, endDate)}
        </div>
      </div>

      <h1 class="text-3xl md:text-4xl font-semibold font-serif leading-tight text-flexoki-ink dark:text-flexoki-base-50">
        {work.data.company}
      </h1>

      <div class="prose prose-neutral dark:prose-invert max-w-none">
        <Content />
      </div>

      <div class="space-y-4 pt-4">
        <h2 class="eyebrow" style="color: var(--section-accent);">
          Positions
        </h2>
        <div class="space-y-4">
          {
            work.data.roles
              .sort((a, b) => b.dateStart.valueOf() - a.dateStart.valueOf())
              .map((position, i) => (
                <div class="space-y-2">
                  <div class="font-serif italic text-sm text-flexoki-base-600 dark:text-flexoki-base-400">
                    {position.dateEnd
                      ? new Date(position.dateEnd).toLocaleDateString("es-ES")
                      : "Present"}
                  </div>
                  <div
                    class="border-l-2 pl-4 space-y-2"
                    style="border-color: color-mix(in srgb, var(--section-accent) 50%, transparent);"
                  >
                    <div class="font-medium font-serif text-lg">
                      {position.title}
                    </div>
                    {position.description && (
                      <div class="text-sm text-flexoki-base-700 dark:text-flexoki-base-400">
                        {position.description}
                      </div>
                    )}
                  </div>
                  {i === work.data.roles.length - 1 && (
                    <div class="font-serif italic text-sm text-flexoki-base-600 dark:text-flexoki-base-400">
                      {position.dateStart.toLocaleDateString("es-ES")}
                    </div>
                  )}
                </div>
              ))
          }
        </div>
      </div>
    </div>
  </Container>
</PageLayout>
