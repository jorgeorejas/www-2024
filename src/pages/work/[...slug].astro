---
import Container from "@components/Container.astro";
import Nav from "@components/Nav.astro";
import PageLayout from "@layouts/PageLayout.astro";
import LogbookDivider from "@components/LogbookDivider.astro";
import { SectionHeader, DateBadge } from "@components/logbook";
import { getWorkDateRange } from "@lib/utils";
import { type CollectionEntry, getCollection } from "astro:content";

export const prerender = true;

export async function getStaticPaths() {
  const workEntries = (await getCollection("work")).sort(
    (a: CollectionEntry<"work">, b: CollectionEntry<"work">) => {
      const aDateRange = getWorkDateRange(a.data.roles);
      const bDateRange = getWorkDateRange(b.data.roles);
      return bDateRange.startDate.valueOf() - aDateRange.startDate.valueOf();
    },
  );
  return workEntries.map((work: CollectionEntry<"work">) => ({
    params: { slug: work.slug },
    props: work,
  }));
}
type Props = CollectionEntry<"work">;

const work = Astro.props;
const { Content } = await work.render();

// Derive the overall date range from roles
const { startDate } = getWorkDateRange(work.data.roles);
---

<PageLayout
  title={`${work.data.company} - Work Experience`}
  description={`Work experience at ${work.data.company}`}
>
  <Container>
    <div class="space-y-2">
      <Nav
        breadCrumbsItems={[
          { href: "/work", label: "Work" },
          { href: `/work/${work.slug}`, label: work.data.company },
        ]}
      />
    </div>
    <div class="space-y-4 my-10">
      <DateBadge date={startDate} />

      <SectionHeader level={1}>
        {work.data.company}
      </SectionHeader>

      <div class="prose prose-neutral dark:prose-invert max-w-none">
        <Content />
      </div>

      <LogbookDivider />

      <div class="space-y-4">
        <SectionHeader level={2}>
          Positions
        </SectionHeader>
        <div class="space-y-4">
          {
            work.data.roles
              .sort((a, b) => b.dateStart.valueOf() - a.dateStart.valueOf())
              .map((position, i) => (
                <div class="space-y-2">
                  {position.dateEnd && position.dateEnd !== "Present" ? (
                    <DateBadge date={position.dateEnd} format="day" />
                  ) : (
                    <span class="font-sans text-sm text-orange-ink uppercase tracking-wide">
                      Present
                    </span>
                  )}
                  <div class="border-l-2 border-soft-gray/20 pl-4 space-y-2">
                    <div class="font-sans font-medium text-ink-black dark:text-paper-white">
                      {position.title}
                    </div>
                    {position.description && (
                      <div class="font-sans text-sm text-soft-gray leading-relaxed">
                        {position.description}
                      </div>
                    )}
                  </div>
                  {i === work.data.roles.length - 1 && (
                    <div class="font-sans text-sm text-soft-gray">
                      {position.dateStart.toLocaleDateString("es-ES")}
                    </div>
                  )}
                </div>
              ))
          }
        </div>
      </div>
    </div>
  </Container>
</PageLayout>
