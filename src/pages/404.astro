---
import MarginNote from "@components/margin/MarginNote.astro";
import MarginPage from "@components/margin/MarginPage.astro";
import Row from "@components/margin/Row.astro";
import { navKeyFor } from "@components/margin/nav";

Astro.response.status = 404;
Astro.response.headers.set("Cache-Control", "public, max-age=0, s-maxage=300");

// Pages that rewrite to /404 (e.g. a missing recipe) keep their original path here
const path = Astro.originPathname;
const inCocina = path.startsWith("/cocina");
---

<MarginPage
  title="No encontrada"
  description={inCocina ? "Esta receta no existe." : "Esta página no existe."}
  current={navKeyFor(path)}
>
  <Row>
    <MarginNote slot="margin" text="404" class="text-[40px]" />
    <header class="grid gap-6">
      <h1 class="m-h1">
        {inCocina ? "Esta receta no existe" : "Esta página no existe"}
      </h1>
      <p>
        {
          inCocina ? (
            <a class="m-all" href="/cocina">
              Ver todas las recetas
            </a>
          ) : (
            <a class="m-all" href="/">
              Volver al inicio
            </a>
          )
        }
      </p>
    </header>
  </Row>
</MarginPage>
