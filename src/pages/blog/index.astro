---
import AppellationBand from "@components/AppellationBand.astro";
import ArrowCard from "@components/ArrowCard.astro";
import Container from "@components/Container.astro";
import Nav from "@components/Nav.astro";
import { BLOG } from "@consts";
import PageLayout from "@layouts/PageLayout.astro";
import { type CollectionEntry, getCollection } from "astro:content";

const today = new Date();
today.setHours(0, 0, 0, 0);

const isDev = import.meta.env.DEV;

const data = (await getCollection("blog"))
  .filter((post) => !post.data.draft && (isDev || post.data.date <= today))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

type Acc = {
  [year: string]: CollectionEntry<"blog">[];
};

const posts = data.reduce((acc: Acc, post) => {
  const date = post.data.date;
  const monthYear = `${date.toLocaleString("default", { month: "long" })} ${date.getFullYear()}`;
  if (!acc[monthYear]) {
    acc[monthYear] = [];
  }
  acc[monthYear].push(post);
  return acc;
}, {});

const monthYears = Object.keys(posts).sort((a, b) => parseInt(b) - parseInt(a));
---

<PageLayout title={BLOG.TITLE} description={BLOG.DESCRIPTION}>
  <Container>
    <Nav breadCrumbsItems={[{ href: "/blog", label: "Blog" }]} />

    <div
      class="my-12 space-y-12"
      style="--section-accent: var(--accent-sienna);"
    >
      <AppellationBand
        variant="sienna"
        eyebrow="Writing"
        subtitle="Essays, notes, fragments — sorted by month."
      />
      <h1 class="wordmark" style="font-size: clamp(3rem, 9vw, 7rem);">
        Blog
      </h1>

      <div class="space-y-12">
        {
          monthYears.map((year) => (
            <section class="space-y-4">
              <h2 class="font-serif italic text-2xl text-flexoki-base-700 dark:text-flexoki-base-300">
                {year}
              </h2>
              <ul class="flex flex-col gap-1">
                {posts[year].map((post) => (
                  <li>
                    <ArrowCard
                      entry={post}
                      dateFormat="day"
                      variant="sienna"
                    />
                  </li>
                ))}
              </ul>
            </section>
          ))
        }
      </div>
    </div>
  </Container>
</PageLayout>
