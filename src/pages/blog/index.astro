---
import Legend from "@components/margin/Legend.astro";
import ListRow from "@components/margin/ListRow.astro";
import MarginPage from "@components/margin/MarginPage.astro";
import Row from "@components/margin/Row.astro";
import { BLOG } from "@consts";
import { cachePage } from "@lib/cache-headers";
import { formatYear, isNew } from "@lib/utils";
import { getLiveCollection } from "astro:content";

// Published posts from Notion, newest first (drafts only show locally)
const { entries: posts = [], error } = await getLiveCollection("blog");
cachePage(Astro.response, ["blog"], error);

// One group per year, newest first (posts already come sorted)
const years = new Map<string, typeof posts>();
for (const post of posts) {
  const year = formatYear(post.data.date);
  years.set(year, [...(years.get(year) ?? []), post]);
}

// The key under a list only names the markers that list actually shows
function legendFor(items: typeof posts): string | undefined {
  const pick = items.some((p) => p.data.pick);
  const fresh = items.some((p) => isNew(p.data.date));
  if (pick && fresh) return "◆ my pick · NEW last 60 days";
  if (pick) return "◆ my pick";
  if (fresh) return "NEW last 60 days";
  return undefined;
}
---

<MarginPage
  title={BLOG.TITLE}
  description={BLOG.DESCRIPTION}
  breadcrumbs={[{ href: "/blog", label: "Blog" }]}
>
  <Row>
    <header class="grid gap-3">
      <h1 class="m-h1">{BLOG.TITLE}</h1>
      <p class="m-lede">{BLOG.DESCRIPTION}</p>
    </header>
  </Row>

  {
    [...years].map(([year, items]) => {
      const legend = legendFor(items);
      return (
        <Row as="section" label={year} aria-labelledby={`year-${year}`}>
          <h2 id={`year-${year}`} class="sr-only">
            {year}
          </h2>
          <ul class="m-list">
            {items.map((post) => (
              <ListRow
                href={`/blog/${post.id}`}
                title={post.data.title}
                titleCorrection={post.data.titleCorrection}
                date={post.data.date}
                description={post.data.description}
                pick={post.data.pick}
                isNew={isNew(post.data.date)}
                note={post.data.note}
              />
            ))}
          </ul>
          {legend && <Legend text={legend} />}
        </Row>
      );
    })
  }
</MarginPage>
