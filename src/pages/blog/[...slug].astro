---
import FormattedDate from "@components/FormattedDate.astro";
import { AnimatedSignature } from "@components/AnimatedSignature";
import ListRow from "@components/margin/ListRow.astro";
import MarginNote from "@components/margin/MarginNote.astro";
import MarginPage from "@components/margin/MarginPage.astro";
import Row from "@components/margin/Row.astro";
import SectionHead from "@components/margin/SectionHead.astro";
import { BLOG } from "@consts";
import { cachePage, isNotFound, notionUnavailable } from "@lib/cache-headers";
import { generateBlogPostingSchema, generateBreadcrumbSchema } from "@lib/seo-utils";
import { formatDot, formatYear, isNew } from "@lib/utils";
import { getLiveCollection, getLiveEntry } from "astro:content";

const slug = Astro.params.slug ?? "";
const { entry: post, error } = await getLiveEntry("blog", { id: slug });
if (error && !isNotFound(error)) return notionUnavailable(error);
if (!post) return Astro.rewrite("/404");

// Projects this post talks about (Notion relation "Proyectos") and the
// latest other posts for the "more" list at the end
const [{ entries: allPosts = [], error: blogError }, { entries: allProjects = [], error: projectsError }] =
  await Promise.all([
    getLiveCollection("blog"),
    post.data.projects.length
      ? getLiveCollection("projects")
      : Promise.resolve({ entries: [], error: undefined }),
  ]);
cachePage(Astro.response, ["blog", `blog:${post.id}`, "projects"], blogError ?? projectsError);
const related = allProjects.filter((p) => post.data.projects.includes(p.id));
const more = allPosts.filter((p) => p.id !== post.id).slice(0, 3);

const crumbs = [
  { href: "/blog", label: BLOG.TITLE },
  { href: `/blog/${post.id}`, label: post.data.title },
];

// Generate structured data for SEO
const blogPostingSchema = generateBlogPostingSchema(post, Astro.site!.toString());
const breadcrumbSchema = generateBreadcrumbSchema(
  [{ href: "/", label: "Inicio" }, ...crumbs],
  Astro.site!.toString(),
);
---

<MarginPage
  title={post.data.title}
  description={post.data.description}
  ogImage={`/og/${post.id}.png`}
  type="article"
  publishedTime={post.data.date}
  structuredData={[blogPostingSchema, breadcrumbSchema]}
  breadcrumbs={crumbs}
>
  <Row>
    <MarginNote slot="margin" text={post.data.note} />
    <article class="m-article">
      <header class="grid gap-3">
        <h1 class="m-h1">
          {
            post.data.titleCorrection ? (
              <span class="m-corr">
                <s>{post.data.title}</s>
                <span class="m-corr-new">{post.data.titleCorrection}</span>
              </span>
            ) : (
              post.data.title
            )
          }
        </h1>
        <p class="m-date">
          <FormattedDate date={post.data.date} detail="day" />
          {post.data.readingTime && <span> · {post.data.readingTime}</span>}
        </p>
        {post.data.description && <p class="m-lede">{post.data.description}</p>}
      </header>

      <div class="m-prose">
        <Fragment set:html={post.rendered?.html} />
      </div>

      <AnimatedSignature client:visible tone="pen" className="w-33 mt-6" />
    </article>
  </Row>

  {
    related.length > 0 && (
      <Row as="aside" label="proyectos" aria-labelledby="about-project">
        <SectionHead id="about-project" title="Sobre el proyecto" />
        <ul class="m-list">
          {related.map((project) => (
            <ListRow
              href={`/projects/${project.id}`}
              title={project.data.title}
              titleCorrection={project.data.titleCorrection}
              value={formatYear(project.data.date)}
              description={project.data.description}
              pick={project.data.pick}
              isNew={isNew(project.data.date)}
            />
          ))}
        </ul>
      </Row>
    )
  }

  {
    more.length > 0 && (
      <Row as="aside" label="más" aria-labelledby="more-writing">
        <SectionHead id="more-writing" title="Más cosas que escribí" href="/blog" linkLabel="Ver todos los posts" />
        <ul class="m-more-list">
          {more.map((p) => (
            <li>
              <a class="m-more-i" href={`/blog/${p.id}`}>
                <span class="m-more-t">
                  {p.data.titleCorrection ? (
                    <span class="m-corr">
                      <s>{p.data.title}</s>
                      <span class="m-corr-new">{p.data.titleCorrection}</span>
                    </span>
                  ) : (
                    p.data.title
                  )}
                </span>
                <time class="m-more-s" datetime={p.data.date.toISOString()}>
                  {formatDot(p.data.date)}
                </time>
              </a>
            </li>
          ))}
        </ul>
      </Row>
    )
  }
</MarginPage>
