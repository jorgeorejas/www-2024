---
import Container from "@components/Container.astro";
import Correction from "@components/Correction.astro";
import FormattedDate from "@components/FormattedDate.astro";
import Nav from "@components/Nav.astro";
import PageLayout from "@layouts/PageLayout.astro";
import { AnimatedSignature } from "@components/AnimatedSignature";
import { cachePage, isNotFound, notionUnavailable } from "@lib/cache-headers";
import {
  generateBlogPostingSchema,
  generateBreadcrumbSchema,
} from "@lib/seo-utils";
import { getLiveCollection, getLiveEntry } from "astro:content";
import { SITE } from "@consts";

const slug = Astro.params.slug ?? "";
const { entry: post, error } = await getLiveEntry("blog", { id: slug });
if (error && !isNotFound(error)) return notionUnavailable(error);
if (!post) return Astro.rewrite("/404");

// Projects this post talks about (Notion relation "Proyectos")
const { entries: allProjects = [], error: projectsError } = post.data.projects.length
  ? await getLiveCollection("projects")
  : { entries: [], error: undefined };
cachePage(Astro.response, ["blog", `blog:${post.id}`, "projects"], projectsError);
const related = allProjects.filter((p) => post.data.projects.includes(p.id));

// Generate structured data for SEO
const blogPostingSchema = generateBlogPostingSchema(
  post,
  Astro.site!.toString(),
);
const breadcrumbSchema = generateBreadcrumbSchema(
  [
    { href: "/", label: "Home" },
    { href: "/blog", label: "Blog" },
    { href: `/blog/${post.id}`, label: post.data.title },
  ],
  Astro.site!.toString(),
);
---

<PageLayout
  title={post.data.title}
  description={post.data.description}
  ogImage={`/og/${post.id}.png`}
  type="article"
  publishedTime={post.data.date}
  structuredData={[blogPostingSchema, breadcrumbSchema]}
>
  <!-- Sticky header that appears after scrolling past post header -->
  <header id="sticky-header" class="pointer-events-none">
    <Container>
      <div class="text-xl font-semibold font-serif text-black dark:text-white">
        <span class="font-semibold font-serif">Jorge Orejas</span>
        <span class="text-black/50 dark:text-white/50">~</span>
        <span class="whitespace-wrap">{post.data.title}</span>
      </div>
    </Container>
  </header>

  <Container>
    <div class="space-y-2">
      <Nav
        breadCrumbsItems={[
          { href: "/blog", label: "Blog" },
          { href: `/blog/${post.id}`, label: post.data.title },
        ]}
      />
    </div>
    <div class="space-y-4 my-10" id="post-header">
      <div class="flex items-center gap-1.5">
        <div class="font-base text-sm">
          <FormattedDate date={post.data.date} />
        </div>
        &bull;
        <div class="font-base text-sm">
          {post.data.readingTime}
        </div>
      </div>
      {
        post.data.titleCorrection ? (
          <Correction
            text={post.data.titleCorrection}
            textClass="text-2xl -top-6"
          >
            <div class="text-2xl font-semibold font-serif text-flexoki-ink dark:text-flexoki-base-50">
              {post.data.title}
            </div>
          </Correction>
        ) : (
          <div class="text-2xl font-semibold font-serif text-flexoki-ink dark:text-flexoki-base-50">
            {post.data.title}
          </div>
        )
      }

      <div class="border-b border-flexoki-base-200 dark:border-flexoki-base-800 pb-4">
        {post.data.description}
      </div>
    </div>
    <article>
      <Fragment set:html={post.rendered?.html} />
    </article>

    {
      related.length > 0 && (
        <aside class="mt-12 space-y-3">
          <h2 class="text-lg font-semibold font-serif">About the project</h2>
          <ul class="flex flex-col gap-2">
            {related.map((project) => (
              <li>
                <a class="underline decoration-flexoki-base-300 underline-offset-4 hover:decoration-current" href={`/projects/${project.id}`}>
                  {project.data.titleCorrection ?? project.data.title}
                </a>
                <span class="text-sm text-flexoki-base-500"> · {project.data.description}</span>
              </li>
            ))}
          </ul>
        </aside>
      )
    }

    <!-- Animated Signature -->
    <div class="mt-16 mb-8 space-y-4 pt-8 border-black/10 dark:border-white/10">
      <p class="mb-4">By {SITE.AUTHOR_NAME}</p>
      <AnimatedSignature
        client:visible
        className="w-full max-w-2xs mr-auto text-black dark:text-white"
      />
    </div>
  </Container>
</PageLayout>

<script>
  // Show sticky header after scrolling past post header
  const stickyHeader = document.getElementById("sticky-header");
  const postHeader = document.getElementById("post-header");

  if (stickyHeader && postHeader) {
    const observer = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          stickyHeader.classList.add("hidden");
        } else {
          stickyHeader.classList.remove("hidden");
        }
      },
      {
        threshold: 0,
        rootMargin: "-80px 0px 0px 0px", // Account for main header height
      },
    );

    observer.observe(postHeader);
  }
</script>
