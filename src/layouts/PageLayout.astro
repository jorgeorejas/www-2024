---
import Head from "@components/Head.astro";
import Footer from "@components/Footer.astro";
import MarginFooter from "@components/margin/MarginFooter.astro";
import Row from "@components/margin/Row.astro";
import { SITE } from "@consts";
import { PREVIEW_PARAM } from "@lib/preview";
import gridSnapSource from "@lib/dot-grid-snap.js?raw";
import SpeedInsights from "@vercel/speed-insights/astro";
import "@fontsource-variable/caveat";
import "../styles/ioskeley-mono.css";

type Props = {
  title: string;
  description: string;
  ogImage?: string;
  type?: "website" | "article" | "profile";
  publishedTime?: Date;
  modifiedTime?: Date;
  author?: string;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  /** Page language; the site is Spanish, a page can still opt into English */
  lang?: "en" | "es";
  /**
   * "classic": the original single-column layout (Container + Nav).
   * "margin": the Margin design grid. Use MarginPage instead of setting this by hand.
   */
  variant?: "classic" | "margin";
  /** Margin only: show the now-playing line in the footer (home shows it under the bio) */
  footerNowPlaying?: boolean;
};

const {
  title,
  description,
  ogImage,
  type,
  publishedTime,
  modifiedTime,
  author,
  structuredData,
  lang = "es",
  variant = "classic",
  footerNowPlaying = true,
} = Astro.props;
const margin = variant === "margin";

// The dot grid's first pass runs inline, right after the page content and
// before the first paint (rel="expect" holds rendering until it has run), so
// blocks never visibly jump onto their rows. dot-grid.ts re-snaps later on.
const gridSnap = `(() => {\n${gridSnapSource.replace(/^export /gm, "")}\nsnapDotGrid(document.querySelector("body.margin-ui .m"));\n})();`;

// ?preview=true (see src/lib/preview.ts): a badge, and a way back out
const preview = Astro.locals.preview;
const exit = new URL(Astro.url);
exit.searchParams.delete(PREVIEW_PARAM);
const exitHref = exit.pathname + exit.search + exit.hash;
---

<!doctype html>
<html lang={lang}>
  <head>
    <Head
      title={`${title} | ${SITE.NAME}`}
      description={description}
      image={ogImage}
      type={type}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      author={author}
      structuredData={structuredData}
      locale={lang === "en" ? "en_US" : "es_ES"}
    />
    {margin && <link rel="expect" href="#m-grid-ready" blocking="render" />}
  </head>
  <body class:list={["relative", { "margin-ui": margin }]}>
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-flexoki-ink focus:text-flexoki-paper focus:font-semibold"
    >
      {lang === "en" ? "Skip to main content" : "Saltar al contenido"}
    </a>
    <SpeedInsights />
    {
      preview && (
        <>
          <a class="preview-badge" href={exitHref} data-preview-exit title="Salir de la vista previa">
            <span class="preview-badge-dot" aria-hidden="true" />
            Vista previa
            <span class="preview-badge-x" aria-hidden="true">×</span>
          </a>
          <script is:inline>
            // Internal links keep ?preview, so drafts stay visible while browsing
            (() => {
              const value = new URLSearchParams(location.search).get("preview");
              if (!value) return;
              const keep = () => {
                for (const a of document.querySelectorAll("a[href]")) {
                  const raw = a.getAttribute("href") || "";
                  if (a.hasAttribute("data-preview-exit") || raw.startsWith("#")) continue;
                  const url = new URL(raw, location.href);
                  if (url.origin !== location.origin || url.searchParams.has("preview")) continue;
                  if (/^\/(api|og|_astro|img|fonts)\//.test(url.pathname)) continue;
                  url.searchParams.set("preview", value);
                  a.setAttribute("href", url.pathname + url.search + url.hash);
                }
              };
              keep();
              document.addEventListener("astro:page-load", keep);
            })();
          </script>
        </>
      )
    }
    <div class="paper-grain fixed inset-0 pointer-events-none" aria-hidden="true"></div>
    {
      margin ? (
        <main id="main-content" class="m-main relative">
          <div class="m">
            <slot />
            <Row>
              <MarginFooter lang={lang} nowPlaying={footerNowPlaying} />
            </Row>
          </div>
          <script is:inline set:html={gridSnap} />
          <span id="m-grid-ready" hidden />
        </main>
      ) : (
        <main id="main-content" class="relative antialiased">
          <slot />
          <Footer lang={lang} />
        </main>
      )
    }
  </body>
</html>
