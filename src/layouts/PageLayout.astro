---
import Head from "@components/Head.astro";
import Footer from "@components/Footer.astro";
import MarginFooter from "@components/margin/MarginFooter.astro";
import Row from "@components/margin/Row.astro";
import { SITE } from "@consts";
import SpeedInsights from "@vercel/speed-insights/astro";
import "@fontsource-variable/caveat";
import "../styles/ioskeley-mono.css";

type Props = {
  title: string;
  description: string;
  ogImage?: string;
  type?: "website" | "article" | "profile";
  publishedTime?: Date;
  modifiedTime?: Date;
  author?: string;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  /** Page language; the site is English, a few pages (e.g. /wishlist) are Spanish */
  lang?: "en" | "es";
  /**
   * "classic": the original single-column layout (Container + Nav).
   * "margin": the Margin design grid. Use MarginPage instead of setting this by hand.
   */
  variant?: "classic" | "margin";
  /** Margin only: show the now-playing line in the footer (home shows it under the bio) */
  footerNowPlaying?: boolean;
};

const {
  title,
  description,
  ogImage,
  type,
  publishedTime,
  modifiedTime,
  author,
  structuredData,
  lang = "en",
  variant = "classic",
  footerNowPlaying = true,
} = Astro.props;
const margin = variant === "margin";
---

<!doctype html>
<html lang={lang}>
  <head>
    <Head
      title={`${title} | ${SITE.NAME}`}
      description={description}
      image={ogImage}
      type={type}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      author={author}
      structuredData={structuredData}
      locale={lang === "es" ? "es_ES" : undefined}
    />
  </head>
  <body class:list={["relative", { "margin-ui": margin }]}>
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-flexoki-ink focus:text-flexoki-paper focus:font-semibold"
    >
      {lang === "es" ? "Saltar al contenido" : "Skip to main content"}
    </a>
    <SpeedInsights />
    <div class="paper-grain fixed inset-0 pointer-events-none" aria-hidden="true"></div>
    {
      margin ? (
        <main id="main-content" class="m-main relative">
          <div class="m">
            <slot />
            <Row>
              <MarginFooter lang={lang} nowPlaying={footerNowPlaying} />
            </Row>
          </div>
        </main>
      ) : (
        <main id="main-content" class="relative antialiased">
          <slot />
          <Footer lang={lang} />
        </main>
      )
    }
  </body>
</html>
