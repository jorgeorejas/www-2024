---
interface Props {
  date: Date;
  detail?: "short" | "day" | "month";
}

const { date, detail = "month" } = Astro.props;
---

<time datetime={date.toISOString()}>
  {
    date.toLocaleDateString("en-us", {
      month: detail === "month" ? "short" : "long",
      day: detail === "month" ? undefined : "numeric",
      year: "numeric",
    })
  }
</time>
