---
import type { CollectionEntry } from "astro:content";
import FormattedDate from "./FormattedDate.astro";
import Correction from "./Correction.astro";
import AnimatedArrow from "./AnimatedArrow.astro";

type Props = {
  entry:
    | CollectionEntry<"blog">
    | CollectionEntry<"projects">
    | CollectionEntry<"ideas">
    | CollectionEntry<"notes">;
  dateFormat?: "short" | "day" | "month";
};

const { entry, dateFormat } = Astro.props;
---

<a
  href={`/${entry.collection}/${entry.slug}`}
  class="relative group flex flex-nowrap py-3 px-4 pr-10 border-l border-black/15 dark:border-white/20 hover:bg-black/5 dark:hover:bg-white/5 hover:text-black dark:hover:text-white transition-colors duration-300 ease-in-out"
>
  <div class="flex flex-col gap-2 flex-1">
    <div class="flex md:gap-2 md:items-center flex-col md:flex-row">
      {
        entry.data.titleCorrection ? (
          <div class="font-semibold font-serif">
            <Correction text={entry.data.titleCorrection} rotate>
              {entry.data.title}
            </Correction>
          </div>
        ) : (
          <div class="font-semibold font-serif relative inline-block">
            {entry.data.title}
            <span class="absolute left-0 bottom-0 w-full h-[1px] bg-blue-800 scale-x-0 group-hover:scale-x-100 origin-left transition-transform duration-300 ease-in-out" />
          </div>
        )
      }
      <div class="text-sm text-black/50 dark:text-white/50">
        <span class="hidden md:inline"> - </span>
        <FormattedDate date={entry.data.date} detail={dateFormat} />
      </div>
    </div>

    <div class="text-sm">
      {entry.data.description}
    </div>
  </div>
  <AnimatedArrow />
</a>
