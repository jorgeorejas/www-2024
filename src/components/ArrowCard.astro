---
import type { CollectionEntry } from "astro:content";
import FormattedDate from "./FormattedDate.astro";
import Correction from "./Correction.astro";
import AnimatedArrow from "./AnimatedArrow.astro";

type Props = {
  entry: CollectionEntry<"blog"> | CollectionEntry<"projects">;
  dateFormat?: "short" | "day" | "month";
};

const { entry, dateFormat } = Astro.props;
---

<a
  href={`/${entry.collection}/${entry.slug}`}
  class="relative group flex flex-nowrap py-4 pr-10 transition-colors duration-300 ease-in-out"
>
  <div class="flex flex-col gap-2 flex-1">
    <div class="flex md:gap-4 md:items-baseline flex-col md:flex-row">
      {
        entry.data.titleCorrection ? (
          <h3 class="font-sans font-medium text-lg text-ink-black dark:text-paper-white group-hover:text-orange-ink transition-colors">
            <Correction text={entry.data.titleCorrection} rotate>
              {entry.data.title}
            </Correction>
          </h3>
        ) : (
          <h3 class="font-sans font-medium text-lg text-ink-black dark:text-paper-white group-hover:text-orange-ink transition-colors">
            {entry.data.title}
          </h3>
        )
      }
      <time class="font-sans text-sm text-orange-ink uppercase tracking-wide">
        <FormattedDate date={entry.data.date} detail={dateFormat} />
      </time>
    </div>

    {entry.data.description && (
      <p class="font-sans text-sm text-soft-gray leading-relaxed">
        {entry.data.description}
      </p>
    )}
  </div>
  <AnimatedArrow />
</a>
