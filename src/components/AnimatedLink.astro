---
import AnimatedArrow from "./AnimatedArrow.astro";

type Props = {
  href: string;
  external?: boolean;
};

const { href, external, ...rest } = Astro.props;
---

<a
  href={href}
  target={external ? "_blank" : "_self"}
  class="group relative inline-flex items-center gap-2 px-4 text-current hover:text-black dark:hover:text-white transition-colors duration-300 ease-in-out"
  {...rest}
>
  <span class="inline-flex items-center">
    <span class="relative">
      <slot />
      <span
        class="absolute left-0 bottom-0 w-full h-[1px] bg-black/20 dark:bg-white/30 opacity-0 group-hover:opacity-100 transition-opacity duration-300 ease-in-out"
      ></span>
    </span>
  </span>
  <AnimatedArrow inline />
</a>
