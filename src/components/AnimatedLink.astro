---
import AnimatedArrow from "./AnimatedArrow.astro";

type Props = {
  href: string;
  external?: boolean;
  variant?: "default" | "eyebrow";
};

const { href, external, variant = "default", ...rest } = Astro.props;

const textClass =
  variant === "eyebrow"
    ? "eyebrow"
    : "text-current hover:text-flexoki-ink dark:hover:text-flexoki-base-50";
---

<a
  href={href}
  target={external ? "_blank" : "_self"}
  class:list={[
    "group relative inline-flex items-center gap-2 px-1 transition-colors duration-300 ease-in-out",
    textClass,
  ]}
  {...rest}
>
  <span class="inline-flex items-center">
    <span class="relative">
      <slot />
      <span
        class="absolute left-0 bottom-0 w-full h-[1px] scale-x-0 group-hover:scale-x-100 origin-left transition-transform duration-300 ease-in-out"
        style="background-color: var(--section-accent, currentColor);"
      ></span>
    </span>
  </span>
  <AnimatedArrow inline size={variant === "eyebrow" ? "sm" : "md"} />
</a>
