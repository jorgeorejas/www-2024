---
import { cn } from "@lib/utils";

type Props = {
  href: string;
  external?: boolean;
  underline?: boolean;
};

const { href, external, underline = true, ...rest } = Astro.props;
---

<a
  href={href}
  target={external ? "_blank" : "_self"}
  class={cn(
    "inline-block decoration-flexoki-base-500 dark:decoration-flexoki-base-700 hover:decoration-flexoki-base-700 dark:hover:decoration-flexoki-base-500 text-current hover:text-flexoki-ink dark:hover:text-flexoki-base-50 transition-colors duration-300 ease-in-out",
    underline && "underline underline-offset-2",
  )}
  {...rest}
>
  <slot />
</a>
