---
import { cn } from "@lib/utils";

type Props = {
  color?: "blue" | "red" | "green" | "black" | "orange";
  rotate?: boolean;
  text: string;
  textClass?: string;
  class?: string;
};

const {
  color = "blue",
  rotate = false,
  text,
  textClass,
  class: correctionClass = "",
} = Astro.props;
---

<span class={cn("flex flex-col relative", correctionClass)}>
  <span
    class={cn(
      "font-handwritten font-bold relative inline-block",
      "absolute -top-4 whitespace-nowrap",
      {
        "-rotate-6": rotate,
      },
      {
        "text-international-orange": color === "orange",
        "text-flexoki-red-600": color === "red",
        "text-flexoki-green-600": color === "green",
        "text-flexoki-blue-600": color === "blue",
      },
      textClass,
    )}
  >
    {text}
    <span
      class="absolute left-0 bottom-1 w-full h-[1px] bg-blue-800 scale-x-0 group-hover:scale-x-100 origin-left transition-transform duration-300 ease-in-out"
    ></span>
  </span>
  <span
    class={cn("line-through", {
      "decoration-international-orange": color === "orange",
      "decoration-flexoki-red-600": color === "red",
      "decoration-flexoki-green-600": color === "green",
      "decoration-flexoki-blue-600": color === "blue",
    })}
  >
    <slot />
  </span>
</span>
