---
import { cn } from "@lib/utils";

type Props = {
  color?: "blue" | "red" | "green" | "black" | "orange";
  text: string;
};

const { color = "blue", text } = Astro.props;
---

<span class="flex flex-col items-center">
  <span
    class={cn("font-handwritten", {
      "text-international-orange": color === "orange",
      "text-red-500": color === "red",
      "text-green-700": color === "green",
      "text-blue-800": color === "blue",
    })}
  >
    {text}
  </span>
  <span
    class={cn("line-through", {
      "decoration-international-orange": color === "orange",
      "decoration-red-500": color === "red",
      "decoration-green-700": color === "green",
      "decoration-blue-800": color === "blue",
    })}
  >
    <slot />
  </span>
</span>
