---
/*
 * Footer for pages still on the classic layout (Container + Nav). It shows
 * the same thing as the Margin footer (socials, email, llms files and the
 * one-line now playing), so every page ends the same way. Margin pages get
 * MarginFooter straight from PageLayout.
 */
import Container from "@components/Container.astro";
import MarginFooter from "@components/margin/MarginFooter.astro";

type Props = { lang?: "en" | "es" };
const { lang = "en" } = Astro.props;
---

<Container>
  {/* margin-ui opts the footer out of the classic `footer` element rule (py-5 text-sm) */}
  <div class="margin-ui pt-16">
    <MarginFooter lang={lang} />
  </div>
</Container>
