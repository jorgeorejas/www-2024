---
import Link from "@components/Link.astro";
import Container from "@components/Container.astro";
import { SITE, SOCIALS } from "@consts";
---

<Container>
  <div class="space-y-16 pt-16">
    <hr class="border-black/15 dark:border-white/20" />

    <section class="space-y-6">
      <div class="space-y-2">
        <h5 class="font-semibold text-black dark:text-white font-serif">
          References
        </h5>
        <p class="text-sm text-black/60 dark:text-white/60">
          Social profiles and email.
        </p>
      </div>

      <ul
        class="flex flex-wrap gap-x-4 gap-y-2 text-sm text-black/70 dark:text-white/70"
      >
        {
          SOCIALS.map((SOCIAL) => (
            <li class="text-nowrap">
              <Link
                href={SOCIAL.HREF}
                external
                aria-label={`${SITE.NAME} on ${SOCIAL.NAME}`}
              >
                {SOCIAL.NAME}
              </Link>
            </li>
          ))
        }
        <li class="flex gap-x-2 text-nowrap">
          <Link href={`mailto:${SITE.EMAIL}`} aria-label={`Email ${SITE.NAME}`}>
            {SITE.EMAIL}
          </Link>
        </li>
      </ul>

      <div class="space-y-1 text-xs text-black/50 dark:text-white/50">
        <p class="font-medium">Metadata</p>
        <ul class="flex flex-wrap gap-x-3 gap-y-1">
          <li class="flex gap-x-2 text-nowrap">
            <Link
              href="/llms.txt"
              aria-label="llms.txt - Basic information for LLMs"
            >
              llms.txt
            </Link>
            {"/"}
          </li>
          <li class="line-clamp-1">
            <Link
              href="/llms-full.txt"
              aria-label="llms-full.txt - Extended information for LLMs"
            >
              llms-full.txt
            </Link>
          </li>
        </ul>
      </div>
    </section>
  </div>
</Container>
