---
import Link from "@components/Link.astro";
import Container from "@components/Container.astro";
import { SITE, SOCIALS } from "@consts";
---

<Container>
  <div class="space-y-16 pt-16">
    <hr class="border-black/15 dark:border-white/20" />

    <section class="space-y-4">
      <h5 class="font-serif font-semibold text-black dark:text-white">
        Let's Connect
      </h5>
      <article>
        <p>
          If you want to get in touch with me about something or just to say hi,
          reach out on social media or send me an email. You can also use the
          information from llms.txt and llms-full.txt to connect my information
          to your AI.
        </p>
      </article>
      <ul class="flex flex-wrap gap-2">
        {
          SOCIALS.map((SOCIAL) => (
            <li class="flex gap-x-2 text-nowrap">
              <Link
                href={SOCIAL.HREF}
                external
                aria-label={`${SITE.NAME} on ${SOCIAL.NAME}`}
              >
                {SOCIAL.NAME}
              </Link>
              {"/"}
            </li>
          ))
        }
        <li class="flex gap-x-2 text-nowrap">
          <Link href={`mailto:${SITE.EMAIL}`} aria-label={`Email ${SITE.NAME}`}>
            {SITE.EMAIL}
          </Link>
          {"/"}
        </li>
        <li class="flex gap-x-2 text-nowrap">
          <Link
            href="/llms.txt"
            aria-label="llms.txt - Basic information for LLMs"
          >
            llms.txt
          </Link>
          {"/"}
        </li>
        <li class="line-clamp-1">
          <Link
            href="/llms-full.txt"
            aria-label="llms-full.txt - Extended information for LLMs"
          >
            llms-full.txt
          </Link>
        </li>
      </ul>
    </section>
  </div>
</Container>
