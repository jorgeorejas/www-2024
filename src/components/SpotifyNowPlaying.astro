---
// Widget shell is always rendered hidden; client-side script populates and
// reveals it after fetching /api/spotify/now-playing. Avoids fragile SSR
// self-fetch that can be blocked by Vercel preview deployment protection.
---

<div id="spotify-widget" class="mb-8 hidden">
  <div class="flex items-center gap-3 text-sm">
    <span id="spotify-icon" class="flex items-center shrink-0">
      <!-- Music note icon for currently playing -->
      <svg
        id="icon-playing"
        class="hidden"
        width="16"
        height="16"
        viewBox="0 0 16 16"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path
          d="M6 3v8.5a2.5 2.5 0 1 1-1-2V4.5L11 3v6.5a2.5 2.5 0 1 1-1-2V4l-4 1z"
          fill="currentColor"
        />
        <circle cx="4.5" cy="11.5" r="1.5" fill="currentColor" />
        <circle cx="10.5" cy="9.5" r="1.5" fill="currentColor" />
      </svg>
      <!-- Pause icon for last played -->
      <svg
        id="icon-paused"
        width="16"
        height="16"
        viewBox="0 0 16 16"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
      >
        <rect x="4" y="3" width="2.5" height="10" rx="0.5" fill="currentColor" />
        <rect x="9.5" y="3" width="2.5" height="10" rx="0.5" fill="currentColor" />
      </svg>
    </span>
    <canvas
      id="spotify-art"
      width="96"
      height="96"
      class="hidden w-12 h-12 shrink-0 bg-flexoki-paper dark:bg-flexoki-ink"
    ></canvas>
    <div class="flex flex-col gap-0.5 min-w-0 flex-1">
      <span id="spotify-status" class="opacity-60">Last played</span>
      <div class="flex items-baseline gap-2 min-w-0">
        <a
          id="spotify-track-link"
          href="#"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block truncate decoration-flexoki-base-300 dark:decoration-flexoki-base-700 hover:decoration-flexoki-base-500 text-current hover:text-flexoki-ink hover:dark:text-flexoki-base-50 transition-colors duration-300 ease-in-out underline underline-offset-2"
        >
          <span id="spotify-track-title"></span>
          <span class="opacity-60"> by </span>
          <span id="spotify-track-artist"></span>
        </a>
        <span id="spotify-album" class="opacity-60 truncate shrink-0 max-w-[16ch]"></span>
      </div>
      <div
        id="spotify-progress"
        class="mt-1 h-1 hidden bg-flexoki-base-100 dark:bg-flexoki-base-900 overflow-hidden"
      >
        <div
          id="spotify-progress-fill"
          class="h-full pattern-hatch text-flexoki-ink dark:text-flexoki-base-50 transition-[width] duration-700 ease-linear"
          style="width: 0%"
        ></div>
      </div>
    </div>
  </div>
</div>

<script>
  interface SpotifyData {
    isPlaying: boolean;
    title?: string;
    artist?: string;
    album?: string;
    albumImage?: string;
    url?: string;
    progressMs?: number;
    durationMs?: number;
    playedAt?: string;
  }

  const widget = document.getElementById("spotify-widget");
  const trackLink = document.getElementById("spotify-track-link") as HTMLAnchorElement;
  const trackTitle = document.getElementById("spotify-track-title");
  const trackArtist = document.getElementById("spotify-track-artist");
  const trackAlbum = document.getElementById("spotify-album");
  const statusText = document.getElementById("spotify-status");
  const iconPlaying = document.getElementById("icon-playing");
  const iconPaused = document.getElementById("icon-paused");
  const progress = document.getElementById("spotify-progress");
  const progressFill = document.getElementById("spotify-progress-fill");
  const artCanvas = document.getElementById("spotify-art") as HTMLCanvasElement | null;

  let lastImageUrl: string | null = null;

  function formatRelative(iso: string): string {
    const then = new Date(iso).getTime();
    if (Number.isNaN(then)) return "recently";
    const diff = Date.now() - then;
    const sec = Math.max(0, Math.round(diff / 1000));
    if (sec < 60) return "just now";
    const min = Math.round(sec / 60);
    if (min < 60) return `${min}m ago`;
    const hr = Math.round(min / 60);
    if (hr < 24) return `${hr}h ago`;
    const day = Math.round(hr / 24);
    if (day === 1) return "yesterday";
    if (day < 30) return `${day}d ago`;
    const mo = Math.round(day / 30);
    if (mo < 12) return `${mo}mo ago`;
    return `${Math.round(mo / 12)}y ago`;
  }

  function isDark(): boolean {
    return document.documentElement.classList.contains("dark");
  }

  // Halftone CMYK rasterizer using Flexoki tones.
  function renderHalftone(canvas: HTMLCanvasElement, img: HTMLImageElement) {
    const dst = canvas.getContext("2d");
    if (!dst) return;
    const W = canvas.width;
    const H = canvas.height;

    const SAMPLE = 24; // sample grid resolution
    const cell = W / SAMPLE; // pixel size of each output cell

    // Off-screen sampler
    const src = document.createElement("canvas");
    src.width = SAMPLE;
    src.height = SAMPLE;
    const sctx = src.getContext("2d");
    if (!sctx) return;
    sctx.drawImage(img, 0, 0, SAMPLE, SAMPLE);
    const data = sctx.getImageData(0, 0, SAMPLE, SAMPLE).data;

    const dark = isDark();
    // Flexoki CMYK approximations
    const C = dark ? "#3aa99f" : "#24837b"; // cyan
    const M = dark ? "#ce5d97" : "#a02f6f"; // magenta
    const Y = dark ? "#d0a215" : "#ad8301"; // yellow
    const K = dark ? "#f2f0e5" : "#100f0f"; // ink/paper

    // Background (paper or ink) so dots have something to land on
    dst.fillStyle = dark ? "#100f0f" : "#fbfaf6";
    dst.fillRect(0, 0, W, H);

    // Use multiply on light bg so dots darken; screen on dark bg so dots lighten
    dst.globalCompositeOperation = dark ? "screen" : "multiply";

    const max = cell * 0.62; // max dot radius
    // Slight per-channel offset to avoid moiré stack
    const offsets: Array<[number, number, string]> = [
      [0, 0, C],
      [cell * 0.25, cell * 0.25, M],
      [cell * 0.5, 0, Y],
      [0, cell * 0.5, K],
    ];

    for (const [ox, oy, color] of offsets) {
      dst.fillStyle = color;
      for (let y = 0; y < SAMPLE; y++) {
        for (let x = 0; x < SAMPLE; x++) {
          const i = (y * SAMPLE + x) * 4;
          const r = data[i] / 255;
          const g = data[i + 1] / 255;
          const b = data[i + 2] / 255;
          // Convert RGB -> CMYK
          const k = 1 - Math.max(r, g, b);
          const denom = 1 - k || 1;
          const c = (1 - r - k) / denom;
          const m = (1 - g - k) / denom;
          const yy = (1 - b - k) / denom;
          const v =
            color === C ? c : color === M ? m : color === Y ? yy : k;
          if (v <= 0.02) continue;
          const radius = Math.sqrt(v) * max;
          const cx = x * cell + cell / 2 + ox;
          const cy = y * cell + cell / 2 + oy;
          dst.beginPath();
          dst.arc(cx, cy, radius, 0, Math.PI * 2);
          dst.fill();
        }
      }
    }

    dst.globalCompositeOperation = "source-over";
  }

  function loadAndRender(url: string) {
    if (!artCanvas) return;
    if (url === lastImageUrl) return;
    lastImageUrl = url;
    const img = new Image();
    img.crossOrigin = "anonymous";
    img.onload = () => {
      try {
        renderHalftone(artCanvas, img);
        artCanvas.classList.remove("hidden");
      } catch (e) {
        console.error("Halftone render failed:", e);
        artCanvas.classList.add("hidden");
      }
    };
    img.onerror = () => {
      artCanvas.classList.add("hidden");
    };
    img.src = url;
  }

  function updateWidgetDisplay(data: SpotifyData) {
    if (!widget) return;

    if (!data.title || !data.artist || !data.url) {
      widget.classList.add("hidden");
      return;
    }

    widget.classList.remove("hidden");
    if (trackTitle) trackTitle.textContent = data.title;
    if (trackArtist) trackArtist.textContent = data.artist;
    if (trackLink) trackLink.href = data.url;

    if (trackAlbum) {
      if (data.album && data.album !== data.title) {
        trackAlbum.textContent = `· ${data.album}`;
        trackAlbum.classList.remove("hidden");
      } else {
        trackAlbum.textContent = "";
        trackAlbum.classList.add("hidden");
      }
    }

    if (data.albumImage) {
      loadAndRender(data.albumImage);
    } else {
      lastImageUrl = null;
      artCanvas?.classList.add("hidden");
    }

    if (data.isPlaying) {
      if (statusText) statusText.textContent = "Listening to";
      iconPlaying?.classList.remove("hidden");
      iconPaused?.classList.add("hidden");

      if (progress && progressFill && data.durationMs && data.progressMs != null) {
        const pct = Math.min(100, Math.max(0, (data.progressMs / data.durationMs) * 100));
        progressFill.style.width = `${pct}%`;
        progress.classList.remove("hidden");
      } else {
        progress?.classList.add("hidden");
      }
    } else {
      const suffix = data.playedAt ? ` ${formatRelative(data.playedAt)}` : "";
      if (statusText) statusText.textContent = `Last played${suffix}`;
      iconPlaying?.classList.add("hidden");
      iconPaused?.classList.remove("hidden");
      progress?.classList.add("hidden");
    }
  }

  async function updateNowPlaying() {
    try {
      const response = await fetch("/api/spotify/now-playing");
      const data: SpotifyData = await response.json();
      updateWidgetDisplay(data);
    } catch (error) {
      console.error("Failed to fetch Spotify data:", error);
      widget?.classList.add("hidden");
    }
  }

  // Re-render halftone on theme change so colors track the active palette
  const themeObserver = new MutationObserver(() => {
    if (lastImageUrl) {
      const url = lastImageUrl;
      lastImageUrl = null;
      loadAndRender(url);
    }
  });
  themeObserver.observe(document.documentElement, {
    attributes: true,
    attributeFilter: ["class"],
  });

  updateNowPlaying();
  setInterval(updateNowPlaying, 30000);
</script>
