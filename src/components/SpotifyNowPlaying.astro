---
// Polls /api/spotify/now-playing every 30s and renders what Jorge is
// listening to. Two looks share the same polling:
//   variant="full" (default): status, album art, track, album and progress
//   variant="mini": one mono line, "● NOW PLAYING · Track — Artist" (Margin)
// Several widgets can live on a page; the script polls once and fills them all.
// Dispatches `spotify:update` CustomEvent so SpotifyAlbumArt (extracted
// for clarity) can react to the same payload without polling itself.
import SpotifyAlbumArt from "@components/SpotifyAlbumArt.astro";

type Props = {
  variant?: "full" | "mini";
  class?: string;
};

const { variant = "full", class: className } = Astro.props;
const isDev = import.meta.env.DEV;
---

{
  variant === "mini" ? (
    <p
      class:list={["np-mini hidden", className]}
      data-spotify
      data-variant="mini"
      data-dev={isDev ? "true" : "false"}
    >
      <span class="np-dot" aria-hidden="true" />
      <span class="np-l" data-sp="status">
        Now playing
      </span>
      <span class="np-sep" aria-hidden="true">
        ·
      </span>
      <a class="np-track" data-sp="link" href="#" target="_blank" rel="noopener noreferrer">
        <span class="np-t" data-sp="title" /> <span class="np-a">— <span data-sp="artist" /></span>
      </a>
    </p>
  ) : (
    <div
      class:list={["hidden text-sm", className]}
      data-spotify
      data-variant="full"
      data-dev={isDev ? "true" : "false"}
    >
      <div class="flex items-center gap-3">
        <span class="flex items-center shrink-0">
          <svg
            data-sp="icon-playing"
            class="hidden"
            width="16"
            height="16"
            viewBox="0 0 16 16"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path d="M6 3v8.5a2.5 2.5 0 1 1-1-2V4.5L11 3v6.5a2.5 2.5 0 1 1-1-2V4l-4 1z" fill="currentColor" />
            <circle cx="4.5" cy="11.5" r="1.5" fill="currentColor" />
            <circle cx="10.5" cy="9.5" r="1.5" fill="currentColor" />
          </svg>
          <svg data-sp="icon-paused" width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect x="4" y="3" width="2.5" height="10" rx="0.5" fill="currentColor" />
            <rect x="9.5" y="3" width="2.5" height="10" rx="0.5" fill="currentColor" />
          </svg>
        </span>
        <SpotifyAlbumArt />
        <div class="flex flex-col gap-0.5 min-w-0 flex-1">
          <span data-sp="status" class="opacity-60">
            Last played
          </span>
          <a
            data-sp="link"
            href="#"
            target="_blank"
            rel="noopener noreferrer"
            class="truncate decoration-flexoki-base-300 dark:decoration-flexoki-base-700 hover:decoration-flexoki-base-500 text-current hover:text-flexoki-ink hover:dark:text-flexoki-base-50 transition-colors duration-300 ease-in-out underline underline-offset-2"
          >
            <span data-sp="title" />
            <span class="opacity-60"> by </span>
            <span data-sp="artist" />
          </a>
          <a
            data-sp="album-link"
            href="#"
            target="_blank"
            rel="noopener noreferrer"
            class="opacity-60 truncate hidden max-w-[24ch] decoration-flexoki-base-300 dark:decoration-flexoki-base-700 hover:decoration-flexoki-base-500 hover:opacity-100 hover:text-flexoki-ink hover:dark:text-flexoki-base-50 transition-colors duration-300 ease-in-out underline underline-offset-2"
          >
            <span data-sp="album" />
          </a>
          <div data-sp="progress" class="mt-1 h-1 hidden bg-flexoki-base-100 dark:bg-flexoki-base-900 overflow-hidden">
            <div
              data-sp="progress-fill"
              class="h-full pattern-hatch text-flexoki-ink dark:text-flexoki-base-50 transition-[width] duration-700 ease-linear"
              style="width: 0%"
            />
          </div>
        </div>
      </div>
    </div>
  )
}

<script>
  interface SpotifyData {
    isPlaying: boolean;
    title?: string;
    artist?: string;
    album?: string;
    albumType?: string;
    albumUrl?: string;
    albumImage?: string;
    url?: string;
    progressMs?: number;
    durationMs?: number;
    playedAt?: string;
  }

  const widgets = [...document.querySelectorAll<HTMLElement>("[data-spotify]")];
  const isDev = widgets.some((w) => w.dataset.dev === "true");

  const es = document.documentElement.lang === "es";
  const rtf = new Intl.RelativeTimeFormat("es", { numeric: "auto" });

  function formatRelative(iso: string): string {
    const then = new Date(iso).getTime();
    if (es) {
      if (Number.isNaN(then)) return "hace poco";
      const sec = Math.round((then - Date.now()) / 1000);
      const steps: [Intl.RelativeTimeFormatUnit, number][] = [
        ["second", 60], ["minute", 60], ["hour", 24], ["day", 30], ["month", 12],
      ];
      let value = sec;
      for (const [unit, size] of steps) {
        if (Math.abs(value) < size) return unit === "second" ? "ahora mismo" : rtf.format(value, unit);
        value = Math.round(value / size);
      }
      return rtf.format(value, "year");
    }
    if (Number.isNaN(then)) return "recently";
    const diff = Date.now() - then;
    const sec = Math.max(0, Math.round(diff / 1000));
    if (sec < 60) return "just now";
    const min = Math.round(sec / 60);
    if (min < 60) return `${min}m ago`;
    const hr = Math.round(min / 60);
    if (hr < 24) return `${hr}h ago`;
    const day = Math.round(hr / 24);
    if (day === 1) return "yesterday";
    if (day < 30) return `${day}d ago`;
    const mo = Math.round(day / 30);
    if (mo < 12) return `${mo}mo ago`;
    return `${Math.round(mo / 12)}y ago`;
  }

  function renderWidget(widget: HTMLElement, data: SpotifyData) {
    const part = (name: string) => widget.querySelector<HTMLElement>(`[data-sp="${name}"]`);
    const mini = widget.dataset.variant === "mini";

    if (!data.title || !data.artist || !data.url) {
      if (!isDev) widget.classList.add("hidden");
      return;
    }

    widget.classList.remove("hidden");
    const title = part("title");
    const artist = part("artist");
    const link = part("link") as HTMLAnchorElement | null;
    const status = part("status");
    if (title) title.textContent = data.title;
    if (artist) artist.textContent = data.artist;
    if (link) link.href = data.url;

    if (mini) {
      widget.classList.toggle("is-paused", !data.isPlaying);
      if (status) {
        status.textContent = data.isPlaying
          ? es ? "Escuchando" : "Now playing"
          : es ? "Última canción" : "Last played";
      }
      return;
    }

    const album = part("album");
    const albumLink = part("album-link") as HTMLAnchorElement | null;
    const iconPlaying = part("icon-playing");
    const iconPaused = part("icon-paused");
    const progress = part("progress");
    const progressFill = part("progress-fill");

    if (album && albumLink) {
      if (data.album && data.album !== data.title && data.albumUrl) {
        const type = data.albumType
          ? data.albumType.charAt(0).toUpperCase() + data.albumType.slice(1)
          : "";
        album.textContent = type ? `${type} · ${data.album}` : `${data.album}`;
        albumLink.href = data.albumUrl;
        albumLink.classList.remove("hidden");
      } else {
        albumLink.classList.add("hidden");
      }
    }

    if (data.isPlaying) {
      if (status) status.textContent = es ? "Escuchando" : "Listening to";
      iconPlaying?.classList.remove("hidden");
      iconPaused?.classList.add("hidden");

      if (progress && progressFill && data.durationMs && data.progressMs != null) {
        const pct = Math.min(100, Math.max(0, (data.progressMs / data.durationMs) * 100));
        progressFill.style.width = `${pct}%`;
        progress.classList.remove("hidden");
      } else {
        progress?.classList.add("hidden");
      }
    } else {
      const suffix = data.playedAt ? ` ${formatRelative(data.playedAt)}` : "";
      if (status) status.textContent = es ? `Última canción${suffix}` : `Last played${suffix}`;
      iconPlaying?.classList.add("hidden");
      iconPaused?.classList.remove("hidden");
      progress?.classList.add("hidden");
    }
  }

  function render(data: SpotifyData) {
    widgets.forEach((widget) => renderWidget(widget, data));
  }

  async function poll() {
    try {
      const response = await fetch("/api/spotify/now-playing");
      const data: SpotifyData = await response.json();
      render(data);
      document.dispatchEvent(new CustomEvent("spotify:update", { detail: data }));
    } catch (error) {
      console.error("Failed to fetch Spotify data:", error);
      if (!isDev) widgets.forEach((widget) => widget.classList.add("hidden"));
      document.dispatchEvent(new CustomEvent("spotify:update", { detail: {} }));
    }
  }

  const PLACEHOLDER_IMAGE = "/img/acting-my-age.png";

  if (widgets.length) {
    if (isDev) {
      const placeholder: SpotifyData = {
        isPlaying: false,
        title: "Track title",
        artist: "Artist name",
        album: "Album name",
        albumType: "single",
        albumUrl: "#",
        albumImage: PLACEHOLDER_IMAGE,
        url: "#",
        playedAt: new Date(Date.now() - 1000 * 60 * 7).toISOString(),
      };
      render(placeholder);
      document.dispatchEvent(new CustomEvent("spotify:update", { detail: placeholder }));
    }

    poll();
    setInterval(poll, 30000);
  }
</script>
