---
type Props = {
  size?: number;
  class?: string;
  title?: string;
};

const {
  size = 40,
  class: className = "",
  title = "JOR — Jorge Orejas Rojo",
} = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 120 80"
  width={size}
  height={(size * 80) / 120}
  class={className}
  role="img"
  aria-label={title}
>
  <title>{title}</title>
  <ellipse
    cx="60"
    cy="40"
    rx="56"
    ry="34"
    fill="none"
    stroke="currentColor"
    stroke-width="1.25"
    opacity="0.9"
  ></ellipse>
  <ellipse
    cx="60"
    cy="40"
    rx="52"
    ry="30"
    fill="none"
    stroke="currentColor"
    stroke-width="0.5"
    opacity="0.55"
  ></ellipse>
  <text
    x="60"
    y="52"
    text-anchor="middle"
    font-family="Instrument Serif, ui-serif, Georgia, serif"
    font-size="34"
    font-weight="500"
    fill="currentColor"
    letter-spacing="0.02em"
  >
    JOR
  </text>
</svg>
