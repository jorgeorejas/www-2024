---
import Breadcrumbs from "./Breadcrumbs.astro";
import Link from "./Link.astro";
type Props = {
  breadCrumbsItems?: {
    href: string;
    label: string;
  }[];
  showNav?: boolean;
};

const { breadCrumbsItems, showNav = false } = Astro.props;
---

<div
  class="flex md:flex-row flex-col gap-2 md:gap-0 justify-between items-center"
>
  <div class="space-y-2 w-full md:w-auto">
    <a href="/" class="space-y-2">
      <p class="text-xl font-semibold font-serif text-black dark:text-white">
        Jorge Orejas
      </p>
      <p class="w-full font-medium">Developer & Entrepreneur</p>
    </a>
    {breadCrumbsItems && <Breadcrumbs items={breadCrumbsItems} />}
  </div>
  {
    showNav && (
      <ul class="h-full pr-2 flex flex-row w-full md:w-auto md:flex-col gap-2 md:gap-1 content-between">
        <li>
          <Link href="/blog">Blog</Link>
        </li>
        <li>
          <Link href="/projects">Projects</Link>
        </li>
        <li>
          <Link href="/blog">Work</Link>
        </li>
      </ul>
    )
  }
</div>
