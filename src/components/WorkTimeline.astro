---
import { formatWorkDate } from "@lib/utils";
import AnimatedArrow from "./AnimatedArrow.astro";

interface Props {
  processedWork: Array<{
    slug: string;
    name: string;
    description: string;
    startDate: Date | string;
    endDate: Date | string;
    positions: Array<{
      title: string;
      startDate: Date;
      endDate: Date | string;
      description: string;
    }>;
  }>;
}

const { processedWork } = Astro.props;
---

<div class="space-y-4">
  {
    processedWork.map((job, i) => (
      <div class="space-y-3">
        <div class="metadata-accent text-sm print:text-black">
          {formatWorkDate(job.endDate)}
        </div>
        <a
          href={`/work/${job.slug}`}
          class="relative group block border-l border-black/15 dark:border-white/20 pl-4 pr-10 hover:bg-black/5 dark:hover:bg-white/5 hover:text-black dark:hover:text-white transition-colors duration-300 ease-in-out print:border-black print:pr-0"
        >
          <div class="font-serif font-semibold relative inline-block">
            {job.name}
            <span class="absolute left-0 bottom-0 w-full h-[1px] bg-black/20 dark:bg-white/30 opacity-0 group-hover:opacity-100 transition-opacity duration-300 ease-in-out print:hidden" />
          </div>
          <div class="mt-2 space-y-3">
            {job.positions.map((position, i) => (
              <div class="space-y-2">
                {i > 0 && (
                  <p class="metadata-accent text-sm print:text-black">
                    {formatWorkDate(position.endDate)}
                  </p>
                )}
                <div class="border-l border-black/15 dark:border-white/20 pl-4 space-y-2 print:border-black">
                  <p class="font-sans font-medium">{position.title}</p>
                  <div class="text-sm text-black/60 dark:text-white/60 print:text-black">
                    {position.description}
                  </div>
                </div>
              </div>
            ))}
          </div>
          <AnimatedArrow size="sm" />
        </a>
        <div class="metadata-accent text-sm print:text-black">
          {i === processedWork.length - 1 && formatWorkDate(job.startDate)}
        </div>
      </div>
    ))
  }
</div>
