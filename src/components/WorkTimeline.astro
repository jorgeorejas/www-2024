---
import { formatWorkDate } from "@lib/utils";
import AnimatedArrow from "./AnimatedArrow.astro";

interface Props {
  processedWork: Array<{
    slug: string;
    name: string;
    description: string;
    startDate: Date | string;
    endDate: Date | string;
    positions: Array<{
      title: string;
      startDate: Date;
      endDate: Date | string;
      description: string;
    }>;
  }>;
}

const { processedWork } = Astro.props;

const yearOf = (d: Date | string) =>
  typeof d === "string" ? d : d.getFullYear().toString();
---

<div class="space-y-8" style="--section-accent: var(--accent-bordeaux);">
  {
    processedWork.map((job, i) => (
      <div class="space-y-2">
        <div class="font-serif italic text-sm text-flexoki-base-600 dark:text-flexoki-base-400 print:text-black">
          {formatWorkDate(job.endDate)}
        </div>
        <a
          href={`/work/${job.slug}`}
          class="relative group block pl-5 pr-12 py-2 border-l-2 transition-colors duration-300 ease-in-out hover:bg-[var(--color-bodega-paper-warm)] dark:hover:bg-flexoki-base-900 print:pr-0"
          style="border-color: var(--section-accent);"
        >
          <div class="flex items-baseline gap-3 flex-wrap">
            <span class="font-serif italic text-2xl text-flexoki-ink dark:text-flexoki-base-50">
              {yearOf(job.endDate)}
            </span>
            <span
              class="font-serif font-semibold text-lg relative inline-block"
            >
              {job.name}
              <span
                class="absolute left-0 bottom-0 w-full h-[1px] scale-x-0 group-hover:scale-x-100 origin-left transition-transform duration-300 ease-in-out print:hidden"
                style="background-color: var(--section-accent);"
              />
            </span>
          </div>
          <div class="mt-3 space-y-3">
            {job.positions.map((position, j) => (
              <div class="space-y-1">
                {j > 0 && (
                  <p class="font-serif italic text-xs text-flexoki-base-600 dark:text-flexoki-base-400 print:text-black">
                    {formatWorkDate(position.endDate)}
                  </p>
                )}
                <div
                  class="border-l pl-4 space-y-1 print:border-black"
                  style="border-color: color-mix(in srgb, var(--section-accent) 40%, transparent);"
                >
                  <p class="font-medium font-serif">{position.title}</p>
                  <div class="text-sm text-flexoki-base-700 dark:text-flexoki-base-400 print:text-black">
                    {position.description}
                  </div>
                </div>
              </div>
            ))}
          </div>
          <AnimatedArrow size="sm" />
        </a>
        <div class="font-serif italic text-sm text-flexoki-base-600 dark:text-flexoki-base-400 print:text-black">
          {i === processedWork.length - 1 && formatWorkDate(job.startDate)}
        </div>
      </div>
    ))
  }
</div>
