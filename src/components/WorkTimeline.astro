---
import { formatWorkDate } from "@lib/utils";

interface Props {
  processedWork: Array<{
    slug: string;
    name: string;
    description: string;
    startDate: Date | string;
    endDate: Date | string;
    positions: Array<{
      title: string;
      startDate: Date;
      endDate: Date | string;
      description: string;
    }>;
  }>;
}

const { processedWork } = Astro.props;
---

<div class="space-y-4">
  {
    processedWork.map((job, i) => (
      <div class="space-y-3">
        <div class="text-sm text-black/50 dark:text-white/50">
          {formatWorkDate(job.endDate)}
        </div>
        <div class="border-l border-black/15 dark:border-white/20 pl-4">
          <a
            href={`/work/${job.slug}`}
            class="group font-bold font-serif hover:text-black dark:hover:text-white transition-colors duration-300 ease-in-out inline-block relative"
          >
            {job.name}
            <span class="absolute left-0 bottom-0 w-full h-[1px] bg-blue-800 scale-x-0 group-hover:scale-x-100 origin-left transition-transform duration-300 ease-in-out" />
          </a>
          <div class="mt-2 space-y-3">
            {job.positions.map((position, i) => (
              <div class="space-y-2">
                {i > 0 && (
                  <p class="text-sm text-black/50 dark:text-white/50">
                    {formatWorkDate(position.endDate)}
                  </p>
                )}
                <div class="border-l border-black/15 dark:border-white/20 pl-4 space-y-2">
                  <p class="font-medium font-serif">{position.title}</p>
                  <div class="text-sm text-black/60 dark:text-white/60">
                    {position.description}
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
        <div class="text-sm text-black/50 dark:text-white/50">
          {i === processedWork.length - 1 && formatWorkDate(job.startDate)}
        </div>
      </div>
    ))
  }
</div>
