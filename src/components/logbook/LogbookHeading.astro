---
export interface Props {
  level: 1 | 2 | 3 | 4 | 5 | 6;
  uppercase?: boolean;
  class?: string;
}

const { level, uppercase = true, class: className } = Astro.props;
const Tag = `h${level}` as 'h1' | 'h2' | 'h3' | 'h4' | 'h5' | 'h6';

const sizeClasses = {
  1: 'text-3xl',
  2: 'text-2xl',
  3: 'text-xl',
  4: 'text-lg',
  5: 'text-base',
  6: 'text-sm'
};
---

<Tag class:list={[
  "font-display tracking-wider text-ink-black dark:text-paper-white",
  uppercase && "uppercase",
  sizeClasses[level],
  className
]}>
  <slot />
</Tag>
