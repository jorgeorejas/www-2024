---
import { getLiveEntry } from "astro:content";

interface Props {
  slug: string;
  class?: string;
}

const { slug, class: className = "" } = Astro.props as Props;

// A text block from the "Bloques" database in Notion
const { entry } = await getLiveEntry("blocks", { id: slug });
const html = entry?.rendered?.html;
---

{html ? <article class={className} set:html={html} /> : null}
