---
/*
 * Education timeline, Margin "notas" style (same as WorkTimeline): no line,
 * no dots; entries sit flush with the content column and the years are a
 * pen note in the margin at the entry's height ("2016 – 2020" + duration).
 * On phones the note goes inline above the entry. The mono dates stay in
 * the markup for screen readers (the note is aria-hidden).
 */
import MarginNote from "@components/margin/MarginNote.astro";
import { formatDuration, formatEducationDate, formatYear } from "@lib/utils";

type Education = {
  slug: string;
  institution: string;
  degree: string;
  field?: string;
  grade?: string;
  description: string;
  startDate: Date;
  endDate: Date | string;
  expectedEnd?: Date;
};

interface Props {
  processedEducation: Education[];
  /** Heading level for institution names; degrees use the next level */
  headingLevel?: 2 | 3;
  class?: string;
}

const { processedEducation, headingLevel = 2, class: className } = Astro.props;

const InstitutionHeading = `h${headingLevel}` as "h2" | "h3";
const DegreeHeading = `h${headingLevel + 1}` as "h3" | "h4";

const ended = (date: Date | string): date is Date => date instanceof Date;

const isoMonth = (date: Date) => date.toISOString().slice(0, 7);

/** "2016 – 2020", "2024 – now", or a single year when it starts and ends the same year */
function noteYears(education: Education) {
  const start = formatYear(education.startDate);
  if (!ended(education.endDate)) return `${start} – now`;
  const end = formatYear(education.endDate);
  return start === end ? start : `${start} – ${end}`;
}
---

<ol class:list={["etl", className]}>
  {
    processedEducation.map((education) => {
      const duration = formatDuration(education.startDate, education.endDate);
      return (
        <li class="etl-i m-anchor">
          <MarginNote placement="beside" as="span" aria-hidden="true">
            {noteYears(education)}
            <small>{duration}</small>
          </MarginNote>
          <InstitutionHeading class="etl-n">{education.institution}</InstitutionHeading>
          <p class="sr-only">
            <time datetime={isoMonth(education.startDate)}>
              {formatEducationDate(education.startDate)}
            </time>
            {" – "}
            {ended(education.endDate) ? (
              <time datetime={isoMonth(education.endDate)}>
                {formatEducationDate(education.endDate)}
              </time>
            ) : (
              "Present"
            )}
            {` · ${duration}`}
          </p>
          {education.degree && <DegreeHeading class="etl-t">{education.degree}</DegreeHeading>}
          {education.field && <p class="etl-d">{education.field}</p>}
          {(education.grade || (education.expectedEnd && !ended(education.endDate))) && (
            <p class="etl-m">
              {education.expectedEnd && !ended(education.endDate) && (
                <span>Expected {formatEducationDate(education.expectedEnd)}</span>
              )}
              {education.grade && <span>Grade: {education.grade}</span>}
            </p>
          )}
        </li>
      );
    })
  }
</ol>

<style>
  .etl {
    display: grid;
    gap: 34px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .etl-n {
    margin: 0 0 10px;
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: 26px;
    line-height: 1.1;
    color: var(--color-flexoki-ink);
    text-wrap: balance;
  }
  .etl-t {
    margin: 0;
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 14.5px;
    line-height: 1.5;
    color: var(--color-flexoki-ink);
  }
  .etl-d {
    max-width: 68ch;
    margin: 6px 0 0;
    font-size: 14.5px;
    line-height: 1.85;
    color: var(--color-ink-soft);
  }
  .etl-m {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.2em;
    margin: 4px 0 0;
    font-size: 12.5px;
    color: var(--color-mute);
  }
  /* outside a Margin page (no margin column) the note just sits above the entry */
  :global(body:not(.margin-ui)) .etl :global(.m-note--beside) {
    position: static;
    display: block;
    width: auto;
    margin: 0 0 4px;
    text-align: left;
    transform: rotate(-2deg);
  }
  :global(body:not(.margin-ui)) .etl :global(.m-note--beside small) {
    display: inline;
    margin-left: 6px;
  }
</style>
