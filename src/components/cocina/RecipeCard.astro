---
/*
 * A recipe in the Cocina photo grid (Margin design): 3:4 photo, serif title
 * with the ◆ / NUEVA markers, description, and "time — tags" in mono.
 * The data attributes drive the search and tag filters on /cocina.
 * Self-contained (Tailwind only) so it also works outside Margin pages; on
 * the dot grid the photo is cut to whole rows minus half a row (.m-photo),
 * so after the half-row gap every line of text lands on a row.
 */
import Markers from "@components/margin/Markers.astro";
import { formatMinutes, imageSrcset, totalMinutes } from "@lib/cocina";
import type { Recipe } from "@lib/notion/collections";
import { isNew } from "@lib/utils";

type Props = {
  recipe: { id: string; data: Recipe };
  /** "small": no description */
  size?: "small" | "default";
  /** Heading level of the title; h2 when the grid has no section heading above it */
  headingLevel?: "h2" | "h3";
};

const { recipe, size = "default", headingLevel: Heading = "h3" } = Astro.props;
const { data } = recipe;
const meta = [formatMinutes(totalMinutes(data)), data.tags.map((t) => t.name).join(" · ")]
  .filter(Boolean)
  .join(" — ");
const sizes = size === "small" ? "(min-width: 640px) 240px, 50vw" : "(min-width: 1024px) 230px, (min-width: 761px) 33vw, 50vw";
---

<a
  href={`/cocina/${recipe.id}`}
  class="group @container grid content-start gap-(--g-half) text-left"
  data-recipe
  data-title={data.title.toLowerCase()}
  data-tags={data.tags.map((t) => t.slug).join(" ")}
>
  <span class="m-photo relative block aspect-[3/4] overflow-hidden bg-flexoki-base-50 [--ratio:3/4] [--trim:var(--g-half)]">
    {
      data.image ? (
        <img
          src={data.image}
          srcset={imageSrcset(data.image)}
          sizes={sizes}
          alt=""
          loading="lazy"
          decoding="async"
          class="size-full object-cover motion-safe:transition-transform motion-safe:duration-500 motion-safe:ease-out motion-safe:group-hover:scale-[1.04]"
        />
      ) : (
        <span class="block size-full pattern-dots text-flexoki-base-300" />
      )
    }
    {
      data.draft && (
        <span class="absolute top-2 left-2 bg-flexoki-paper px-1.5 font-mono text-mark uppercase tracking-[0.08em] text-mute-ink">
          borrador
        </span>
      )
    }
  </span>
  <span class="grid min-w-0 gap-0">
    <Heading class="m-0 font-serif text-title-4 leading-[1.1] font-normal text-flexoki-ink text-balance">
      <Markers pick={data.pick} isNew={isNew(data.date)} pickLabel="la favorita" newLabel="NUEVA" />
      <span class="group-hover:pen-underline group-focus-visible:pen-underline">{data.title}</span>
    </Heading>
    {
      size === "default" && data.description && (
        <span class="font-mono text-body leading-[1.65] text-ink-soft">{data.description}</span>
      )
    }
    {meta && <span class="font-mono text-meta leading-normal text-mute">{meta}</span>}
  </span>
</a>
