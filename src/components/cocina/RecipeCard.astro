---
import type { Recipe } from "@lib/notion/collections";
import { formatMinutes, imageSrcset, servingsLabel, totalMinutes } from "@lib/cocina";

type Props = {
  recipe: { id: string; data: Recipe };
  size?: "small" | "default";
};

const { recipe, size = "default" } = Astro.props;
const { data } = recipe;
const time = formatMinutes(totalMinutes(data));
const meta = [time, data.servings && servingsLabel(data.servings), data.difficulty?.toLowerCase()]
  .filter(Boolean)
  .join(" · ");
---

<a
  href={`/cocina/${recipe.id}`}
  class="group flex flex-col gap-3"
  data-recipe
  data-title={data.title.toLowerCase()}
  data-tags={data.tags.map((t) => t.slug).join(" ")}
>
  <div class="relative aspect-[4/3] overflow-hidden bg-flexoki-base-100">
    {
      data.image ? (
        <img
          src={data.image}
          srcset={imageSrcset(data.image)}
          sizes={size === "small" ? "(min-width: 640px) 240px, 100vw" : "(min-width: 640px) 360px, 100vw"}
          alt=""
          loading="lazy"
          decoding="async"
          class="size-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.03]"
        />
      ) : (
        <div class="size-full pattern-dots text-flexoki-base-300" />
      )
    }
    {
      data.draft && (
        <span class="absolute top-2 left-2 bg-flexoki-paper px-1.5 text-xs">borrador</span>
      )
    }
  </div>
  <div class="flex flex-col gap-1">
    <h3
      class:list={[
        "font-serif leading-tight text-flexoki-ink",
        size === "small" ? "text-lg" : "text-xl",
      ]}
    >
      <span class="bg-[linear-gradient(currentColor,currentColor)] bg-[length:0%_1px] bg-left-bottom bg-no-repeat transition-[background-size] duration-300 group-hover:bg-[length:100%_1px]">
        {data.title}
      </span>
    </h3>
    {size === "default" && data.description && <p class="text-sm text-flexoki-base-600">{data.description}</p>}
    {meta && <p class="text-xs text-flexoki-base-500">{meta}</p>}
  </div>
</a>
