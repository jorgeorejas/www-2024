---
/*
 * Section name set vertically in the margin, like a printed menu: a small
 * drawn ↱ on top pointing at the section title, then the letters stacked.
 * On phones the letters run horizontally. Decorative: the section's own
 * heading carries the meaning, so it is hidden from assistive tech.
 */
type Props = {
  label: string;
  class?: string;
};

const { label, class: className } = Astro.props;
const letters = [...label.toUpperCase()];
---

<span class:list={["m-vert", className]} aria-hidden="true">
  <svg class="m-vert-up" viewBox="0 0 18 18" width="18" height="18" focusable="false">
    <path
      d="M4 17V6.5H15"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="round"
      stroke-linejoin="round"></path>
    <path
      d="M11.5 3L15 6.5L11.5 10"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="round"
      stroke-linejoin="round"></path>
  </svg>
  {letters.map((ch) => <span>{ch === " " ? " " : ch}</span>)}
</span>
