---
/*
 * Section name set vertically in the margin, like a printed menu: a small
 * pen-drawn ↱ on top pointing at the section title, then the letters stacked.
 * On phones the letters run horizontally. Decorative: the section's own
 * heading carries the meaning, so it is hidden from assistive tech.
 */
import { HOOK_ARROW_PATHS } from "./hand-arrow";

type Props = {
  label: string;
  class?: string;
};

const { label, class: className } = Astro.props;
const letters = [...label.toUpperCase()];
---

<span class:list={["m-vert", className]} aria-hidden="true">
  <svg
    class="m-vert-up"
    viewBox="0 0 18 18"
    width="18"
    height="18"
    focusable="false"
    fill="none"
    stroke="currentColor"
    stroke-width="1.6"
    stroke-linecap="round"
    stroke-linejoin="round"
    set:html={HOOK_ARROW_PATHS}
  />
  {letters.map((ch) => <span>{ch === " " ? " " : ch}</span>)}
</span>
