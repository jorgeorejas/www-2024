---
/*
 * Printed-menu markers placed before a title: "NEW" (published in the last
 * 60 days, see isNew in lib/utils) and an orange ◆ for a pick / owned item.
 */
type Props = {
  pick?: boolean;
  isNew?: boolean;
  /** Read by screen readers instead of the ◆ glyph */
  pickLabel?: string;
  newLabel?: string;
};

const { pick = false, isNew = false, pickLabel = "my pick", newLabel = "NEW" } = Astro.props;
---

{isNew && <span class="m-new">{newLabel}</span>}
{
  pick && (
    <span class="m-pick" title={pickLabel}>
      <span aria-hidden="true">◆</span>
      <span class="sr-only">({pickLabel})</span>
    </span>
  )
}
