---
/*
 * A pen-drawn arrow for hand notes. In the margin it points right, at the
 * content; on phones the note sits above its item, so it curls down instead.
 * MarginNote swaps a trailing "→" typed in Notion for this.
 */
import { HAND_ARROW_SVG } from "./hand-arrow";
---

<Fragment set:html={HAND_ARROW_SVG} />
