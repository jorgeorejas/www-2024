---
/*
 * A pen-drawn arrow for hand notes. In the margin it points right, at the
 * content; on phones the note sits above its item, so it curls down instead.
 * MarginNote swaps a trailing "→" typed in Notion for this.
 */
---

<svg class="hn-arrow" viewBox="0 0 30 22" aria-hidden="true" focusable="false">
  <g class="hn-arrow-right">
    <path d="M2.2 12.6c5.4-2.3 11.9-2.7 22.4-1.5"></path>
    <path d="M19.3 6.5c2.2 1.5 4.1 3 5.8 4.7-2 1.1-3.9 2.6-5.5 4.5"></path>
  </g>
  <g class="hn-arrow-down">
    <path d="M2.6 4.8c7.4-1.9 13.4.3 14.9 5.3.7 2.5.5 5.1.1 8.5"></path>
    <path d="M13.5 15.1c1.5 1.4 2.9 2.9 4.1 4.6 1.2-1.8 2.6-3.4 4.4-4.8"></path>
  </g>
</svg>
