---
type Props = {
  items: {
    href: string;
    label: string;
  }[];
  homeLabel?: string;
};

const { items, homeLabel = "Home" } = Astro.props;

const allItems = [{ href: "/", label: homeLabel }, ...items];
---

<nav class="md:flex hidden" aria-label="Breadcrumb">
  <ol class="inline-flex items-center space-x-1 md:space-x-3">
    {
      allItems.map((item, index) => (
        <li class="inline-flex last:font-bold items-center space-x-1 md:space-x-3">
          <a
            href={item.href}
            class="inline-flex items-center text-sm whitespace-nowrap text-flexoki-base-700 hover:text-flexoki-blue-600 dark:text-flexoki-base-400 dark:hover:text-flexoki-base-50"
          >
            {item.label}
          </a>
          {index < allItems.length - 1 && <span class="font-medium">&gt;</span>}
        </li>
      ))
    }
  </ol>
</nav>
