---
type Props = {
  items: {
    href: string;
    label: string;
  }[];
};

const { items } = Astro.props;

const allItems = [{ href: "/", label: "Home" }, ...items];
---

<nav class="md:flex hidden" aria-label="Breadcrumb">
  <ol class="inline-flex items-center gap-2">
    {
      allItems.map((item, index) => (
        <li class="inline-flex items-center gap-2 last:font-semibold">
          <a
            href={item.href}
            class="eyebrow text-flexoki-base-700 dark:text-flexoki-base-300 hover:text-flexoki-ink dark:hover:text-flexoki-base-50 transition-colors"
          >
            {item.label}
          </a>
          {index < allItems.length - 1 && (
            <span aria-hidden="true" class="opacity-50 text-xs">·</span>
          )}
        </li>
      ))
    }
  </ol>
</nav>
