---
type Props = {
  items: {
    href: string;
    label: string;
  }[];
};

const { items } = Astro.props;

const allItems = [{ href: "/", label: "Home" }, ...items];
---

<nav class="md:flex hidden" aria-label="Breadcrumb">
  <ol class="inline-flex items-center space-x-1 md:space-x-3">
    {
      allItems.map((item, index) => (
        <li class="inline-flex first:font-bold items-center space-x-1 md:space-x-3">
          <a
            href={item.href}
            class="inline-flex items-center text-sm whitespace-nowrap text-gray-700 hover:text-blue-600 dark:text-gray-400 dark:hover:text-white"
          >
            {item.label}
          </a>
          {index < allItems.length - 1 && <span>&gt;</span>}
        </li>
      ))
    }
  </ol>
</nav>
