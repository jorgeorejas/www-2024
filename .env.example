SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
SPOTIFY_REFRESH_TOKEN=your_spotify_refresh_token_here
SPOTIFY_REDIRECT_URI=https://your-ngrok-url.ngrok-free.dev/spotify-auth

# All site content lives in Notion (hub page "jorgeorejas.com"). Locally the
# "My site" integration token is enough; database ids are in src/lib/notion/databases.ts
NOTION_TOKEN=your_notion_integration_secret_here

# Vercel Connect connector: forwards Notion webhooks to /api/notion/webhook and
# hands out the token only when NOTION_TOKEN is missing (each Connect token
# request counts against the plan quota)
# NOTION_CONNECTOR=notion/notion-www

# Only if the Notion webhook points straight at /api/notion/webhook (no Connect)
# NOTION_WEBHOOK_SECRET=verification_token_from_notion

# Optional: drafts show with ?preview=true. Set this to require ?preview=<secret>
# instead (and change the "Web" formulas in Notion to match)
# PREVIEW_SECRET=
